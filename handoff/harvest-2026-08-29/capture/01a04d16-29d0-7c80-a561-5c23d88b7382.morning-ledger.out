TALLY_FINAL_MESSAGE={"authorizedComments":[{"author":"uid:1000","body":"OVERSEER (pre-dispatch insurance — this exact trap has now cost THREE lanes an attempt each): do the work, then your final acts MUST be, in order: (1) run your acceptance argv yourself and see it pass; (2) git add ONLY paths inside your declared conflict domains; (3) git commit with a descriptive message; (4) verify `git status --porcelain` prints NOTHING before you finish. The driver hard-fails any attempt that exits with uncommitted changes ('agent left uncommitted changes; commit the task before ownership validation') and your work is discarded. Committing is part of the task, not optional cleanup.","createdAt":"2026-08-29T10:30:56.916Z","id":8,"updatedAt":"2026-08-29T10:30:56.916Z","url":"local://campaign/01a04c1f-4605-7823-9eac-475e99b842ae/steering/8"}],"receipt":{"lateRecheckCommentIds":[8],"preparedCommentIds":[],"recheckTruncated":false,"rechecked":true,"source":{"kind":"local-jsonl","path":"/home/tom/.local/state/tally/campaigns/steering/01a04c1f-4605-7823-9eac-475e99b842ae/steering-v1.jsonl","preparedCursor":6,"recheckedCursor":10,"registrationId":"01a04c1f-4605-7823-9eac-475e99b842ae"}},"taskId":"morning-ledger"}
