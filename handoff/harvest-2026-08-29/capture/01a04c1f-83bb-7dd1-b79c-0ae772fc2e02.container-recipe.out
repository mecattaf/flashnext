o = cd_off\ncd, _ = fetch(need_lo, total - 1)\nentries = {}\np = 0\nwhile p < len(cd) and cd[p:p+4] == b\"PK\\x01\\x02\":\n    nlen, elen, clen = struct.unpack(\"<HHH\", cd[p+28:p+34])\n    csz, loc_off = struct.unpack(\"<II\", cd[p+20:p+28])\n    name = cd[p+46:p+46+nlen].decode()\n    entries[name] = (loc_off, csz)\n    p += 46 + nlen + elen + clen\nmeta = [n for n in entries if n.endswith(\".dist-info/METADATA\")][0]\nloc_off, csz = entries[meta]\nblob, _ = fetch(loc_off, loc_off + csz + 1000)\n# local header\nassert blob[:4] == b\"PK\\x03\\x04\"\nnlen, elen = struct.unpack(\"<HH\", blob[26:30])\ndata = blob[30+nlen+elen:30+nlen+elen+csz]\ntext = zlib.decompress(data, -15).decode()\nfor line in text.splitlines():\n    if line.startswith((\"Requires-Dist\", \"Requires-Python\", \"Version:\")):\n        print(line)\nEOF\npython3 /tmp/wheelmeta.py","timeout":180}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":1525,"output":903,"cacheRead":43008,"cacheWrite":0,"reasoning":147,"totalTokens":45436,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787983631390,"responseId":"chatcmpl-196a8a6f-0e75-43ee-a705-cd115588ab23","rawStopReason":"tool_calls"}}
