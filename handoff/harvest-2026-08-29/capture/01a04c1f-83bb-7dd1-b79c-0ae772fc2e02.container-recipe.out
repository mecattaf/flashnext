{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"\n[{\"newText\": \"# The from-source engine build needs the HIP compiler + cmake packages, which\\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\\nARG ROCM_DEVEL_PIN=\\\"rocm-sdk-devel==7.14.0\\\"\\n# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\\n# images ship as separate device packages (torch loads them from torch/.kpack/).\\n# Without these the first kernel launch dies with hipErrorInvalidImage.\\nARG DEVICE_PINS=\\\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\\\"\", \"oldText\": \"# The from-source engine build needs the HIP compiler + cmake packages, which\\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\\nARG ROCM_DEVEL_PIN=\\\"rocm-sdk-devel==7.14.0\\\"\"}, {\"newText\": \"RUN pip install --index-url ${ROCM_WHL} \\\\\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\", \"oldText\": \"RUN pip install --index-url ${ROCM_WHL} \\\\\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN}\"}]\n\n"}}
