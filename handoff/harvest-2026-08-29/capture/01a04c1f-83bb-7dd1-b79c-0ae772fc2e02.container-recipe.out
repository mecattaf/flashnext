= resp.headers.get(\"Content-Range\")  # bytes lo-hi/total\n        total = int(cr.split(\"/\")[1])\n        return resp.read(), total\ntail, total = fetch(total_guess:= max(0, 1-1)) if False else (None, None)\n# get size first via zero-length range\nr = urllib.request.Request(url); r.add_header(\"Range\", \"bytes=0-0\")\nwith urllib.request.urlopen(r, timeout=60) as resp:\n    total = int(resp.headers[\"Content-Range\"].split(\"/\")[1])\nprint(\"total\", total, file=sys.stderr)\ntail, _ = fetch(total - 4_000_000)\n# find EOCD\ni = tail.rfind(b\"PK\\x05\\x06\")\nassert i >= 0\ncd_size, cd_off = struct.unpack(\"<II\", tail[i+12:i+20])\n# central directory may start before our tail window\nneed_lo = cd_off\ncd, _ = fetch(need_lo, total - 1)\nentries = {}\np = 0\nwhile p < len(cd) and cd[p:p+4] == b\"PK\\x01\\x02\":\n    nlen, elen, clen = struct.unpack(\"<HHH\", cd[p+28:p+34])\n    csz, loc_off = struct.unpack(\"<II\", cd[p+20:p+28])\n    name = cd[p+46:p+46+nlen].decode()\n    entries[name] = (loc_off, csz)\n    p += 46 + nlen + elen + clen\nmeta = [n for n in entries if n.endswith(\".dist-info/METADATA\")][0]\nloc_off, csz = entries[meta]\nblob, _ = fetch(loc_off, loc_off + csz + 1000)\n# local header\nassert blob[:4] == b\"PK\\x03\\x04\"\nnlen, elen = struct.unpack(\"<HH\", blob[26:30])\ndata = blob[30+nlen+elen:30+nlen+elen+csz]\ntext = zlib.decompress(data, -15).decode()\nfor line in text.splitlines():\n    if line.startswith((\"Requires-Dist\", \"Requires-Python\", \"Version:\")):\n        print(line)\nEOF\npython3 /tmp/wheelmeta.py","timeout":180}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":1525,"output":903,"cacheRead":43008,"cacheWrite":0,"reasoning":147,"totalTokens":45436,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787983631390,"responseId":"chatcmpl-196a8a6f-0e75-43ee-a705-cd115588ab23","rawStopReason":"tool_calls"},{"role":"toolResult","toolC