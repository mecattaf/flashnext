     setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n  84 \n  85 # ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\n  86 RUN pip install --index-url ${ROCM_WHL} \\\n- 87         ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN}\n+ 91         ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n  88 \n  89 # ---- the engine fork, built from source for gfx1151 ----\n  90 ARG VLLM_REPO=https://github.com/mecattaf/vllm\n  91 ARG VLLM_BRANCH=flashnext\n     ...","patch":"--- /home/tom/.local/state/tally/campaigns/flashnext/flashnext/824b68c09c23/container-recipe/container/Containerfile\n+++ /home/tom/.local/state/tally/campaigns/flashnext/flashnext/824b68c09c23/container-recipe/container/Containerfile\n@@ -58,8 +58,12 @@\n ARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n # The from-source engine build needs the HIP compiler + cmake packages, which\n # the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\n ARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n+# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n+# images ship as separate device packages (torch loads them from torch/.kpack/).\n+# Without these the first kernel launch dies with hipErrorInvalidImage.\n+ARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n \n ENV DEBIAN_FRONTEND=noninteractive\n RUN apt-get update && apt-get install -y --no-install-recommends \\\n         python3.12 python3.12-venv python3.12-dev \\\n@@ -83,9 +87,9 @@\n         setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n \n # ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\n RUN pip install --index-url ${ROCM_WHL} \\\n-        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN}\n+        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n \n # ---- the engine fork, built from source for gfx1151 ----\n ARG VLLM_REPO=https://github.com/mecattaf/vllm\n ARG VLLM_BRANCH=flashnext\n","firstChangedLine":62},"isError":false,"timestamp":1787986323331}]}
