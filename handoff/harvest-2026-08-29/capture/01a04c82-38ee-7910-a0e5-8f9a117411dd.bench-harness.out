hunk)}\\n\\n\".encode())\n            self.wfile.flush()\n        self.wfile.write(b\"data: [DONE]\\n\\n\"); self.wfile.flush()\n\nif __name__ == \"__main__\":\n    srv = ThreadingHTTPServer((\"127.0.0.1\", 8931), H)\n    srv.serve_forever()\n","path":"/tmp/mock_vllm.py"}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":913,"output":2497,"cacheRead":122496,"cacheWrite":0,"reasoning":1143,"totalTokens":125906,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787991540022,"responseId":"chatcmpl-9f2ff421-e541-46f5-af97-113dc0e101a7","rawStopReason":"tool_calls"}}
