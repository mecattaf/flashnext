}' \"$IMAGE\")\"\nfi\n\nwrite_receipt \"$STATUS\"\npython3 -c \"import json,sys; sys.exit(0 if json.load(open('$OUT'))['status']=='pass' else 1)\"\necho \"==> flashnext:dev built; receipt: $OUT\"\n"}],"isError":false,"timestamp":1787987435547}]}
