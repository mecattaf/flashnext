ecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] The `use_fast` parameter is deprecated and will be removed in a future version. Use `backend=\\\"torchvision\\\"` instead of `use_fast=True`, or `backend=\\\"pil\\\"` instead of `use_fast=False`.\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(APIServer pid=1) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) \",\n+   \"Loading safetensors checkpoint shards:   0% Completed | 0/4 [00:00<?, ?it/s]\",\n+   \"(EngineCore pid=303) \",\n+   \"Loading safetensors checkpoint shards:  25% Completed | 1/4 [00:01<00:03,  1.26s/it]\",\n+   \"(EngineCore pid=303) \",\n+   \"Loading safetensors checkpoint shards: 100% Completed | 4/4 [00:01<00:00,  2.95it/s]\",\n+   \"(EngineCore pid=303) \",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] The `use_fast` parameter is deprecated and will be removed in a future version. Use `backend=\\\"torchvision\\\"` instead of `use_fast=True`, or `backend=\\\"pil\\\"` instead of `use_fast=False`.\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"(EngineCore pid=303) [transformers] Unrecognized keys in `rope_parameters` for 'rope_type'='default': {'mrope_section', 'mrope_interleaved'}\",\n+   \"[rank0]:[W829 10:22:01.223033086 HIPCachingAllocator.cpp:509] expandable_segments: memory mapping failed with OOM on device 0 while trying to map 20971520 bytes (free: 6609903616, total: 137438953472).\",\n+   \"(APIServer pid=1) Traceback (most recent call last):\",\n+   \"(APIServer pid=1)   File \\\"/opt/venv/bin/vllm\\\", line 8, in <module>\",\n+   \"(APIServer pid=1)     sys.exit(main())\",\n+   \"(APIServer pid=1)              ^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/cli/main.py\\\", line 97, in main\",\n+   \"(APIServer pid=1)     args.dispatch_function(args)\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/cli/serve.py\\\", line 153, in cmd\",\n+   \"(APIServer pid=1)     uvloop.run(run_server(args))\",\n+   \"(APIServer pid=1)   File \\\"/opt/venv/lib/python3.12/site-packages/uvloop/__init__.py\\\", line 96, in run\",\n+   \"(APIServer pid=1)     return __asyncio.run(\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/usr/lib/python3.12/asyncio/runners.py\\\", line 194, in run\",\n+   \"(APIServer pid=1)     return runner.run(main)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/usr/lib/python3.12/asyncio/runners.py\\\", line 118, in run\",\n+   \"(APIServer pid=1)     return self._loop.run_until_complete(task)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"uvloop/loop.pyx\\\", line 1518, in uvloop.loop.Loop.run_until_complete\",\n+   \"(APIServer pid=1)   File \\\"/opt/venv/lib/python3.12/site-packages/uvloop/__init__.py\\\", line 48, in wrapper\",\n+   \"(APIServer pid=1)     return await main\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/launchers/api_server/entry.py\\\", line 176, in run_server\",\n+   \"(APIServer pid=1)     await run_server_worker(listen_address, sock, args, **uvicorn_kwargs)\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/launchers/api_server/entry.py\\\", line 190, in run_server_worker\",\n+   \"(APIServer pid=1)     async with build_async_engine_client(\",\n+   \"(APIServer pid=1)   File \\\"/usr/lib/python3.12/contextlib.py\\\", line 210, in __aenter__\",\n+   \"(APIServer pid=1)     return await anext(self.gen)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/launchers/api_server/entry.py\\\", line 58, in build_async_engine_client\",\n+   \"(APIServer pid=1)     async with build_async_engine_client_from_engine_args(\",\n+   \"(APIServer pid=1)   File \\\"/usr/lib/python3.12/contextlib.py\\\", line 210, in __aenter__\",\n+   \"(APIServer pid=1)     return await anext(self.gen)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/entrypoints/launchers/api_server/entry.py\\\", line 94, in build_async_engine_client_from_engine_args\",\n+   \"(APIServer pid=1)     async_llm = AsyncLLM.from_vllm_config(\",\n+   \"(APIServer pid=1)                 ^^^^^^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/async_llm.py\\\", line 220, in from_vllm_config\",\n+   \"(APIServer pid=1)     return cls(\",\n+   \"(APIServer pid=1)            ^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/async_llm.py\\\", line 149, in __init__\",\n+   \"(APIServer pid=1)     self.engine_core = EngineCoreClient.make_async_mp_client(\",\n+   \"(APIServer pid=1)                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/tracing/otel.py\\\", line 178, in sync_wrapper\",\n+   \"(APIServer pid=1)     return func(*args, **kwargs)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/core_client.py\\\", line 139, in make_async_mp_client\",\n+   \"(APIServer pid=1)     return AsyncMPClient(*client_args)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/tracing/otel.py\\\", line 178, in sync_wrapper\",\n+   \"(APIServer pid=1)     return func(*args, **kwargs)\",\n+   \"(APIServer pid=1)            ^^^^^^^^^^^^^^^^^^^^^\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/core_client.py\\\", line 991, in __init__\",\n+   \"(APIServer pid=1)     super().__init__(\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/core_client.py\\\", line 609, in __init__\",\n+   \"(APIServer pid=1)     with launch_core_engines(\",\n+   \"(APIServer pid=1)   File \\\"/usr/lib/python3.12/contextlib.py\\\", line 144, in __exit__\",\n+   \"(APIServer pid=1)     next(self.gen)\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/utils.py\\\", line 1240, in launch_core_engines\",\n+   \"(APIServer pid=1)     wait_for_engine_startup(\",\n+   \"(APIServer pid=1)   File \\\"/opt/vllm/vllm/v1/engine/utils.py\\\", line 1320, in wait_for_engine_startup\",\n+   \"(APIServer pid=1)     raise RuntimeError(\",\n+   \"(APIServer pid=1) RuntimeError: Engine core initialization failed. See root cause above. Failed core proc(s): {}\"\n+  ],\n+  \"mmap\": {\n+   \"log_mentions\": 3,\n+   \"engaged\": true\n+  }\n+ }\n+}\n\\ No newline at end of file\ndiff --git a/./scripts/make-proxy.sh b/./scripts/make-proxy.sh\nnew file mode 100755\nindex 0000000..96320b8\n--- /dev/null\n+++ b/./scripts/make-proxy.sh\n@@ -0,0 +1,882 @@\n+#!/usr/bin/env bash\n+# scripts/make-proxy.sh — the proxy checkpoint builder (prep for spec claim 4.1).\n+#\n+# Builds a tiny synthetic checkpoint under /var/tmp/flashnext-proxy with the\n+# vocabulary contract of spec.md (\"proxy checkpoint\"): the same architecture\n+# identifier and expert format as the workload — a handful of layers, 8 routed\n+# experts in block-FP8 with weight_block_size [128, 128], a small engram/PLE\n+# lookup table under exactly the shard tensor naming the mmap path's\n+# discover_shards expects, plus a tokenizer so the server never reaches for a\n+# hub (spec F.6). The result proves the admitted kernel path and the ported\n+# table path on this GPU before any real weight byte is loaded.\n+#\n+# Fork-scaffold reuse doctrine (task goal: reuse, do not invent):\n+#   - The base config is the staged workload config shrunk, whenever\n+#     /var/lib/local-models/flashnext-fp8/config.json is present, so every\n+#     field the fork's config class reads keeps its exact shape.\n+#   - The PLE table naming is validated against the fork's own mmap module\n+#     (vllm.models.qwen4_exp.common.ple_mmap: _SHARD_RE, discover_shards),\n+#     and the fork's tests/models/qwen4_exp scaffolding is probed for a\n+#     shard-writer before the built-in writer is used.\n+#   - Weight tensor names are derived from the fork's own model class by\n+#     meta-device instantiation whenever that is possible; the curated\n+#     qwen3-next-family naming below is the fallback only.\n+#\n+# The checkpoint directory is disposable by construction: it is rebuilt from\n+# scratch on every run. Host-side default location keeps it OUTSIDE the repo\n+# (compare container/build.sh's cache doctrine); override with FN_PROXY_DIR.\n+set -euo pipefail\n+\n+REPO_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n+IMAGE=\"${FN_IMAGE:-flashnext:dev}\"\n+PROXY_DIR=\"${FN_PROXY_DIR:-${FN_STATE_DIR:-$HOME/.local/state/flashnext}/proxy-checkpoint}\"\n+MODEL_DIR=\"${FN_MODEL_DIR:-/var/lib/local-models/flashnext-fp8}\"\n+\n+log() { echo \"make-proxy: $*\" >&2; }\n+\n+mkdir -p \"$PROXY_DIR\"\n+find \"$PROXY_DIR\" -mindepth 1 -delete\n+log \"building the proxy checkpoint at $PROXY_DIR\"\n+\n+MOUNTS=(-v \"$PROXY_DIR:/var/tmp/flashnext-proxy\")\n+if [ -f \"$MODEL_DIR/config.json\" ]; then\n+    log \"staged workload config present at $MODEL_DIR — shrinking it as the base\"\n+    MOUNTS+=(-v \"$MODEL_DIR:/models:ro\")\n+else\n+    log \"no staged workload config at $MODEL_DIR — falling back to the evidence template\"\n+fi\n+\n+# -i keeps stdin attached: without it podman closes stdin and `python3 -`\n+# silently executes an empty program (the bug latent in run-smoke.sh).\n+# GPU devices are attached because the fork's model construction touches\n+# device tensors even under the meta-device introspection path.\n+podman run -i --rm \\\n+    --device /dev/kfd --device /dev/dri \\\n+    --security-opt seccomp=unconfined --ipc=host \\\n+    --group-add keep-groups --ulimit memlock=-1:-1 \\\n+    -e FN_PROXY_LAYERS=\"${FN_PROXY_LAYERS:-8}\" \\\n+    -e FN_PROXY_EXPERTS=\"${FN_PROXY_EXPERTS:-8}\" \\\n+    \"${MOUNTS[@]}\" \\\n+    \"$IMAGE\" python3 - <<'PY'\n+\"\"\"Build /var/tmp/flashnext-proxy: config + tokenizer + weights + PLE shards.\n+\n+Every stage is loud: a stage that cannot complete raises with a typed message,\n+and a manifest (proxy-manifest.json) records what was reused, what was\n+fallback, and every residual risk, so run-proxy.sh and the morning ledger can\n+grade provenance rather than narrate it.\n+\"\"\"\n+import importlib\n+import inspect\n+import json\n+import math\n+import os\n+import re\n+import shutil\n+import struct\n+import sys\n+import time\n+import traceback\n+from pathlib import Path\n+\n+import subprocess\n+import torch\n+\n+OUT = Path(\"/var/tmp/flashnext-proxy\")\n+MODELS = Path(\"/models\")  # read-only mount of the staged workload, if present\n+LAYERS = int(os.environ.get(\"FN_PROXY_LAYERS\", \"8\"))\n+EXPERTS = int(os.environ.get(\"FN_PROXY_EXPERTS\", \"8\"))\n+TOPK = 2\n+MOE_INTER = 256  # multiple of the 128 block size\n+BLOCK = 128\n+SEED = 42\n+\n+MANIFEST = {\n+    \"built_by\": \"scripts/make-proxy.sh\",\n+    \"ts\": time.strftime(\"%FT%T\"),\n+    \"geometry\": {\"layers\": LAYERS, \"experts\": EXPERTS,\n+                 \"weight_block_size\": [BLOCK, BLOCK]},\n+    \"base_config_source\": None,\n+    \"config_edits\": {},\n+    \"tokenizer_source\": None,\n+    \"scaffold\": {\"fork_modules_probed\": [], \"reused\": [], \"validation\": []},\n+    \"weight_source\": None,\n+    \"files\": [],\n+    \"warnings\": [],\n+}\n+\n+\n+def note(msg):\n+    print(f\"make-proxy: {msg}\", file=sys.stderr)\n+    MANIFEST[\"warnings\"].append(msg)\n+\n+\n+def die(msg):\n+    raise SystemExit(f\"make-proxy: FATAL: {msg}\")\n+\n+\n+# ---------------------------------------------------------------------------\n+# Stage 1 — config: shrink the workload config, else the evidence template\n+# ---------------------------------------------------------------------------\n+def load_base_config():\n+    p = MODELS / \"config.json\"\n+    if p.is_file():\n+        return json.loads(p.read_text()), \"workload:%s\" % p\n+    # Typed fallback: field values observed in the workload config per\n+    # specs/flashnext/evidence/dotfiles-observed.md section 3.3, completed\n+    # with the PLE geometry names per specs/flashnext/evidence/\n+    # moe-dispatch.md section 5. Only used when staging has not landed.\n+    tmpl = {\n+        \"architectures\": [\"Qwen4ExpForConditionalGeneration\"],\n+        \"model_type\": \"qwen4_exp\",\n+        \"torch_dtype\": \"bfloat16\",\n+        \"hidden_size\": 2560,\n+        \"head_dim\": 256,\n+        \"num_attention_heads\": 16,\n+        \"num_key_value_heads\": 2,\n+        \"num_hidden_layers\": LAYERS,\n+        \"full_attention_interval\": 4,\n+        \"layer_types\": [],\n+        \"vocab_size\": 4096,\n+        \"max_position_embeddings\": 4096,\n+        \"rms_norm_eps\": 1e-6,\n+        \"tie_word_embeddings\": False,\n+        \"use_qk_norm\": True,\n+        \"decoder_sparse_step\": 1,\n+        \"num_experts\": EXPERTS,\n+        \"num_experts_per_tok\": TOPK,\n+        \"moe_intermediate_size\": MOE_INTER,\n+        \"shared_expert_intermediate_size\": MOE_INTER,\n+        \"indexer_budget\": 2048,\n+        \"ngram_vocab_size_base\": 512,\n+        \"heads_per_ngram\": 1,\n+        \"ple_embed_dim\": 256,\n+        \"make_ngram_vocab_size_divisible_by\": 128,\n+        \"split_ngram_parts\": 2,\n+        \"ple_layer_ids\": [2],\n+    }\n+    return tmpl, \"template:evidence-dotfiles-observed-3.3+moe-dispatch-5\"\n+\n+\n+def shrink(cfg):\n+    # Multimodal workload configs nest the language model under text_config;\n+    # the template config is flat. Edit whichever level carries the fields.\n+    tc = cfg.get(\"text_config\", cfg)\n+    edits = {}\n+\n+    def set_(key, val):\n+        edits[key] = [tc.get(key), val]\n+        tc[key] = val\n+\n+    archs = cfg.get(\"architectures\") or []\n+    if not any(\"Qwen4Exp\" in a for a in archs):\n+        die(f\"base config architectures {archs} carry no Qwen4Exp identifier; \"\n+            \"refusing to relabel a foreign model as the proxy\")\n+    if \"language_model_only\" in cfg:\n+        cfg[\"language_model_only\"] = True  # the proxy has no vision bytes\n+        edits[\"language_model_only\"] = [False, True]\n+    set_(\"num_hidden_layers\", LAYERS)\n+    # All layers stay linear_attention in the proxy: the fork's QSA\n+    # full-attention path requires FlashAttention\n+    # (amd/qsa.py: is_flash_attn_varlen_func_available) and the container's\n+    # pinned wheel set ships no flash-attn — a full_attention layer dies at\n+    # construction with NotImplementedError. That is a typed finding for the\n+    # pair first-light lane; the proxy's claim (the admitted block-FP8 MoE\n+    # kernel and the mmap table path) is attention-agnostic.\n+    if any(t == \"full_attention\" for t in tc.get(\"layer_types\", [])):\n+        note(\"workload pattern carries full_attention layers; the proxy \"\n+             \"drops them (no flash-attn in the pinned wheel set) — typed \"\n+             \"blocker for the pair first-light lane, not the proxy\")\n+    set_(\"layer_types\", [\"linear_attention\"] * LAYERS)\n+    set_(\"num_experts\", EXPERTS)\n+    set_(\"num_experts_per_tok\",\n+         min(int(tc.get(\"num_experts_per_tok\", TOPK)), EXPERTS))\n+    # Every layer routed-MoE, so the admitted block-FP8 kernel runs on every\n+    # decode step of the proxy serve.\n+    set_(\"decoder_sparse_step\", 1)\n+    set_(\"moe_intermediate_size\", MOE_INTER)\n+    if \"shared_expert_intermediate_size\" in tc:\n+        set_(\"shared_expert_intermediate_size\", MOE_INTER)\n+    if \"intermediate_size\" in tc:\n+        set_(\"intermediate_size\", 2 * BLOCK)\n+    set_(\"max_position_embeddings\",\n+         min(int(tc.get(\"max_position_embeddings\", 4096)), 4096))\n+    if not (MODELS / \"config.json\").is_file():\n+        set_(\"vocab_size\", 4096)  # template tokenizer is paired with 4096\n+    # PLE layers survive the layer shrink; the mmap claim needs at least one.\n+    # The fork reads them 1-INDEXED: a PLE module lives on layer_idx when\n+    # (layer_idx + 1) is in ple_layer_ids (amd/model.py:193-197).\n+    ple_ids = [i for i in tc.get(\"ple_layer_ids\", range(1, LAYERS + 1))\n+               if 1 <= i <= LAYERS]\n+    if not ple_ids:\n+        ple_ids = [LAYERS]\n+    set_(\"ple_layer_ids\", ple_ids)\n+    # Block-FP8 quantization: MERGE with the workload's quantization_config\n+    # (activation_scheme and friends are required by the fork's Fp8Config —\n+    # a wholesale replacement fails VllmConfig validation), and drop the\n+    # workload's 943-entry ignore list: it names modules by layer index and\n+    # cannot survive the shrink; the builder reinstalls its own below.\n+    qc = dict(cfg.get(\"quantization_config\") or {})\n+    qc.update({\"quant_method\": \"fp8\", \"weight_block_size\": [BLOCK, BLOCK]})\n+    qc.setdefault(\"activation_scheme\", \"dynamic\")\n+    qc.pop(\"modules_to_not_convert\", None)\n+    edits[\"quantization_config\"] = \"merged; see manifest geometry\"\n+    cfg[\"quantization_config\"] = qc\n+    # Small PLE table: shrink every large ngram-size field; keep heads/dims.\n+    for key in list(tc):\n+        if \"ngram\" in key.lower() and re.search(r\"(size|base|vocab)\",\n+                                                key.lower()):\n+            val = tc[key]\n+            if isinstance(val, int) and val > 512:\n+                set_(key, 512)\n+    split_key = next((k for k in tc\n+                      if \"split\" in k.lower() and \"ngram\" in k.lower()), None)\n+    if split_key is not None:\n+        set_(split_key, 2)\n+    return edits\n+\n+\n+# ---------------------------------------------------------------------------\n+# Stage 2 — tokenizer: copy from the staged workload, else synthesize a pair\n+# ---------------------------------------------------------------------------\n+def stage_tokenizer(cfg):\n+    copied = []\n+    for name in (\"tokenizer.json\", \"tokenizer_config.json\",\n+                 \"special_tokens_map.json\", \"vocab.json\", \"merges.txt\",\n+                 \"generation_config.json\", \"chat_template.jinja\",\n+                 \"preprocessor_config.json\",\n+                 \"video_preprocessor_config.json\"):\n+        src = MODELS / name\n+        if src.is_file():\n+            shutil.copy2(src, OUT / name)\n+            copied.append(name)\n+    if any(n.startswith(\"tokenizer\") for n in copied):\n+        return \"workload:\" + \",\".join(copied)\n+    # Synthetic WordLevel tokenizer paired with the template vocab_size 4096.\n+    specials = [\"<pad>\", \"<bos>\", \"<eos>\", \"<unk>\"]\n+    vocab = {tok: i for i, tok in enumerate(specials)}\n+    i = len(specials)\n+    for c in (chr(x) for x in range(33, 127)):\n+        vocab[c] = i\n+        i += 1\n+    for word in (\"the\", \"a\", \"of\", \"and\", \"to\", \"in\", \"is\", \"on\", \"for\",\n+                 \"with\", \"that\", \"this\", \"night\", \"pair\", \"proxy\", \"light\"):\n+        if i >= int(cfg[\"vocab_size\"]):\n+            break\n+        vocab[word] = i\n+        i += 1\n+    added = [{\"id\": n, \"content\": tok, \"single_word\": False, \"lstrip\": False,\n+              \"rstrip\": False, \"normalized\": False, \"special\": True}\n+             for tok, n in zip(specials, range(len(specials)))]\n+    tok_json = {\n+        \"version\": \"1.0\", \"truncation\": None, \"padding\": None,\n+        \"added_tokens\": added,\n+        \"normalizer\": {\"type\": \"NFC\"},\n+        \"pre_tokenizer\": {\"type\": \"Whitespace\"},\n+        \"post_processor\": None,\n+        \"decoder\": {\"type\": \"WordLevel\"},\n+        \"model\": {\"type\": \"WordLevel\", \"vocab\": vocab, \"unk_token\": \"<unk>\"},\n+    }\n+    (OUT / \"tokenizer.json\").write_text(json.dumps(tok_json))\n+    (OUT / \"tokenizer_config.json\").write_text(json.dumps({\n+        \"tokenizer_class\": \"PreTrainedTokenizerFast\",\n+        \"model_max_length\": 4096,\n+        \"pad_token\": \"<pad>\", \"bos_token\": \"<bos>\",\n+        \"eos_token\": \"<eos>\", \"unk_token\": \"<unk>\",\n+    }))\n+    note(\"no staged workload tokenizer: synthesized a WordLevel pair \"\n+         \"(proxy output text quality is not the claim; finite logits are)\")\n+    return \"synthetic-wordlevel\"\n+\n+\n+# ---------------------------------------------------------------------------\n+# Stage 3 — the fork's own scaffolding: probe, reuse where possible\n+# ---------------------------------------------------------------------------\n+def probe_fork_scaffolds():\n+    \"\"\"Probe the fork's tests/models/qwen4_exp tree for reusable writers and\n+    import its ple_mmap module as the naming authority (_SHARD_RE). The test\n+    modules are probed in a SUBPROCESS: importing them in-process can double-\n+    register the fork's torch custom ops and poison this process's registry\n+    resolution (observed in review: qwen4_exp_grouped_gemma_rmsnorm).\"\"\"\n+    ple_mmap = None\n+    try:\n+        from vllm.models.qwen4_exp.common import ple_mmap as _pm\n+        ple_mmap = _pm\n+        MANIFEST[\"scaffold\"][\"reused\"].append(\n+            \"vllm.models.qwen4_exp.common.ple_mmap (naming authority)\")\n+    except Exception as e:\n+        try:\n+            from vllm.models.qwen4_exp.nvidia import ple_mmap as _pm\n+            ple_mmap = _pm\n+            MANIFEST[\"scaffold\"][\"reused\"].append(\n+                \"vllm.models.qwen4_exp.nvidia.ple_mmap (pre-0009 location)\")\n+        except Exception as e2:\n+            note(f\"ple_mmap not importable ({e!r}, {e2!r}); the serve itself \"\n+                 \"remains the naming authority\")\n+    code = (\n+        \"import importlib, inspect, json, re, sys\\n\"\n+        \"sys.path.insert(0, '/opt/vllm/tests')\\n\"\n+        \"out = []\\n\"\n+        \"for modname in ('models.qwen4_exp.test_ple_mmap',\"\n+        \" 'models.qwen4_exp.test_ple_mmap_amd',\"\n+        \" 'models.qwen4_exp.test_ple'):\\n\"\n+        \"    entry = {'module': modname}\\n\"\n+        \"    try:\\n\"\n+        \"        mod = importlib.import_module(modname)\\n\"\n+        \"        entry['test_contracts_present'] = len(\"\n+        \"[n for n in dir(mod) if n.startswith('test_')])\\n\"\n+        \"        writers = [n for n in dir(mod)\\n\"\n+        \"                   if callable(getattr(mod, n, None))\\n\"\n+        \"                   and not n.startswith('test_')\\n\"\n+        \"                   and re.search(r'(write|build|make|create).*'\"\n+        \" r'(shard|table|ckpt|checkpoint|fixture)', n, re.I)]\\n\"\n+        \"        entry['callable_writers'] = writers\\n\"\n+        \"        for wname in writers:\\n\"\n+        \"            fn = getattr(mod, wname)\\n\"\n+        \"            try:\\n\"\n+        \"                sig = inspect.signature(fn)\\n\"\n+        \"            except Exception:\\n\"\n+        \"                continue\\n\"\n+        \"            params = list(sig.parameters.values())\\n\"\n+        \"            if len(params) == 1 and params[0].default is params[0].empty:\\n\"\n+        \"                try:\\n\"\n+        \"                    fn('/var/tmp/flashnext-proxy')\\n\"\n+        \"                    entry['invoked'] = wname\\n\"\n+        \"                    break\\n\"\n+        \"                except Exception as e3:\\n\"\n+        \"                    entry[wname + '_error'] = e3.__class__.__name__\\n\"\n+        \"    except Exception as e:\\n\"\n+        \"        entry['import'] = f'FAIL {e.__class__.__name__}: {e}'\\n\"\n+        \"    out.append(entry)\\n\"\n+        \"print(json.dumps(out))\\n\"\n+    ).replace(\"\\\\n\", \"\\n\")\n+    try:\n+        proc = subprocess.run([sys.executable, \"-c\", code],\n+                              capture_output=True, text=True, timeout=600)\n+        last = (proc.stdout.strip().splitlines() or [\"[]\"])[-1]\n+        MANIFEST[\"scaffold\"][\"fork_modules_probed\"] = json.loads(last)\n+    except Exception as e:\n+        note(f\"fork test-scaffold probe unavailable: {e!r}\")\n+    return ple_mmap\n+\n+\n+def text_cfg(cfg):\n+    \"\"\"Multimodal workload configs nest the language model under text_config;\n+    the template config is flat.\"\"\"\n+    return cfg.get(\"text_config\", cfg)\n+\n+\n+def _is_prime(n):\n+    if n < 2:\n+        return False\n+    if n % 2 == 0:\n+        return n == 2\n+    i = 3\n+    while i * i <= n:\n+        if n % i == 0:\n+            return False\n+        i += 2\n+    return True\n+\n+\n+def _nth_prime_after(start, count):\n+    \"\"\"Verbatim mirror of amd/ple_layer.py:_nth_prime_after — the table's\n+    per-head row counts are primes, and the shard row math below must stay\n+    the fork's own.\"\"\"\n+    prime = int(start)\n+    for _ in range(count):\n+        candidate = prime + 1\n+        if candidate <= 2:\n+            prime = 2\n+            continue\n+        if candidate % 2 == 0:\n+            candidate += 1\n+        while not _is_prime(candidate):\n+            candidate += 2\n+        prime = candidate\n+    return prime\n+\n+\n+def ngram_geometry(cfg):\n+    \"\"\"Exact mirror of Qwen4ExpNGramEmbedding.__init__'s table arithmetic\n+    (amd/ple_layer.py) plus _attach_table's shard-placement math\n+    (common/ple_mmap.py): per-head prime row counts, padded total,\n+    shard_size = ceil(vocab / split), last shard possibly shorter.\"\"\"\n+    tc = text_cfg(cfg)\n+    base = int(tc.get(\"ngram_vocab_size_base\", 512))\n+    heads = int(tc.get(\"heads_per_ngram\", 1))\n+    ngram_size = int(tc.get(\"ngram_size\", 3))\n+    divisor = int(tc.get(\"make_ngram_vocab_size_divisible_by\", 1) or 1)\n+    split = int(tc.get(\"split_ngram_parts\", 512))\n+    embed_dim = int(tc.get(\"ple_embed_dim\", tc.get(\"head_dim\", 256)))\n+    ngram_heads = (ngram_size - 1) * heads\n+    if ngram_heads <= 0 or embed_dim % ngram_heads:\n+        die(f\"PLE geometry: embed_dim {embed_dim} not divisible by \"\n+            f\"ngram_heads {ngram_heads}\")\n+    head_dim = embed_dim // ngram_heads\n+    ple_ids = sorted(tc.get(\"ple_layer_ids\",\n+                            range(1, int(tc[\"num_hidden_layers\"]) + 1)))\n+    per_layer = {}\n+    for dense_idx, _layer_id in enumerate(ple_ids):\n+        offset = 0\n+        for local_head in range(ngram_heads):\n+            global_head = dense_idx * ngram_heads + local_head\n+            offset += _nth_prime_after(base - 1, global_head + 1)\n+        padded = ((offset + divisor - 1) // divisor) * divisor\n+        shard_size = (padded + split - 1) // split\n+        num_shards = min(split, (padded + shard_size - 1) // shard_size\n+                         if shard_size else 0)\n+        rows = [max(0, min(shard_size, padded - i * shard_size))\n+                for i in range(num_shards)]\n+        per_layer[dense_idx] = {\"padded_rows\": padded, \"rows\": rows}\n+    return {\"base\": base, \"heads\": heads, \"ngram_size\": ngram_size,\n+            \"ngram_heads\": ngram_heads, \"divisible_by\": divisor,\n+            \"split\": split, \"row_bytes\": head_dim, \"per_layer\": per_layer,\n+            \"note\": \"mirror of amd/ple_layer.py table arithmetic and \"\n+                    \"common/ple_mmap.py:_attach_table shard placement\"}\n+\n+\n+# ---------------------------------------------------------------------------\n+# Stage 4 — weights: fork introspection first, curated naming as fallback\n+# ---------------------------------------------------------------------------\n+def _bf16(t):\n+    return (\"BF16\", list(t.shape),\n+            t.to(torch.bfloat16).contiguous().view(torch.int16).numpy().tobytes())\n+\n+\n+def _fp8(t):\n+    return (\"F8_E4M3\", list(t.shape),\n+            t.to(torch.float8_e4m3fn).contiguous().view(torch.uint8).numpy().tobytes())\n+\n+\n+def _f32(t):\n+    return (\"F32\", list(t.shape),\n+            t.to(torch.float32).contiguous().numpy().tobytes())\n+\n+\n+def save_safetensors(path, tensors):\n+    \"\"\"Minimal safetensors serializer (8-byte LE header length, JSON header,\n+    packed blobs) so fp8 tensors never depend on library-version support.\n+    Offsets are contiguous and the file ends exactly at the last byte: the\n+    rust parser refuses anything else (\"file not fully covered\").\"\"\"\n+    header, blobs, offset = {}, [], 0\n+    for name, (dtype, shape, raw) in tensors.items():\n+        header[name] = {\"dtype\": dtype, \"shape\": shape,\n+                        \"data_offsets\": [offset, offset + len(raw)]}\n+        blobs.append(raw)\n+        offset += len(raw)\n+    hjson = json.dumps(header).encode()\n+    with open(path, \"wb\") as f:\n+        f.write(struct.pack(\"<Q\", len(hjson)))\n+        f.write(hjson)\n+        for blob in blobs:\n+            f.write(blob)\n+\n+\n+def scale_inv_shape(shape):\n+    return [math.ceil(d / BLOCK) for d in shape]\n+\n+\n+def try_fork_introspection(cfg):\n+    \"\"\"Instantiate the fork's model class on the meta device and return the\n+    exact parameter list, or None. When this works, weight names are the\n+    fork's own, not the curated fallback's.\"\"\"\n+    try:\n+        from vllm.config import ModelConfig, VllmConfig, set_current_vllm_config\n+        from vllm.model_executor.models.registry import ModelRegistry\n+        torch.manual_seed(SEED)\n+        mc = ModelConfig(model=str(OUT))\n+        vc = VllmConfig(model_config=mc)\n+        # The QSA full-attention path probes FlashAttention availability, and\n+        # the probe wants an initialized HIP device even though the model\n+        # itself lands on meta.\n+        try:\n+            torch.cuda.init()\n+        except Exception:\n+            pass\n+        with set_current_vllm_config(vc):\n+            # The model's parallel layers assert an initialized TP group even\n+            # at world size 1; give them a gloo one on the loopback. The init\n+            # itself needs the config context (it reads the current config).\n+            try:\n+                from vllm.distributed import (init_distributed_environment,\n+                                              initialize_model_parallel)\n+                init_distributed_environment(\n+                    world_size=1, rank=0, local_rank=0,\n+                    distributed_init_method=\"tcp://127.0.0.1:29511\",\n+                    backend=\"gloo\")\n+                initialize_model_parallel(1, 1)\n+            except Exception as e:\n+                note(f\"distributed bootstrap for introspection: {e!r}\")\n+            cls = ModelRegistry.resolve_model_cls(mc.architectures, mc)[0]\n+            with torch.device(\"meta\"):\n+                model = cls(vllm_config=vc)\n+        params = [(n, tuple(p.shape)) for n, p in model.named_parameters()]\n+        stacked = list(getattr(model, \"stacked_params_mapping\", []))\n+        modules = dict(model.named_modules())\n+        packed = dict(getattr(model, \"packed_modules_mapping\", {}) or {})\n+        if not params:\n+            raise RuntimeError(\"model instantiated with zero parameters\")\n+        return params, stacked, modules, packed\n+    except Exception as e:\n+        note(f\"fork model introspection unavailable \"\n+             f\"({e.__class__.__name__}: {e}); using the curated fallback \"\n+             \"naming with its typed residual risks\")\n+        return None\n+\n+\n+def curated_weights(cfg):\n+    \"\"\"qwen3-next-family HF naming; the fallback path. Residual risks, typed:\n+    (a) linear-attention and hyperconnection module tensors are left to the\n+    fork's own init — safe only when an ignore-list keeps them unquantized;\n+    (b) PLE shards are written only for the config's ple_layer_ids.\"\"\"\n+    tc = text_cfg(cfg)\n+    # Multimodal configs nest weights under model.language_model.\n+    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n+    H = int(tc[\"hidden_size\"])\n+    HD = int(tc.get(\"head_dim\", 256))\n+    NH = int(tc.get(\"num_attention_heads\", 16))\n+    NKV = int(tc.get(\"num_key_value_heads\", 2))\n+    V = int(tc[\"vocab_size\"])\n+    E, M = EXPERTS, int(tc.get(\"moe_intermediate_size\", MOE_INTER))\n+    S = int(tc.get(\"shared_expert_intermediate_size\", 0) or 0)\n+    quantize_linears = not bool(cfg.get(\"quantization_config\", {})\n+                                .get(\"modules_to_not_convert\"))\n+    gen = torch.Generator().manual_seed(SEED)\n+    tensors = {}\n+    emb = torch.randn(V, H, generator=gen) * 0.02\n+    tensors[f\"{prefix}.embed_tokens.weight\"] = _bf16(emb)\n+    tensors[\"lm_head.weight\"] = _bf16(emb)  # tied content keeps logits finite\n+    tensors[f\"{prefix}.norm.weight\"] = _bf16(torch.ones(H))\n+\n+    def linear(name, shape, quantized):\n+        if quantized:\n+            tensors[name + \".weight\"] = _fp8(torch.zeros(shape))\n+            tensors[name + \".weight_scale_inv\"] = _f32(\n+                torch.ones(scale_inv_shape(shape)))\n+        else:\n+            tensors[name + \".weight\"] = _bf16(torch.zeros(shape))\n+\n+    for i, lt in enumerate(tc[\"layer_types\"]):\n+        p = f\"{prefix}.layers.{i}\"\n+        tensors[f\"{p}.input_layernorm.weight\"] = _bf16(torch.ones(H))\n+        tensors[f\"{p}.post_attention_layernorm.weight\"] = _bf16(torch.ones(H))\n+        if lt == \"full_attention\":\n+            a = f\"{p}.self_attn\"\n+            linear(f\"{a}.q_proj\", (NH * HD, H), quantize_linears)\n+            linear(f\"{a}.k_proj\", (NKV * HD, H), quantize_linears)\n+            linear(f\"{a}.v_proj\", (NKV * HD, H), quantize_linears)\n+            linear(f\"{a}.o_proj\", (H, NH * HD), quantize_linears)\n+            tensors[f\"{a}.q_norm.weight\"] = _bf16(torch.ones(HD))\n+            tensors[f\"{a}.k_norm.weight\"] = _bf16(torch.ones(HD))\n+        # linear_attention layers: no checkpoint tensors are written — the\n+        # fork's own init covers them when they stay unquantized (see above).\n+        m = f\"{p}.mlp\"\n+        # The router is a Linear too: without an ignore list the Fp8 config\n+        # would claim it, so its bytes follow the same rule as the linears.\n+        linear(f\"{m}.gate\", (E, H), quantize_linears)\n+        for e in range(E):\n+            for proj, shape in ((\"gate_proj\", (M, H)), (\"up_proj\", (M, H)),\n+                                (\"down_proj\", (H, M))):\n+                linear(f\"{m}.experts.{e}.{proj}\", shape, True)\n+        if S > 0:\n+            for proj, shape in ((\"gate_proj\", (S, H)), (\"up_proj\", (S, H)),\n+                                (\"down_proj\", (H, S))):\n+                linear(f\"{m}.shared_experts.{proj}\", shape, quantize_linears)\n+    return tensors\n+\n+\n+def write_ple_shards(cfg, geom):\n+    \"\"\"One row-block tensor per shard under the discover_shards naming, plus\n+    the per-layer global weight_scale the load_weights interception keeps.\n+    Shards land on 0-indexed layer = ple_layer_id - 1, at exactly the row\n+    counts the fork's _attach_table expects. Values are fp8 zeros at scale\n+    1.0: the PLE contribution is exactly zero, which is finite by\n+    construction.\"\"\"\n+    tc = text_cfg(cfg)\n+    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n+    rb = geom[\"row_bytes\"]\n+    ple_ids = sorted(tc.get(\"ple_layer_ids\",\n+                            range(1, int(tc[\"num_hidden_layers\"]) + 1)))\n+    files = 0\n+    scale = _f32(torch.ones(1))\n+    main = {}\n+    for dense_idx, layer_id in enumerate(ple_ids):\n+        layer = layer_id - 1  # the fork's ple_layer_ids are 1-indexed\n+        for s, rows in enumerate(geom[\"per_layer\"][dense_idx][\"rows\"]):\n+            name = (f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n+                    f\"ngram_embedding.shard_{s:05d}.weight\")\n+            save_safetensors(\n+                OUT / f\"model-ple-{layer}-{s:05d}.safetensors\",\n+                {name: _fp8(torch.zeros(rows, rb))})\n+            files += 1\n+        main[f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n+             f\"ngram_embedding.weight_scale\"] = scale\n+    return files, main\n+\n+\n+def validate_ple(ple_mmap, geom, cfg):\n+    \"\"\"The fork's own discover_shards is the contract: per PLE layer it must\n+    find exactly the expected shards, at the expected row width and dtype,\n+    with the scale tensor alongside. A mismatch here would raise inside the\n+    serve after a long compile — catch it in seconds instead.\"\"\"\n+    if ple_mmap is None:\n+        note(\"skipping discover_shards validation (module not importable)\")\n+        return\n+    # discover_shards is @functools.cache'd; bypass any cache a scaffold\n+    # probe may have populated against this directory.\n+    disc = getattr(ple_mmap.discover_shards, \"__wrapped__\",\n+                   ple_mmap.discover_shards)\n+    found = disc(str(OUT))\n+    per_layer = dict(found) if not isinstance(found, dict) else found\n+    tc = text_cfg(cfg)\n+    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n+    ple_ids = sorted(tc.get(\"ple_layer_ids\",\n+                            range(1, int(tc[\"num_hidden_layers\"]) + 1)))\n+    expected_layers = [i - 1 for i in ple_ids]\n+    rb, split = geom[\"row_bytes\"], geom[\"split\"]\n+    entry, bad = {}, {}\n+    if sorted(per_layer) != sorted(expected_layers):\n+        MANIFEST[\"scaffold\"][\"validation\"].append(\n+            {\"found_layers\": sorted(per_layer),\n+             \"expected_layers\": expected_layers})\n+        die(f\"discover_shards found layers {sorted(per_layer)} but the fork \"\n+            f\"expects PLE modules on 0-indexed layers {expected_layers} \"\n+            f\"(ple_layer_ids {ple_ids} are 1-indexed)\")\n+    for dense_idx, layer_id in enumerate(ple_ids):\n+        layer = layer_id - 1\n+        ls = per_layer[layer]\n+        shards = getattr(ls, \"shards\", ls)\n+        want_rows = geom[\"per_layer\"][dense_idx][\"rows\"]\n+        info = {\"shards\": len(shards), \"cols\": getattr(ls, \"cols\", None),\n+                \"dtype\": getattr(ls, \"dtype_str\", None),\n+                \"scale\": getattr(ls, \"scale_entry\", None) is not None,\n+                \"rows\": [t[2] for t in shards.values()]\n+                if isinstance(shards, dict) else None}\n+        entry[str(layer)] = info\n+        ok = (len(shards) == len(want_rows)\n+              and info[\"cols\"] in (None, rb)\n+              and info[\"dtype\"] in (None, \"F8_E4M3\")\n+              and info[\"scale\"]\n+              and (info[\"rows\"] is None or info[\"rows\"] == want_rows))\n+        if not ok:\n+            bad[layer] = {\"info\": info, \"expected_rows\": want_rows}\n+    MANIFEST[\"scaffold\"][\"validation\"].append(\n+        {\"per_layer\": entry,\n+         \"expected\": {\"cols\": rb, \"dtype\": \"F8_E4M3\", \"split\": split}})\n+    if bad:\n+        die(f\"discover_shards contract violated on layers {bad} — the mmap \"\n+            \"path would refuse this table; refusing to hand run-proxy.sh a \"\n+            \"doomed checkpoint\")\n+\n+\n+# ---------------------------------------------------------------------------\n+# main\n+# ---------------------------------------------------------------------------\n+def main():\n+    OUT.mkdir(parents=True, exist_ok=True)\n+    cfg, source = load_base_config()\n+    MANIFEST[\"base_config_source\"] = source\n+    MANIFEST[\"config_edits\"] = shrink(cfg)\n+\n+    MANIFEST[\"tokenizer_source\"] = stage_tokenizer(cfg)\n+\n+    # Write config.json first: both fork introspection and the fork's config\n+    # class read the checkpoint directory as the model path.\n+    (OUT / \"config.json\").write_text(json.dumps(cfg, indent=1))\n+\n+    ple_mmap = probe_fork_scaffolds()\n+    geom = ngram_geometry(cfg)\n+    MANIFEST[\"geometry\"][\"ngram\"] = geom\n+\n+    introspected = try_fork_introspection(cfg)\n+    ignore = None\n+    if introspected:\n+        # Literal non-expert weight prefixes: valid under BOTH the regex and\n+        # the membership reading of modules_to_not_convert, so the skip-list\n+        # needs no semantic probe. Non-expert linears stay unquantized —\n+        # exactly the workload's shape — and every parameter the fork's class\n+        # declares is provided below.\n+        params, _stacked, _mods, _packed = introspected\n+        ignore = sorted({n[:-len(\".weight\")] for n, s in params\n+                         if n.endswith(\".weight\") and len(s) >= 1\n+                         and \".mlp.experts.\" not in n and \"scale\" not in n})\n+        ignore.append(\"lm_head\")  # top-level, never quantized\n+    else:\n+        # No introspection: carry the workload's own modules_to_not_convert\n+        # over, restricted to the layers that survive the shrink. The fork\n+        # matches it EXACTLY by module prefix (is_layer_skipped default\n+        # mode), per-layer module names are identical between the workload\n+        # and the proxy, and the routed experts are absent from the list by\n+        # construction — so the carried set is correct without enumeration.\n+        base_qc = {}\n+        if (MODELS / \"config.json\").is_file():\n+            base_qc = json.loads((MODELS / \"config.json\").read_text()).get(\n+                \"quantization_config\") or {}\n+        carry = base_qc.get(\"modules_to_not_convert\") or []\n+        keep = [e for e in carry\n+                if (lambda m: m is None or int(m.group(1)) < LAYERS)(\n+                    re.search(r\"layers\\.(\\d+)\\.\", e))]\n+        if keep and \"lm_head\" not in keep:\n+            keep.append(\"lm_head\")\n+        if keep:\n+            ignore = keep\n+    if ignore:\n+        cfg[\"quantization_config\"][\"modules_to_not_convert\"] = ignore\n+        (OUT / \"config.json\").write_text(json.dumps(cfg, indent=1))\n+        note(f\"modules_to_not_convert installed ({len(ignore)} entries) — \"\n+             \"non-expert linears stay unquantized, experts stay block-FP8\")\n+    else:\n+        note(\"RESIDUAL RISK: no ignore list installed — quantize-all mode; \"\n+             \"any quantized Linear whose name the fallback writer does not \"\n+             \"know is uninitialized fp8 memory and could poison the logits\")\n+\n+    if introspected:\n+        # Exact names from the fork's own class. Fused params are split back\n+        # into their HF-side names; batched expert tensors are split back into\n+        # per-expert HF names; only experts weights are block-FP8 (the ignore\n+        # list above keeps everything else unquantized).\n+        params, stacked, modules, packed = introspected\n+        MANIFEST[\"weight_source\"] = \"fork-introspection\"\n+        gen = torch.Generator().manual_seed(SEED)\n+        tc = text_cfg(cfg)\n+        H = int(tc[\"hidden_size\"])\n+        HD = int(tc.get(\"head_dim\", 256))\n+        NH = int(tc.get(\"num_attention_heads\", 16))\n+        NKV = int(tc.get(\"num_key_value_heads\", 2))\n+        M = int(tc.get(\"moe_intermediate_size\", MOE_INTER))\n+        E = EXPERTS\n+        tensors = {}\n+        # HF-side fused split names, sized from the module itself:\n+        # output_partition_sizes is the source of truth for shard rows.\n+        fused_map = {}  # vllm param base -> [(hf part, rows)]\n+        for name, _shape in params:\n+            if not name.endswith(\".weight\") or \"scale\" in name:\n+                continue\n+            base = name[:-len(\".weight\")]\n+            mod_path, _, param_base = base.rpartition(\".\")\n+            parts = packed.get(param_base)\n+            if not parts:\n+                continue\n+            module = modules.get(base)\n+            sizes = list(getattr(module, \"output_partition_sizes\", []) or [])\n+            real = [pt for pt in parts if not pt.startswith(\"_\")]\n+            if len(sizes) == len(parts):\n+                pairs = [(pt, sz) for pt, sz in zip(parts, sizes)\n+                         if not pt.startswith(\"_\")]\n+            elif len(sizes) == len(real):\n+                pairs = list(zip(real, sizes))\n+            elif len(sizes) > len(real):\n+                # The first part is itself a merge (in_proj_qkvz stores\n+                # q+k+v under in_proj_qkv): it absorbs the extra partition\n+                # sizes, the rest pair 1:1.\n+                extra = len(sizes) - len(real)\n+                pairs = [(real[0], sum(sizes[:extra + 1]))]\n+                pairs += list(zip(real[1:], sizes[extra + 1:]))\n+            else:\n+                note(f\"cannot split fused param {name}: \"\n+                     f\"{len(parts)} parts vs {len(sizes)} partition sizes\")\n+                continue\n+            fused_map[base] = (mod_path, [(pt, sz) for pt, sz in pairs])\n+\n+        def write_linear(hname, shape):\n+            if \".mlp.experts.\" in hname:\n+                tensors[hname + \".weight\"] = _fp8(torch.zeros(shape))\n+                tensors[hname + \".weight_scale_inv\"] = _f32(\n+                    torch.ones(scale_inv_shape(shape)))\n+            else:\n+                tensors[hname + \".weight\"] = _bf16(torch.zeros(shape))\n+\n+        for name, shape in params:\n+            if \"scale\" in name:\n+                continue  # block scales ride beside their weights below\n+            if \".ple.ple_embedding.ngram_embedding.\" in name:\n+                # Under VLLM_PLE_MMAP=1 this module is a MmapNgramEmbedding\n+                # with no resident weight: the shard files and the\n+                # weight_scale file are the checkpoint face of this table.\n+                continue\n+            if name.startswith(\"visual.\") or \".mtp.\" in name \\\n+                    or name.startswith(\"mtp.\"):\n+                continue  # language_model_only serve ignores these names\n+            # Batched expert tensors (mlp.experts[.routed_experts]\n+            # .w13_weight): split back to per-expert HF names.\n+            mex = re.match(r\"^(.*\\.mlp\\.experts)(?:\\.\\w+)?\\.\"\n+                           r\"(?:(\\d+)\\.)?(w13|w2)_weight$\", name)\n+            if mex:\n+                experts_stem, eidx, w = mex.groups()\n+                es = [int(eidx)] if eidx is not None else range(E)\n+                for e in es:\n+                    if w == \"w13\":\n+                        write_linear(f\"{experts_stem}.{e}.gate_proj\", (M, H))\n+                        write_linear(f\"{experts_stem}.{e}.up_proj\", (M, H))\n+                    else:\n+                        write_linear(f\"{experts_stem}.{e}.down_proj\", (H, M))\n+                continue\n+            if name.endswith(\".weight\") and len(shape) == 2:\n+                base = name[:-len(\".weight\")]\n+                # Fused vLLM params split back into their HF-side shard\n+                # names at the module's own partition sizes.\n+                if base in fused_map:\n+                    mod_path, pairs = fused_map[base]\n+                    for part, rows in pairs:\n+                        write_linear(f\"{mod_path}.{part}\", (rows, shape[1]))\n+                    continue\n+                write_linear(base, shape)\n+                continue\n+            if \"embed_tokens\" in name and len(shape) == 2:\n+                tensors[name] = _bf16(torch.randn(*shape, generator=gen) * 0.02)\n+                continue\n+            if \"norm\" in name and len(shape) == 1:\n+                tensors[name] = _bf16(torch.ones(shape[0]))\n+                continue\n+            if len(shape) >= 1:\n+                tensors[name] = _bf16(torch.zeros(shape))\n+        save_safetensors(OUT / \"model-00001-of-00001.safetensors\", tensors)\n+        MANIFEST[\"files\"].append(\"model-00001-of-00001.safetensors\")\n+    else:\n+        MANIFEST[\"weight_source\"] = \"curated-fallback\"\n+        tensors = curated_weights(cfg)\n+        save_safetensors(OUT / \"model-00001-of-00001.safetensors\", tensors)\n+        MANIFEST[\"files\"].append(\"model-00001-of-00001.safetensors\")\n+\n+    shard_files, scale_tensors = write_ple_shards(cfg, geom)\n+    if scale_tensors:\n+        save_safetensors(OUT / \"model-ple-scales.safetensors\", scale_tensors)\n+        MANIFEST[\"files\"].append(\"model-ple-scales.safetensors\")\n+    MANIFEST[\"geometry\"][\"ple_shard_files\"] = shard_files\n+    validate_ple(ple_mmap, geom, cfg)\n+\n+    MANIFEST[\"geometry\"][\"ple_layers_1indexed\"] = list(\n+        text_cfg(cfg).get(\"ple_layer_ids\", range(1, LAYERS + 1)))\n+    manifest_path = OUT / \"proxy-manifest.json\"\n+    manifest_path.write_text(json.dumps(MANIFEST, indent=1))\n+    total_bytes = sum(f.stat().st_size for f in OUT.iterdir() if f.is_file())\n+    n_files = len(list(OUT.glob(\"*.safetensors\")))\n+    print(f\"make-proxy: checkpoint complete: {n_files} safetensors files, \"\n+          f\"{total_bytes / 2**20:.1f} MiB, weight_source=\"\n+          f\"{MANIFEST['weight_source']}, base={source}\")\n+    if MANIFEST[\"warnings\"]:\n+        print(f\"make-proxy: {len(MANIFEST['warnings'])} warning(s) recorded \"\n+              \"in proxy-manifest.json\", file=sys.stderr)\n+\n+\n+try:\n+    main()\n+except SystemExit as e:\n+    try:\n+        (OUT / \"proxy-manifest.json\").write_text(json.dumps(MANIFEST, indent=1))\n+    except Exception:\n+        pass\n+    print(f\"{e}\", file=sys.stderr)\n+    sys.exit(1)\n+except Exception:\n+    traceback.print_exc()\n+    try:\n+        MANIFEST[\"warnings\"].append(\"unhandled exception; see container log\")\n+        (OUT / \"proxy-manifest.json\").write_text(json.dumps(MANIFEST, indent=1))\n+    except Exception:\n+        pass\n+    sys.exit(1)\n+PY\n+\n+log \"checkpoint ready at $PROXY_DIR: $(find \"$PROXY_DIR\" -name '*.safetensors' | wc -l) safetensors files\"\n+log \"next: scripts/run-proxy.sh\"\ndiff --git a/./scripts/run-proxy.sh b/./scripts/run-proxy.sh\nnew file mode 100755\nindex 0000000..fd48c0e\n--- /dev/null\n+++ b/./scripts/run-proxy.sh\n@@ -0,0 +1,406 @@\n+#!/usr/bin/env bash\n+# scripts/run-proxy.sh — single-node first-light runner for the proxy\n+# checkpoint (spec claim 4.1: \"the proxy checkpoint serves on one node with\n+# the mmap path engaged -> a proxy receipt records finite output and a clean\n+# shutdown\").\n+#\n+# Sequence: check the checkpoint exists -> serve it from the container with\n+# VLLM_PLE_MMAP=1 -> wait for the API -> ONE greedy completion -> assert\n+# finite logits via the API (every returned logprob finite) -> assert the\n+# mmap path actually engaged in the serve log -> shut down cleanly -> write\n+# results/receipts/proxy.json in the exact shape scripts/receipts-verify.py\n+# grades.\n+#\n+# Execution mode — ruling P10, not plain eager: the fork's own\n+# check_cudagraph_safety guard (patches 0009/0010; specs/flashnext/evidence/\n+# ple-54129.md section 6) REFUSES both full-graph capture and plain-eager\n+# mode when VLLM_PLE_MMAP=1, raising at construction. The sanctioned\n+# first-light mode is piecewise capture with the mmap op as a split boundary,\n+# so this runner passes exactly that. Full-graph capture stays morning work.\n+#\n+# Env discipline — spec F.9 mirrored from host/fn-env.sh: never export a\n+# default the engine reads through an is-set probe (the VLLM_USE_DEEP_GEMM /\n+# VLLM_ROCM_USE_AITER family stays UNSET). VLLM_PLE_MMAP itself is a plain\n+# bool(int(getenv)) read, so pinning it here is safe and is the claim.\n+#\n+# Every failure writes a fail receipt (graded, never silently skipped — spec\n+# F.12) and exits non-zero.\n+#\n+# amdsmi shim (typed engine defect, drained by the proxy before any real\n+# weight byte): the pinned container carries NO amdsmi, and the fork's\n+# RocmPlatform.get_device_name / with_amdsmi_context helpers reference\n+# amdsmi_init unconditionally — the first MoE forward raises NameError.\n+# The fork lane owns the real fix (a KFD/sysfs fallback like patch 0003);\n+# until then this runner generates a sysfs-backed amdsmi shim under the\n+# STATE directory (runtime state, never committed) and mounts it read-only.\n+set -euo pipefail\n+\n+REPO_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n+IMAGE=\"${FN_IMAGE:-flashnext:dev}\"\n+PROXY_DIR=\"${FN_PROXY_DIR:-${FN_STATE_DIR:-$HOME/.local/state/flashnext}/proxy-checkpoint}\"\n+PORT=\"${FN_PROXY_PORT:-1235}\"\n+CTR=\"flashnext-proxy-serve\"\n+OUT=\"$REPO_ROOT/results/receipts/proxy.json\"\n+\n+log() { echo \"run-proxy: $*\" >&2; }\n+\n+mkdir -p \"$REPO_ROOT/results/receipts\"\n+\n+STATE_DIR=\"${FN_STATE_DIR:-$HOME/.local/state/flashnext}\"\n+SHIM_DIR=\"$STATE_DIR/amdsmi-shim\"\n+mkdir -p \"$SHIM_DIR\"\n+cat > \"$SHIM_DIR/amdsmi.py\" <<'SHIM'\n+\"\"\"Sysfs-backed amdsmi stand-in for containers without the real library.\n+\n+Generated by scripts/run-proxy.sh (runtime state, never committed). Emulates\n+exactly the surface vllm/platforms/rocm.py imports, so the MoE tuned-config\n+device-name lookup and the platform plugin work on the KFD topology. This is\n+a typed workaround for the fork's unconditional amdsmi references, NOT a\n+silencing of them: every answer comes from real sysfs.\n+\"\"\"\n+import glob\n+import os\n+\n+\n+class AmdSmiException(Exception):\n+    pass\n+\n+\n+class AmdSmiMemoryType:\n+    \"\"\"Enum stand-in; rocm.py imports the name on the amdsmi path.\"\"\"\n+    VRAM = \"VRAM\"\n+    GTT = \"GTT\"\n+    INVALID = \"INVALID\"\n+\n+\n+def _drm_device_dirs():\n+    dirs = []\n+    for path in sorted(glob.glob(\"/sys/class/drm/card[0-9]*/device\")):\n+        if os.path.exists(os.path.join(path, \"mem_info_vram_total\")) \\\n+                or os.path.exists(os.path.join(path, \"gpu_busy_percent\")):\n+            dirs.append(path)\n+    return dirs\n+\n+\n+def _device_id(dev):\n+    try:\n+        return \"0x%04x\" % int(open(os.path.join(dev, \"device\")).read(), 16)\n+    except Exception:\n+        return \"0x0000\"\n+\n+\n+def amdsmi_init():\n+    return None\n+\n+\n+def amdsmi_shut_down():\n+    return None\n+\n+\n+def amdsmi_get_processor_handles():\n+    devs = _drm_device_dirs()\n+    if not devs:\n+        raise AmdSmiException(\"no amdgpu device visible in sysfs\")\n+    return list(range(len(devs)))\n+\n+\n+def amdsmi_get_gpu_asic_info(handle):\n+    devs = _drm_device_dirs()\n+    dev = devs[int(handle)]\n+    return {\n+        \"device_id\": _device_id(dev),\n+        \"market_name\": \"AMD Radeon (gfx1151 proxy shim)\",\n+        \"target_graphics_version\": \"gfx1151\",\n+        \"vendor_id\": \"0x1002\",\n+    }\n+\n+\n+def amdsmi_get_gpu_memory_total(handle):\n+    devs = _drm_device_dirs()\n+    dev = devs[int(handle)]\n+    try:\n+        return int(open(os.path.join(dev, \"mem_info_vram_total\")).read())\n+    except Exception:\n+        return 0\n+\n+\n+def amdsmi_get_gpu_device_uuid(handle):\n+    devs = _drm_device_dirs()\n+    return \"shim-%08d\" % int(handle) if devs else \"\"\n+\n+\n+def amdsmi_topo_get_link_type(handle_a, handle_b):\n+    return \"PCIe\"\n+\n+\n+def amdsmi_topo_get_numa_node_number(handle):\n+    return 0\n+\n+\n+def __getattr__(name):\n+    if name.startswith(\"amdsmi_\"):\n+        def _unsupported(*args, **kwargs):\n+            raise AmdSmiException(f\"{name} is not emulated by the proxy shim\")\n+        return _unsupported\n+    raise AttributeError(name)\n+SHIM\n+log \"amdsmi shim at $SHIM_DIR (typed workaround; fork lane owns the fix)\"\n+\n+# The receipt writer: one JSON object {\"step\",\"status\",\"ts\",\"data\"}, driven\n+# by env so the bash trap can use it too. Never overwrites an existing,\n+# parseable receipt (a later fail must not clobber the detail an earlier\n+# stage recorded).\n+write_receipt() {  # $1=status  $2=data-json\n+    FN_STATUS=\"$1\" FN_DATA=\"$2\" FN_OUT=\"$OUT\" python3 - <<'PY'\n+import json, os, sys, time\n+out = os.environ[\"FN_OUT\"]\n+try:\n+    existing = json.load(open(out))\n+    if isinstance(existing, dict) and existing.get(\"step\") == \"proxy\":\n+        print(f\"run-proxy: receipt already written ({existing.get('status')}); keeping it\",\n+              file=sys.stderr)\n+        sys.exit(0)\n+except Exception:\n+    pass\n+try:\n+    data = json.loads(os.environ[\"FN_DATA\"])\n+except Exception as e:\n+    data = {\"error\": f\"unparseable data payload: {e}\"}\n+json.dump({\"step\": \"proxy\", \"status\": os.environ[\"FN_STATUS\"],\n+           \"ts\": time.strftime(\"%FT%T\"), \"data\": data},\n+          open(out, \"w\"), indent=1)\n+print(f\"run-proxy: proxy receipt ({os.environ['FN_STATUS']}): {out}\",\n+      file=sys.stderr)\n+PY\n+}\n+\n+cleanup_container() {\n+    podman rm -f \"$CTR\" >/dev/null 2>&1 || true\n+}\n+\n+on_error() {\n+    local line=\"$1\"\n+    log \"FAILED at line $line — recording a fail receipt and cleaning up\"\n+    local tailtxt=\"\"\n+    tailtxt=\"$(podman logs --tail 40 \"$CTR\" 2>&1 || true)\"\n+    export FN_TAIL=\"$tailtxt\" FN_LINE=\"$line\"\n+    write_receipt \"fail\" \\\n+        \"$(python3 -c 'import json,os; print(json.dumps({\"aborted_at_line\": int(os.environ[\"FN_LINE\"]), \"serve_log_tail\": os.environ[\"FN_TAIL\"].splitlines()[-40:]}))')\"\n+    cleanup_container\n+    exit 1\n+}\n+trap 'on_error $LINENO' ERR\n+\n+# --- 0. the checkpoint gate ----------------------------------------------------\n+if [ ! -f \"$PROXY_DIR/config.json\" ]; then\n+    write_receipt \"fail\" \"{\\\"error\\\": \\\"no proxy checkpoint at $PROXY_DIR (config.json missing)\\\", \\\"typed_blocker\\\": \\\"run scripts/make-proxy.sh first\\\"}\"\n+    log \"FATAL: no proxy checkpoint at $PROXY_DIR — run scripts/make-proxy.sh first\"\n+    exit 1\n+fi\n+if ! podman image exists \"$IMAGE\" 2>/dev/null; then\n+    write_receipt \"fail\" \"{\\\"error\\\": \\\"image $IMAGE not found\\\", \\\"typed_blocker\\\": \\\"run container/build.sh first\\\"}\"\n+    log \"FATAL: image $IMAGE not found — run container/build.sh first\"\n+    exit 1\n+fi\n+\n+cleanup_container\n+BUILD_INFO=\"$(podman run --rm --entrypoint cat \"$IMAGE\" /opt/flashnext/build-info.json 2>/dev/null || echo '{}')\"\n+log \"engine identity: $(echo \"$BUILD_INFO\" | python3 -c 'import json,sys\n+try:\n+    b = json.load(sys.stdin); print(b.get(\"fork_commit\", \"unknown\"))\n+except Exception: print(\"unknown\")')\"\n+\n+# --- 1. the serve: single node, mmap path engaged, piecewise per ruling P10 ----\n+# Do not add comments inside the backslash-continued `vllm serve` command\n+# below: a '#' there silently comments out every remaining argument.\n+log \"serving $PROXY_DIR as 'flashnext-proxy' on 127.0.0.1:$PORT (VLLM_PLE_MMAP=1, piecewise)\"\n+podman run -d --name \"$CTR\" \\\n+    --network host --ipc host \\\n+    --device /dev/kfd --device /dev/dri \\\n+    --security-opt seccomp=unconfined \\\n+    --group-add keep-groups --ulimit memlock=-1:-1 \\\n+    -v \"$PROXY_DIR:/var/tmp/flashnext-proxy:ro\" \\\n+    -v \"$SHIM_DIR:/opt/amdsmi_shim:ro\" \\\n+    -e PYTHONPATH=/opt/amdsmi_shim \\\n+    -e VLLM_PLE_MMAP=1 \\\n+    -e HF_HUB_OFFLINE=1 \\\n+    -e VLLM_NO_USAGE_STATS=1 \\\n+    -e VLLM_DO_NOT_TRACK=1 \\\n+    -e PYTHONHASHSEED=0 \\\n+    -e HSA_ENABLE_INTERRUPT=1 \\\n+    -e PYTORCH_HIP_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.85\" \\\n+    \"$IMAGE\" bash -lc \"exec vllm serve /var/tmp/flashnext-proxy \\\n+        --served-model-name flashnext-proxy \\\n+        --host 127.0.0.1 \\\n+        --port $PORT \\\n+        --tensor-parallel-size 1 \\\n+        --max-model-len 4096 \\\n+        --gpu-memory-utilization 0.6 \\\n+        --language-model-only \\\n+        -cc.cudagraph_mode=PIECEWISE\"\n+\n+# --- 2. wait, complete, assert, shut down, receipt -----------------------------\n+export FN_API=\"http://127.0.0.1:$PORT\"\n+export FN_CTR=\"$CTR\"\n+export FN_OUT=\"$OUT\"\n+export FN_BOOT_TIMEOUT=\"${FN_PROXY_BOOT_TIMEOUT:-3600}\"\n+export FN_BUILD_INFO=\"$BUILD_INFO\"\n+export FN_PROXY_DIR=\"$PROXY_DIR\"\n+export FN_IMAGE=\"$IMAGE\"\n+\n+python3 - <<'PY'\n+import json, math, os, subprocess, sys, time, urllib.error, urllib.request\n+\n+API = os.environ[\"FN_API\"]\n+CTR = os.environ[\"FN_CTR\"]\n+MODEL = \"flashnext-proxy\"\n+BOOT_TIMEOUT = int(os.environ[\"FN_BOOT_TIMEOUT\"])\n+\n+def podman(*args, timeout=600):\n+    return subprocess.run([\"podman\", *args], capture_output=True, text=True,\n+                          timeout=timeout)\n+\n+def container_running():\n+    p = podman(\"inspect\", \"-f\", \"{{.State.Running}}\", CTR, timeout=30)\n+    return p.returncode == 0 and p.stdout.strip() == \"true\"\n+\n+def serve_log_tail(n=200):\n+    p = podman(\"logs\", \"--tail\", str(n), CTR, timeout=60)\n+    return (p.stdout + p.stderr).splitlines()\n+\n+def get(path, timeout=10):\n+    with urllib.request.urlopen(API + path, timeout=timeout) as r:\n+        return json.loads(r.read())\n+\n+def post(path, body, timeout=3600):\n+    req = urllib.request.Request(API + path, data=json.dumps(body).encode(),\n+                                 headers={\"Content-Type\": \"application/json\"})\n+    with urllib.request.urlopen(req, timeout=timeout) as r:\n+        return json.loads(r.read())\n+\n+status = \"pass\"\n+data = {\n+    \"checkpoint\": \"/var/tmp/flashnext-proxy\",\n+    \"amdsmi_shim\": {\n+        \"active\": True,\n+        \"reason\": \"container ships no amdsmi; fork RocmPlatform references \"\n+                  \"amdsmi_init unconditionally (NameError on first MoE \"\n+                  \"forward) — typed defect for the fork lane\",\n+    },\n+    \"serve\": {\"mode\": \"single-node\", \"vllm_ple_mmap\": 1,\n+              \"cudagraph_mode\": \"PIECEWISE\", \"port\": API.rsplit(\":\", 1)[-1],\n+              \"served_model_name\": MODEL},\n+    \"mmap_engaged\": False, \"finite_logits\": False,\n+    \"shutdown\": {\"clean\": False, \"exit_code\": None},\n+}\n+\n+# Engine identity and the builder's manifest ride with the claim.\n+try:\n+    data[\"engine\"] = json.loads(os.environ[\"FN_BUILD_INFO\"])\n+except Exception:\n+    data[\"engine\"] = {}\n+try:\n+    data[\"checkpoint_manifest\"] = json.load(\n+        open(os.path.join(os.environ[\"FN_PROXY_DIR\"], \"proxy-manifest.json\")))\n+except Exception as e:\n+    data[\"checkpoint_manifest\"] = f\"unreadable: {e}\"\n+\n+# --- wait for the API (cold triton compile makes this the long pole) --------\n+deadline = time.time() + BOOT_TIMEOUT\n+started = time.time()\n+ready = False\n+while time.time() < deadline:\n+    if not container_running():\n+        status = \"fail\"\n+        data[\"error\"] = \"serve container died during boot\"\n+        data[\"serve_log_tail\"] = serve_log_tail()\n+        break\n+    try:\n+        models = [m[\"id\"] for m in get(\"/v1/models\").get(\"data\", [])]\n+        if MODEL in models:\n+            ready = True\n+            break\n+    except Exception:\n+        pass\n+    time.sleep(5)\n+data[\"serve\"][\"boot_seconds\"] = round(time.time() - started, 1)\n+if not ready and status == \"pass\":\n+    status = \"fail\"\n+    data[\"error\"] = f\"API never answered inside {BOOT_TIMEOUT}s\"\n+    data[\"serve_log_tail\"] = serve_log_tail()\n+\n+# --- one greedy completion, finite logits asserted via the API --------------\n+if ready:\n+    prompt = \"First light on the proxy checkpoint proves \"\n+    try:\n+        r = post(\"/v1/completions\",\n+                 {\"model\": MODEL, \"prompt\": prompt, \"max_tokens\": 16,\n+                  \"temperature\": 0, \"logprobs\": 5})\n+        choice = r[\"choices\"][0]\n+        data[\"completion\"] = {\n+            \"prompt\": prompt,\n+            \"text\": choice[\"text\"],\n+            \"finish_reason\": choice.get(\"finish_reason\"),\n+            \"tokens\": r.get(\"usage\", {}).get(\"completion_tokens\"),\n+        }\n+        # The API-visible face of the logits: every returned logprob value.\n+        values = []\n+        lp = choice.get(\"logprobs\") or {}\n+        for x in lp.get(\"token_logprobs\") or []:\n+            if x is not None:\n+                values.append(float(x))\n+        for top in lp.get(\"top_logprobs\") or []:\n+            for v in (top or {}).values():\n+                if v is not None:\n+                    values.append(float(v))\n+        data[\"logprobs_checked\"] = len(values)\n+        data[\"finite_logits\"] = bool(values) and all(math.isfinite(v)\n+                                                     for v in values)\n+        if not data[\"finite_logits\"]:\n+            status = \"fail\"\n+            data[\"error\"] = data.get(\n+                \"error\", \"no finite logprob values returned — logits not proven finite\")\n+    except Exception as e:\n+        status = \"fail\"\n+        data[\"error\"] = f\"completion failed: {e.__class__.__name__}: {e}\"\n+        data[\"serve_log_tail\"] = serve_log_tail()\n+\n+# --- mmap engagement: the claim is 'with the mmap path engaged' --------------\n+logtext = \"\\n\".join(serve_log_tail(20000)).lower()\n+mentions = logtext.count(\"ple_mmap\")\n+data[\"mmap\"] = {\"log_mentions\": mentions,\n+                \"engaged\": mentions > 0}\n+data[\"mmap_engaged\"] = mentions > 0\n+if ready and mentions == 0:\n+    status = \"fail\"\n+    data[\"error\"] = data.get(\n+        \"error\", \"\") + \" | VLLM_PLE_MMAP never shows in the serve log — the table path did not engage\"\n+\n+# --- clean shutdown: SIGTERM, graceful exit code, container removed -----------\n+stop = podman(\"stop\", \"-t\", \"120\", CTR, timeout=240)\n+insp = podman(\"inspect\", \"-f\", \"{{.State.ExitCode}}\", CTR, timeout=30)\n+try:\n+    code = int(insp.stdout.strip())\n+except Exception:\n+    code = None\n+data[\"shutdown\"] = {\"clean\": stop.returncode == 0 and code == 0,\n+                    \"exit_code\": code}\n+if not data[\"shutdown\"][\"clean\"]:\n+    status = \"fail\"\n+    data[\"error\"] = data.get(\"error\", \"\") + \\\n+        f\" | unclean shutdown (stop rc={stop.returncode}, exit={code})\"\n+podman(\"rm\", \"-f\", CTR)\n+\n+# --- the receipt: results/receipts/proxy.json --------------------------------\n+receipt = {\"step\": \"proxy\", \"status\": status,\n+           \"ts\": time.strftime(\"%FT%T\"), \"data\": data}\n+with open(os.environ[\"FN_OUT\"], \"w\") as f:\n+    json.dump(receipt, f, indent=1)\n+print(f\"run-proxy: proxy receipt ({status}): {os.environ['FN_OUT']}\",\n+      file=sys.stderr)\n+sys.exit(0 if status == \"pass\" else 1)\n+PY\n+# A non-zero exit above means the step failed; the ERR trap has recorded the\n+# fail receipt (or kept the one the python stage wrote) and cleaned up.\n+cleanup_container\n+log \"receipt: $OUT\"\ndiff --git a/./tests/test_proxy_tooling.py b/./tests/test_proxy_tooling.py\nnew file mode 100644\nindex 0000000..c892240\n--- /dev/null\n+++ b/./tests/test_proxy_tooling.py\n@@ -0,0 +1,92 @@\n+\"\"\"Proxy tooling pins — the cheap, offline half of spec claim 4.1.\n+\n+Mirrors the claim-6.4 shape (\"the tests suite's package assertions pass:\n+syntax-clean scripts, …\"): these tests grade scripts/make-proxy.sh and\n+scripts/run-proxy.sh BEFORE the overnight serve, so a doctrine drift in the\n+runner is caught by the repo-tests gate rather than by a burned night.\n+\"\"\"\n+\n+import pathlib\n+import re\n+import subprocess\n+import unittest\n+\n+ROOT = pathlib.Path(__file__).resolve().parent.parent\n+MAKE = ROOT / \"scripts\" / \"make-proxy.sh\"\n+RUN = ROOT / \"scripts\" / \"run-proxy.sh\"\n+\n+\n+class ProxyTooling(unittest.TestCase):\n+    def setUp(self):\n+        for path in (MAKE, RUN):\n+            self.assertTrue(path.is_file(), f\"{path} missing\")\n+        self.make = MAKE.read_text()\n+        self.run = RUN.read_text()\n+\n+    def test_scripts_are_syntax_clean(self):\n+        for path in (MAKE, RUN):\n+            subprocess.run([\"bash\", \"-n\", str(path)], check=True)\n+\n+    def test_run_proxy_writes_the_claimed_receipt(self):\n+        # Claim 4.1's receipt is graded by scripts/receipts-verify.py.\n+        self.assertIn(\"results/receipts/proxy.json\", self.run)\n+\n+    def test_mmap_path_is_engaged(self):\n+        # The claim is \"with the mmap path engaged\"; the runner pins the flag\n+        # (a plain bool(int(getenv)) read — safe to export, spec F.9 noted).\n+        self.assertIn(\"VLLM_PLE_MMAP=1\", self.run)\n+        # …and asserts engagement from the serve log, not from hope.\n+        self.assertIn(\"mmap_engaged\", self.run)\n+\n+    def test_first_light_mode_is_piecewise_not_eager(self):\n+        # Ruling P10: the table path's own guard refuses plain-eager mode and\n+        # full-graph capture under VLLM_PLE_MMAP=1; the sanctioned first-light\n+        # mode is piecewise capture with the mmap op as a split boundary.\n+        self.assertIn(\"PIECEWISE\", self.run)\n+        self.assertNotIn(\"--enforce-eager\", self.run,\n+                         \"the fork's check_cudagraph_safety guard raises on \"\n+                         \"plain-eager mode under VLLM_PLE_MMAP=1\")\n+\n+    def test_checkpoint_contract(self):\n+        # The vocabulary contract of spec.md \"proxy checkpoint\": same\n+        # architecture identifier, 8 experts, block-FP8 [128, 128], and the\n+        # shard naming the mmap path's discover_shards expects.\n+        self.assertIn(\"/var/tmp/flashnext-proxy\", self.make)\n+        self.assertIn(\"Qwen4ExpForConditionalGeneration\", self.make)\n+        self.assertIn(\"weight_block_size\", self.make)\n+        self.assertIn(\"ngram_embedding.shard_\", self.make)\n+        self.assertIn(\"ngram_embedding.weight_scale\", self.make)\n+        self.assertRegex(self.make, r\"FN_PROXY_EXPERTS:-8\\}\")\n+\n+    def test_no_is_set_probe_exports(self):\n+        # Spec F.9 (mirrored from host/fn-env.sh): never export a default the\n+        # engine reads through an is-set probe — exporting the value it\n+        # already has diverts the fp8 oracle into a hard raise. Check the\n+        # directive lines, not the prose that explains the discipline.\n+        probes = (\"VLLM_USE_DEEP_GEMM\", \"VLLM_MOE_USE_DEEP_GEMM\",\n+                  \"VLLM_ROCM_USE_AITER\")\n+        for name, text in ((\"make-proxy.sh\", self.make),\n+                           (\"run-proxy.sh\", self.run)):\n+            directives = [ln for ln in text.splitlines()\n+                          if re.match(r\"\\s*(-e\\s+|--env\\S*\\s+|export\\s+)\", ln)]\n+            joined = \"\\n\".join(directives)\n+            for probe in probes:\n+                self.assertNotIn(probe, joined,\n+                                 f\"is-set probe {probe} exported in {name}\")\n+\n+    def test_runtime_hub_downloads_forbidden(self):\n+        # Spec F.6: the proxy serves from its own disk; tokenizer comes from\n+        # the staged workload or is synthesized, never fetched.\n+        self.assertIn(\"HF_HUB_OFFLINE=1\", self.run)\n+        for text in (self.make, self.run):\n+            self.assertNotIn(\"huggingface.co\", text)\n+            self.assertNotIn(\"hf download\", text)\n+\n+    def test_failure_is_graded_never_skipped(self):\n+        # Spec F.12: every failure path lands a receipt.\n+        self.assertIn(\"fail\", self.run)\n+        self.assertIn('\"step\": \"proxy\"', self.run.replace(\"'\", '\"'))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","reason":null,"status":"?? results/receipts/proxy.json\n?? scripts/make-proxy.sh\n?? scripts/run-proxy.sh\n?? tests/test_proxy_tooling.py\n","taskId":"proxy-tooling","truncated":false}
