TALLY_FINAL_MESSAGE={"baseRevision":"a428fee66b83d95682b418d5fdb4d975068e66ab","blocked":[],"campaign":"flashnext","checkpoints":[],"closingSummary":null,"complete":false,"deferrals":[{"taskId":"cp-weights","waitingOn":["container-recipe","instruments","host-tooling","bench-harness","proxy-tooling","morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-build","waitingOn":["host-tooling","bench-harness","proxy-tooling","morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-smoke","waitingOn":["host-tooling","bench-harness","proxy-tooling","morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-proxy","waitingOn":["host-tooling","bench-harness","morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-tp2","waitingOn":["bench-harness","morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-bench","waitingOn":["morning-ledger","catalog-handoff","rdma-package"]},{"taskId":"cp-close","waitingOn":["rdma-package"]}],"diagnoses":[],"escalation":null,"frontier":[{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n container/build.sh && grep -q 'torch==2.13.0+rocm7.14.0' container/Containerfile && grep -q 'repo.amd.com/rocm/whl-multi-arch' container/Containerfile && grep -q 'mecattaf/vllm' container/Containerfile && grep -q 'flashnext:dev' container/build.sh && grep -qi 'MIT' container/Containerfile"],"description":"The recipe pins the exact wheel set, the fork branch, and the image tag, and is syntax-clean.","id":"recipe-pins"}],"conflictDomains":["container","results/receipts"],"deliveredBehaviors":["A reproducible image build from the fork at the exactly pinned wheel set","A build receipt the receipts gate can grade"],"dependencies":[],"goal":"THE PRIMARY ENGINE LANE of spec ruling P4 (the nix wiring in the tree is the graduation lane — leave it alone). Write container/Containerfile and container/build.sh implementing IMPORTS.md sections 1 and 2 and spec claim 3.1 (specs/flashnext/spec.md#r3), designed for overnight iteration: the fork checkout and its build directory are bind-mounted volumes with ccache enabled so a one-line patch rebuild recompiles only what changed, and the image can be entered for edit-and-restart iteration without a rebuild. Containerfile: Ubuntu 24.04; python 3.12 venv at /opt/venv; install torch 2.13.0+rocm7.14.0 and torchvision 0.28.0+rocm7.14.0 and the matching triton wheel from the vendor stable index https://repo.amd.com/rocm/whl-multi-arch/ (record the exact resolved triton version); git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm and build it from source against those wheels for GPU target gfx1151 (relax nothing: the torch pin is satisfied exactly; drop audio extras rather than adding torchaudio); COPY container/rootfs/ into site-packages so the fn_ instrument modules land importable; write /opt/flashnext/build-info.json inside the image carrying the fork commit, torch, triton, and image build time. build.sh: run the packaging tests first, then podman build tagged flashnext:dev, then write results/receipts/build.json as {step:\"build\", status, ts, data:{torch, triton, fork_commit, image_digest}} with status fail on any error. Credit the recipe shape to the MIT toolbox recipe named in THIRD_PARTY_NOTICES.md in the Containerfile header. Boundaries: touch only container/ and results/receipts/.","id":"container-recipe","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r3","IMPORTS.md","specs/flashnext/evidence/kyuz0-rocm10.md"],"styleReferences":["scripts/run-smoke.sh"]},"revision":"sha256:6e8621b55de3a3a9c646edd59fb1c26372db042e230f9d2d3ec5a4e08d329361","title":"Container recipe: pinned wheel set + engine fork built from source"}],"inputEpochs":{"bench-harness":"sha256:cba7d5f3e67ea19d5272579b6816bbfd2e407588fe9b4a61da416c8a1c57aa49","catalog-handoff":"sha256:9761f4390f559d046d964c0372f1819c0bc01b83e47e18448c490a24b04385ed","container-recipe":"sha256:1e854436daea71b5678daddf962d942cc27a75cc1483ff6212735e65928b5a63","cp-bench":"sha256:b664febb5bb3a52e84267bd7c4f343753c56be5d98796fc517cc6a565847b003","cp-build":"sha256:2a39e30082d563c7b5088199b5da6df98513e32d371d384e9c33f8d8f5a6a629","cp-close":"sha256:d0561387144934af0071a18388de11968a5dd96ba199ce6599b35b46905fa14e","cp-proxy":"sha256:a3d50f72301ae0c33b0b2aa0e8b8533dc139372f2f06ccfefd10b33dc9fbf05c","cp-smoke":"sha256:5678368f6a54d9797cbd69e04644d2f3d542b92653c8fc00d1b0881d4cb76ecb","cp-tp2":"sha256:6bb34cc2a74aca9267004f096723ac202a9715290bbf3b51c05b9e55aa5c91e9","cp-weights":"sha256:7e1479062d9c8f01724cea119dd68290d90e6501b7c3b6d232f254f082013990","host-tooling":"sha256:b771d06ffbc5cd093ade0388dbf7dd8d390243cf5e3a7e92dce2bedb4b78a0ff","instruments":"sha256:347517ad56e50308317a8a6db7e931c56d2b850afeec55dbaa2f514bb01b333c","morning-ledger":"sha256:0a6988d5ebaead0c3145116b5b5227d67c6ef939c9f225c4ee15c01fdc6075ca","proxy-tooling":"sha256:8fbd29dca4ddd90aceea15bc579c7a4b27ecf39a80144c0ace11cf9359f99412","rdma-package":"sha256:2973fd76de50f09858cd59d3bc3414ff76f5d9a7ab5615904a976a88d9e1af3e"},"merged":[],"outcomes":[],"quiescent":false,"remaining":["container-recipe","instruments","host-tooling","bench-harness","proxy-tooling","morning-ledger","catalog-handoff","rdma-package","cp-weights","cp-build","cp-smoke","cp-proxy","cp-tp2","cp-bench","cp-close"],"repository":"mecattaf/flashnext","retries":[],"schemaVersion":1,"source":{"path":"silent-factory-worklists/flashnext.json","revision":"fb4166e48ce41525994c135e8c3764ec1a8e6fe6","sha256":"sha256:23a4ac29cc295b52f9754fb325f822f683f6a2040b27311c31088dd4fdbdfb2c"},"tasks":[{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n container/build.sh && grep -q 'torch==2.13.0+rocm7.14.0' container/Containerfile && grep -q 'repo.amd.com/rocm/whl-multi-arch' container/Containerfile && grep -q 'mecattaf/vllm' container/Containerfile && grep -q 'flashnext:dev' container/build.sh && grep -qi 'MIT' container/Containerfile"],"description":"The recipe pins the exact wheel set, the fork branch, and the image tag, and is syntax-clean.","id":"recipe-pins"}],"conflictDomains":["container","results/receipts"],"deliveredBehaviors":["A reproducible image build from the fork at the exactly pinned wheel set","A build receipt the receipts gate can grade"],"dependencies":[],"goal":"THE PRIMARY ENGINE LANE of spec ruling P4 (the nix wiring in the tree is the graduation lane — leave it alone). Write container/Containerfile and container/build.sh implementing IMPORTS.md sections 1 and 2 and spec claim 3.1 (specs/flashnext/spec.md#r3), designed for overnight iteration: the fork checkout and its build directory are bind-mounted volumes with ccache enabled so a one-line patch rebuild recompiles only what changed, and the image can be entered for edit-and-restart iteration without a rebuild. Containerfile: Ubuntu 24.04; python 3.12 venv at /opt/venv; install torch 2.13.0+rocm7.14.0 and torchvision 0.28.0+rocm7.14.0 and the matching triton wheel from the vendor stable index https://repo.amd.com/rocm/whl-multi-arch/ (record the exact resolved triton version); git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm and build it from source against those wheels for GPU target gfx1151 (relax nothing: the torch pin is satisfied exactly; drop audio extras rather than adding torchaudio); COPY container/rootfs/ into site-packages so the fn_ instrument modules land importable; write /opt/flashnext/build-info.json inside the image carrying the fork commit, torch, triton, and image build time. build.sh: run the packaging tests first, then podman build tagged flashnext:dev, then write results/receipts/build.json as {step:\"build\", status, ts, data:{torch, triton, fork_commit, image_digest}} with status fail on any error. Credit the recipe shape to the MIT toolbox recipe named in THIRD_PARTY_NOTICES.md in the Containerfile header. Boundaries: touch only container/ and results/receipts/.","id":"container-recipe","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r3","IMPORTS.md","specs/flashnext/evidence/kyuz0-rocm10.md"],"styleReferences":["scripts/run-smoke.sh"]},"revision":"sha256:6e8621b55de3a3a9c646edd59fb1c26372db042e230f9d2d3ec5a4e08d329361","title":"Container recipe: pinned wheel set + engine fork built from source"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -m py_compile container/rootfs/fn_synctrace.py container/rootfs/fn_offload_batch.py container/rootfs/fn_expert_union.py && grep -l 'Adapted from' container/rootfs/fn_*.py | wc -l | grep -qx 3 && python3 -m unittest tests.test_instruments -v"],"description":"All three modules compile, carry notices, and their tests pass.","id":"instruments-compile-with-notices"}],"conflictDomains":["container/rootfs","tests"],"deliveredBehaviors":["Instruments importable inside the image with FN_ kill-switches, default off","Notice headers travel with every adapted module"],"dependencies":[],"goal":"Create container/rootfs/ carrying three instrument modules adapted from the Apache-2.0 reference implementation, per specs/flashnext/evidence/ds4-vllm-manifest.md section 3, renamed to the FN_ env prefix: fn_synctrace.py (wraps the handful of tensor methods that force a blocking device-to-host sync, ~25 events per step, driven from a FN_PROFILE window), fn_offload_batch.py (the store-batch and promote budget helpers fixing the upstream offload defect; env FN_OFFLOAD_STORE_BATCH_FRAC and FN_OFFLOAD_PROMOTE_FRAC), and fn_expert_union.py (counts distinct routed experts per decode step; the reference wrapped a routing entry the workload never calls — re-target the wrap onto the stock fused-mixture router entry fused_topk in vllm/model_executor/layers/fused_moe/router/fused_topk_router.py as established in specs/flashnext/evidence/qsa-53896.md section 4; env FN_EXPERT_UNION with FN_EU_START, FN_EU_CALLS, FN_EU_OUT). Every module keeps an adaptation notice header naming the upstream file and license. Add tests/test_instruments.py asserting: py_compile passes for each module, each carries the notice header, and fn_offload_batch budget arithmetic matches the reference invariants (floor at max group size; promote counted in blocks). Boundaries: touch only container/rootfs/ and tests/.","id":"instruments","kind":"implementation","readFirst":{"specSections":["specs/flashnext/evidence/ds4-vllm-manifest.md","specs/flashnext/evidence/qsa-53896.md"],"styleReferences":["scripts/receipts-verify.py"]},"revision":"sha256:16ab40e19244fd0f9cde08858a2c348ff99e701e0a8ce46b6e99fc84b6d36c5b","title":"Engagement-proof instruments adapted into the container overlay"},{"acceptanceCriteria":[{"argv":["bash","-euc","for f in host/*.sh scripts/run-tp2.sh; do bash -n \"$f\"; done && grep -q 'PYTHONHASHSEED=0' host/fn-env.sh && grep -q 'NCCL_SOCKET_IFNAME' host/fn-env.sh && grep -q 'thunderbolt0' host/fn-env.sh && grep -q 'NCCL_IB_DISABLE=1' host/fn-env.sh && grep -q 'VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=FN_' host/fn-env.sh && grep -q 'ExecStopPost' host/systemd/flashnext-pair.service && ! grep -q 'WantedBy' host/systemd/flashnext-pair.service && python3 -m unittest tests.test_host_tooling -v"],"description":"Env doctrine present, units teardown-safe, all scripts syntax-clean, host tests pass.","id":"host-doctrine"}],"conflictDomains":["host","scripts/run-tp2.sh","tests"],"deliveredBehaviors":["One command stands the pair service; one command tears it down; failure cannot strand ranks","First light produces the four receipts the ladder grades"],"dependencies":[],"goal":"Write the host/ tooling and scripts/run-tp2.sh per spec claims 4.2, 4.3, 4.4, 4.5 and 6.1 (specs/flashnext/spec.md#r4, #r6), composing the disciplines in specs/flashnext/evidence/ds4-vllm-manifest.md section 5 and specs/flashnext/evidence/dotfiles-observed.md section 5. host/fn-env.sh: PYTHONHASHSEED=0; PYTORCH_HIP_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.85; HSA_ENABLE_INTERRUPT=1; inductor and triton cache dirs under the state directory, never tmpfs; NCCL_SOCKET_IFNAME set ONLY to the Thunderbolt rails that carry a routable /30 IP (rail 0 thunderbolt0/10.99.0.x is guaranteed; rail 1 thunderbolt1 is trained-but-IP-unconfigured today per dotfiles modules/lowlat-cluster.nix and MUST NOT be listed until it has a peer IP — a peerless link-local rail in the list hangs RCCL bootstrap; the env file computes this from `ip -br addr` at write time and logs which rails it chose, rather than hardcoding both); NCCL_IB_DISABLE=1 UNCONDITIONALLY (an ibverbs device now exists on the rails from the pre-arm bake; without this pin RCCL autodetects verbs and silently rides unproven RDMA — sockets are the transport of record until the attended morning A/B, evidence host/rdma/ab-protocol.md); VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=FN_; VLLM_PLE_MMAP=1; a loud comment forbidding exports of engine defaults read through is-set probes. host/fn-cluster-up.sh: podman on both nodes (worker over ssh on the wire), distributed head on the coordinator and worker join, worker python pool capped small, a hard two-GPU gate before serve, then the serve process at tensor-parallel size 2 with eager execution, model directory /var/lib/local-models/flashnext-fp8, served name flashnext; reap stranded serve processes before start and gate on zero residue. host/fn-cluster-down.sh: idempotent teardown both nodes. host/fn-preflight.sh: byte-diff of both ranks' FN_ env, latency-hold device read on both ends, per-rail link-speed record, round-trip probe on both rails. host/systemd/flashnext-pair.service: oneshot, RemainAfterExit, ExecStopPost teardown, no install section. scripts/run-tp2.sh: preflight, up, two greedy 300-token completions byte-compared, residency read after 50 warmed decode tokens (GTT per rank from sysfs plus process RSS plus table page-cache residency), fidelity capture (fixed-prompt losses and frontier logits under results/), then a 262144-context probe, writing receipts tp2.json, residency.json, fidelity.json, context.json per the receipts-verify.py schema. Extend tests/test_repo_invariants.py-adjacent coverage with tests/test_host_tooling.py asserting the env file carries the doctrine lines and unit files carry ExecStopPost and no WantedBy install. Boundaries: touch only host/, scripts/run-tp2.sh, and tests/.","id":"host-tooling","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r4","specs/flashnext/spec.md#r6","specs/flashnext/evidence/ds4-vllm-manifest.md","specs/flashnext/evidence/dotfiles-observed.md"],"styleReferences":["scripts/stage-weights.sh","scripts/run-smoke.sh"]},"revision":"sha256:ab66c582012f053ffa092301faf6a9b042d52ad26c6baa1b6d149083241af99d","title":"Pair-service orchestration: env doctrine, cluster up/down, first-light runner"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -m py_compile bench/fn-stream-client.py && bash -n bench/run-matrix.sh && python3 -m unittest tests.test_bench_client -v"],"description":"Client compiles, separation test passes, matrix script is syntax-clean.","id":"bench-honest-client"}],"conflictDomains":["bench","tests"],"deliveredBehaviors":["A client whose prefill number is a measurement, not a proxy","A matrix whose every number carries its protocol"],"dependencies":[],"goal":"Write bench/fn-stream-client.py and bench/run-matrix.sh per spec claims 6.2 and 6.3 (specs/flashnext/spec.md#r6). The client measures per-request time-to-first-token client-side AND scrapes the server metrics endpoint to separate scheduler queue wait from prompt processing — the reference harness's client published a prefill column that duplicated its first-token column (specs/flashnext/evidence/nix-strix-halo.md section 4.4); ours must not. Emit CSV with explicit column semantics in a header comment, plus a sha256 fingerprint of every completion's token ids. run-matrix.sh: arms interleaved A-B-B-A, three loads per arm, medians reported, depth series 0, 10240, 102400 tokens, speculative decoding on and off arms, results committed under results/ and a bench.json receipt {loads_per_arm, counterbalanced:true, arms, fingerprints}. Add tests/test_bench_client.py: feed the client parser a fixture with known queue and processing times and assert the two columns separate them. Boundaries: touch only bench/ and tests/.","id":"bench-harness","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/evidence/nix-strix-halo.md"],"styleReferences":["scripts/receipts-verify.py"]},"revision":"sha256:3a8882e61c9b2ce9ef7a7904e06778f0284df952e4a68deb4f8e6e1caba1a225","title":"Measurement harness: honest client and counterbalanced matrix"},{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n scripts/make-proxy.sh scripts/run-proxy.sh && grep -q 'results/receipts/proxy.json' scripts/run-proxy.sh"],"description":"Both scripts are syntax-clean and reference the receipt path.","id":"proxy-scripts-clean"}],"conflictDomains":["scripts/make-proxy.sh","scripts/run-proxy.sh","tests"],"deliveredBehaviors":["The admitted kernel path and the ported table path execute on this GPU before any real weight byte is loaded"],"dependencies":[],"goal":"Write scripts/make-proxy.sh and scripts/run-proxy.sh per spec claim 4.1 (specs/flashnext/spec.md#r4). make-proxy.sh runs inside the container and builds a tiny synthetic checkpoint under /var/tmp/flashnext-proxy: the same architecture identifier as the workload, a handful of layers, 8 experts in block-FP8 with weight_block_size 128 by 128, a small lookup table with the shard tensor naming the mmap path expects — reuse the fork's own test scaffolding under tests/models/ inside the fork checkout wherever possible instead of inventing generators. run-proxy.sh serves it single-node from the container with VLLM_PLE_MMAP=1 and eager execution, requests one greedy completion, asserts finite logits via the API, shuts down cleanly, and writes results/receipts/proxy.json. Boundaries: touch only scripts/make-proxy.sh, scripts/run-proxy.sh, and tests/.","id":"proxy-tooling","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r4","specs/flashnext/evidence/ple-54129.md","specs/flashnext/evidence/moe-dispatch.md"],"styleReferences":["scripts/run-smoke.sh"]},"revision":"sha256:e5bea94a618c21673e727d80dc72777cd31604d0c28385bf83f7b349c10d0bfd","title":"Proxy checkpoint builder and single-node first-light runner"},{"acceptanceCriteria":[{"argv":["bash","-euc","grep -q 'Receipt review' docs/MORNING.md && grep -q 'Open items' docs/MORNING.md && grep -q 'Promotion checklist' docs/MORNING.md && grep -q 'Optimization menu' docs/MORNING.md && grep -qi 'blocker' docs/MORNING.md && test -s docs/ANNOUNCE.md"],"description":"The ledger carries its five sections and the announcement draft exists.","id":"ledger-sections"}],"conflictDomains":["docs"],"deliveredBehaviors":["The operator's first ten minutes are a checklist, not archaeology","The community post is ready to publish with the benchmark numbers"],"dependencies":["host-tooling","bench-harness"],"goal":"Write docs/MORNING.md per spec claim 6.4 (specs/flashnext/spec.md#r6): a receipt review table (one row per receipt under results/receipts with status and the bound it was graded against), the open-items list (every UNKNOWN from the spec with its drain state), the promotion checklist (what the operator verifies before any fleet change, per ruling P13), the optimization menu (tuned mixture-kernel config generation for this GPU, graph-capture matrix, jumbo-frame A-B, draft-length sweep, the four-bit expert lane pointers from IMPORTS.md), and a blocker template implementing ruling P16. Also write docs/ANNOUNCE.md: a short community post draft describing the setup (two 128 GB unified-memory desktops, two fast rails, one control wire), what was built overnight, where the evidence lives, and where benchmarks land. Boundaries: touch only docs/.","id":"morning-ledger","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/spec.md#r7","IMPORTS.md"],"styleReferences":["README.md"]},"revision":"sha256:4c0b640cab49ea7ac3b57b4e23f66c726b92fcce08e77d0f8816814181c3ba0a","title":"Render the morning ledger and the announcement draft"},{"acceptanceCriteria":[{"argv":["bash","-euc","git apply --stat handoff/catalog-row.patch >/dev/null && test -s handoff/README.md"],"description":"The patch parses as a git patch and the handoff note exists.","id":"catalog-patch-wellformed"}],"conflictDomains":["handoff"],"deliveredBehaviors":["The morning catalog declaration is one git apply plus one review, not authoring work"],"dependencies":[],"goal":"Write handoff/catalog-row.patch per spec claim 5.2 (specs/flashnext/spec.md#r5): a git format patch against the fleet configuration repository adding the workload checkpoint as a snapshot-layout artifact row assigned to both hosts, following the existing snapshot-layout precedent row in that repository's model library file, with pinned upstream revision and per-file byte counts read from the staged copy under /var/lib/local-models/flashnext-fp8 (or from the library mount when staging has not finished). Add handoff/README.md explaining exactly what the operator applies and verifies in the morning. The patch is prepared, never applied, by this campaign. Boundaries: touch only handoff/.","id":"catalog-handoff","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r5","specs/flashnext/evidence/dotfiles-observed.md"],"styleReferences":["THIRD_PARTY_NOTICES.md"]},"revision":"sha256:3a04f0fc89c3e88303af3a5b38fc8a4bd52f2f81715bfecfc42bdc04ba5c2269","title":"Prepare the fleet catalog patch for the morning operator"},{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n host/rdma/fetch-and-build.sh && grep -q '503c5ae1e72aa9ed91925dafa3d82ee2e992747f' host/rdma/fetch-and-build.sh && grep -q '76ba39b630a70accb72f19388eefe48844b50eb8' host/rdma/fetch-and-build.sh && ! grep -qE '^[[:space:]]*(sudo[[:space:]]+)?(insmod|modprobe)[[:space:]]' host/rdma/fetch-and-build.sh && grep -qi 'physically present' host/rdma/attended-bringup.md && grep -qi 'worker first' host/rdma/attended-bringup.md && grep -qi 'deploy' host/rdma/attended-bringup.md && test -s host/rdma/ab-protocol.md"],"description":"Scripts syntax-clean, pins present, no auto-install, attended language present.","id":"rdma-package-sound"}],"conflictDomains":["host/rdma","tests"],"deliveredBehaviors":["Tomorrow's attended RDMA bring-up is one script plus one checklist plus one adoption gate","No unsigned module can load unattended from anything this repo ships"],"dependencies":[],"goal":"The bootstrap session scoped an operator-attended RDMA bring-up package (spec ruling P7, claim 6.4 — specs/flashnext/spec.md#r6): host/rdma/fetch-and-build.sh (pinned out-of-tree module fetch, kernel-version and secure-boot guards, staged install only), host/rdma/attended-bringup.md (the coordinated-reboot checklist with the port-controller recovery path), host/rdma/ab-protocol.md (the socket-versus-verbs adoption gate). If those files already exist in the tree, verify them against the reference bring-up doctrine in specs/flashnext/evidence/ds4-vllm-manifest.md section 7 plus specs/flashnext/evidence/nix-hardening-addendum.md and fix defects; if absent, author them from those sections' pins. Hard rules: nothing GPL is vendored — the two out-of-tree repositories are fetched at their pinned commits by the script; nothing installs or loads automatically; one rail only; the checklist states plainly that bring-up happens with the operator physically present, starts only after a committed socket-transport benchmark exists under results/, opens with the worker deploy-path repoint off the fast rail, and orders reboots worker first, never both at once. Extend the tests suite so the syntax sweep covers host/rdma and a test asserts the two pin commits appear in fetch-and-build.sh. Boundaries: touch only host/rdma and tests/.","id":"rdma-package","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/evidence/ds4-vllm-manifest.md"],"styleReferences":["scripts/stage-weights.sh"]},"revision":"sha256:b322b54d6da9831c25a2e55569a9a8ce4c293840285b6225b2760d2c20ee9460","title":"Integrate the operator-attended RDMA package under host/rdma"},{"argv":["bash","scripts/stage-weights-both.sh"],"dependencies":[],"id":"cp-weights","kind":"checkpoint","revision":"sha256:991f181013631a76e48098eddf0692acf3c0f4ce661a1ad1b82cd6fcbef45237","runtimeMaxSec":10800,"title":"Checkpoint: stage the workload checkpoint onto both nodes"},{"argv":["bash","container/build.sh"],"dependencies":["container-recipe","instruments"],"id":"cp-build","kind":"checkpoint","revision":"sha256:03219517866e525ca2f438c3896635f19315405ab7ff351108bab2f67b8c46c2","runtimeMaxSec":14400,"title":"Checkpoint: the container engine build"},{"argv":["bash","scripts/run-smoke.sh"],"dependencies":["cp-build"],"id":"cp-smoke","kind":"checkpoint","revision":"sha256:f6d3bc428003f8bb40eb0422b1c3199fd1957b0cf966ff153c17a9b5d5bc4225","runtimeMaxSec":1800,"title":"Checkpoint: in-container smoke — identity, fp8 cast, admission"},{"argv":["bash","-euc","bash scripts/make-proxy.sh && bash scripts/run-proxy.sh"],"dependencies":["cp-smoke","proxy-tooling"],"id":"cp-proxy","kind":"checkpoint","revision":"sha256:6fbf0ea685ac3069755fa819434b3eee4c2f32dd4214e7d218b7f20c5659a0a6","runtimeMaxSec":3600,"title":"Checkpoint: proxy checkpoint first light, single node"},{"argv":["bash","scripts/run-tp2.sh"],"dependencies":["cp-proxy","cp-weights","host-tooling"],"id":"cp-tp2","kind":"checkpoint","revision":"sha256:d196a72e37ff2e8a46157397702992e95af39dbda52bf246dc953d8ffc1bdbb8","runtimeMaxSec":10800,"title":"Checkpoint: pair first light, residency, fidelity, full context"},{"argv":["bash","bench/run-matrix.sh"],"dependencies":["cp-tp2","bench-harness"],"id":"cp-bench","kind":"checkpoint","revision":"sha256:27c5836591232ed454a208322c2edf3d2ef5bfd48b2229cfc7eb8d9347d152eb","runtimeMax