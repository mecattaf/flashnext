oj\", (M, H))\n                            write_linear(f\"{stem}.{e}.up_proj\", (M, H))\n                        else:\n                            write_linear(f\"{stem}.{e}.down_proj\", (H, M))\n                    continue\n                base = name[:-len(\".weight\")]\n                hit = None\n                for vllm_sfx, entries in fused.items():\n                    if base.endswith(vllm_sfx):\n                        hit = (base[:-len(vllm_sfx)], entries)\n                        break\n                if hit:\n                    stem, entries = hit\n                    sids = {sid for _s, sid in entries}\n                    if sids == {\"q\", \"k\", \"v\"}:\n                        rows = {\"q\": NH * HD, \"k\": NKV * HD, \"v\": NKV * HD}\n                    else:  # gate/up and friends split evenly\n                        rows = {sid: shape[0] // len(entries)\n                                for _s, sid in entries}\n                    for hf_sfx, sid in entries:\n                        write_linear(f\"{stem}{hf_sfx}\",\n                                     (rows.get(sid, shape[0] // len(entries)),\n                                      shape[1]))\n                    continue\n                write_linear(name, shape)\n                continue\n            if \"embed_tokens\" in name and len(shape) == 2:\n                tensors[name] = _bf16(torch.randn(*shape, generator=gen) * 0.02)\n                continue\n            if \"norm\" in name and len(shape) == 1:\n                tensors[name] = _bf16(torch.ones(shape[0]))\n                continue\n            if len(shape) >= 1:\n                tensors[name] = _bf16(torch.zeros(shape))\n        save_safetensors(OUT / \"model-00001-of-00001.safetensors\", tensors)\n        MANIFEST[\"files\"].append(\"model-00001-of-00001.safetensors\")\n'''\nopen(p, 'w').write(src[:start] + new + src[end:])\nEOF\nbash -n scripts/make-proxy.sh && echo BASH-OK && awk '/<<.PY.$/{f=1;next} /^PY$/{f=0} f' scripts