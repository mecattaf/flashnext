div = int(tc.get(\"make_ngram_vocab_size_divisible_by\", 1) or 1)\n    split = int(tc.get(\"split_ngram_parts\", 512))\n    total = base // heads if heads > 1 and base % heads == 0 else base\n    padded = math.ceil(total / div) * div if div > 1 else total\n    return {\"base\": base, \"heads\": heads, \"divisible_by\": div,\n            \"split\": split, \"rows_total\": padded,\n            \"rows_per_shard\": math.ceil(padded / split) if split else padded,\n            \"note\": \"rows = base // heads per the 51.2B-param arithmetic; \"\n                    \"shard_size mirror of (org + split - 1) // split; a \"\n                    \"mismatch is caught by the discover_shards validation\"}\n''', \"geometry\")\n\n# ---- 4. curated weights: tc + prefix aware ----------------------------------\nrep('''    (a) linear-attention module tensors are left to the fork's own init —\n    safe only when the ignore-list keeps them unquantized; (b) PLE shards are\n    written for EVERY layer on the family's per-layer PLE signature.\"\"\"\n    H = int(cfg[\"hidden_size\"])\n    HD = int(cfg.get(\"head_dim\", 256))\n    NH = int(cfg.get(\"num_attention_heads\", 16))\n    NKV = int(cfg.get(\"num_key_value_heads\", 2))\n    V = int(cfg[\"vocab_size\"])\n    E, M = EXPERTS, int(cfg.get(\"moe_intermediate_size\", MOE_INTER))\n    S = int(cfg.get(\"shared_expert_intermediate_size\", 0) or 0)\n    quantize_linears = not bool(cfg.get(\"modules_to_not_convert\"))\n    gen = torch.Generator().manual_seed(SEED)\n    tensors = {}\n    emb = torch.randn(V, H, generator=gen) * 0.02\n    tensors[\"model.embed_tokens.weight\"] = _bf16(emb)\n    tensors[\"lm_head.weight\"] = _bf16(emb)  # tied content keeps logits finite\n    tensors[\"model.norm.weight\"] = _bf16(torch.ones(H))''',\n'''    (a) linear-attention and hyperconnection module tensors are left to the\n    fork's own init — safe only when an ignore-list keeps them unquantized;\n    (b) PLE shards are written only for the config's ple_layer_ids.\"\"\"\n    tc = text_cfg(cfg)\n    # Multimodal configs nest weights under model.language_model.\n    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n    H = int(tc[\"hidden_size\"])\n    HD = int(tc.get(\"head_dim\", 256))\n    NH = int(tc.get(\"num_attention_heads\", 16))\n    NKV = int(tc.get(\"num_key_value_heads\", 2))\n    V = int(tc[\"vocab_size\"])\n    E, M = EXPERTS, int(tc.get(\"moe_intermediate_size\", MOE_INTER))\n    S = int(tc.get(\"shared_expert_intermediate_size\", 0) or 0)\n    quantize_linears = not bool(cfg.get(\"quantization_config\", {})\n                                .get(\"modules_to_not_convert\"))\n    gen = torch.Generator().manual_seed(SEED)\n    tensors = {}\n    emb = torch.randn(V, H, generator=gen) * 0.02\n    tensors[f\"{prefix}.embed_tokens.weight\"] = _bf16(emb)\n    tensors[\"lm_head.weight\"] = _bf16(emb)  # tied content keeps logits finite\n    tensors[f\"{prefix}.norm.weight\"] = _bf16(torch.ones(H))''', \"curated head\")\n\nrep('''    for i, lt in enumerate(cfg[\"layer_types\"]):\n        p = f\"model.layers.{i}\"''',\n'''    for i, lt in enumerate(tc[\"layer_types\"]):\n        p = f\"{prefix}.layers.{i}\"''', \"curated loop\")\n\n# ---- 5. write_ple_shards: ple layers only, prefix aware ----------------------\nrep('''    which is finite by construction.\"\"\"\n    rb = ngram_row_bytes(cfg)\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]\n    files = 0\n    scale = _f32(torch.ones(1))\n    main = {}\n    for layer in range(int(cfg[\"num_hidden_layers\"])):\n        for s in range(split):\n            name = (f\"model.layers.{layer}.ple.ple_embedding.\"\n                    f\"ngram_embedding.shard_{s:05d}.weight\")''',\n'''    which is finite by construction.\"\"\"\n    tc = text_cfg(cfg)\n    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n    rb = ngram_row_bytes(cfg)\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]\n    ple_layers = tc.get(\"ple_layer_ids\") or range(int(tc[\"num_hidden_layers\"]))\n    files = 0\n    scale = _f32(torch.ones(1))\n    main = {}\n    for layer in ple_layers:\n        for s in range(split):\n            name = (f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n                    f\"ngram_embedding.shard_{s:05d}.weight\")''', \"ple writer\")\n\nrep('''        main[f\"model.layers.{layer}.ple.ple_embedding.\"\n             f\"ngram_embedding.weight_scale\"] = scale''',\n'''        main[f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n             f\"ngram_embedding.weight_scale\"] = scale''', \"ple scale name\")\n\n# ---- 6. main(): ignore install into quantization_config; tc reads ------------\nrep('''                         and \".mlp.experts.\" not in n and \"scale\" not in n})''',\n'''                         and \".mlp.experts.\" not in n and \"scale\" not in n})\n        ignore.append(\"lm_head\")  # top-level, never quantized''', \"ignore lm_head\")\n\nrep('''    if ignore:\n        cfg[\"modules_to_not_convert\"] = ignore''',\n'''    if ignore:\n        cfg[\"quantization_config\"][\"modules_to_not_convert\"] = ignore''',\n\"ignore install\")\n\nrep('''        MANIFEST[\"weight_source\"] = \"fork-introspection\"\n        gen = torch.Generator().manual_seed(SEED)\n        H = int(cfg[\"hidden_size\"])\n        HD = int(cfg.get(\"head_dim\", 256))\n        NH = int(cfg.get(\"num_attention_heads\", 16))\n        NKV = int(cfg.get(\"num_key_value_heads\", 2))\n        M = int(cfg.get(\"moe_intermediate_size\", MOE_INTER))\n        E = EXPERTS''',\n'''        MANIFEST[\"weight_source\"] = \"fork-introspection\"\n        gen = torch.Generator().manual_seed(SEED)\n        tc = text_cfg(cfg)\n        H = int(tc[\"hidden_size\"])\n        HD = int(tc.get(\"head_dim\", 256))\n        NH = int(tc.get(\"num_attention_heads\", 16))\n        NKV = int(tc.get(\"num_key_value_heads\", 2))\n        M = int(tc.get(\"moe_intermediate_size\", MOE_INTER))\n        E = EXPERTS''', \"introspection tc reads\")\n\nrep('''    manifest_path = OUT / \"proxy-manifest.json\"''',\n'''    MANIFEST[\"geometry\"][\"ple_layers\"] = list(\n        text_cfg(cfg).get(\"ple_layer_ids\", range(LAYERS)))\n    manifest_path = OUT / \"proxy-manifest.json\"''', \"manifest ple layers\")\n\nopen(p, 'w').write(src)\nprint(\"ALL EDITS APPLIED\")\n","path":"/tmp/rewrite.py"}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":1660,"output":3853,"cacheRead":164736,"cacheWrite":0,"reasoning":115,"totalTokens":170249,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787994542980,"responseId":"chatcmpl-606764dc-e906-483e-b387-3d61de0d5104","rawStopReason":"tool_calls"}}
{"type":"tool_execution_start","toolCallId":"call_ab68270c50a64a49b7ee33f6","toolName":"write","args":{"content":"import sys\np = '/home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/make-proxy.sh'\nsrc = open(p).read()\n\ndef rep(old, new, label):\n    global src\n    if old not in src:\n        sys.exit(f\"MISSING: {label}\")\n    if src.count(old) != 1:\n        sys.exit(f\"NOT UNIQUE: {label}\")\n    src = src.replace(old, new)\n    print(\"ok:\", label)\n\n# ---- 1. shrink(): text_config-aware, quant merge, ple_layer_ids ------------\nstart = src.index('def shrink(cfg):')\nend = src.index('# ---------------------------------------------------------------------------\\n# Stage 2')\nnew_shrink = '''def shrink(cfg):\n    # Multimodal workload configs nest the language model under text_config;\n    # the template config is flat. Edit whichever level carries the fields.\n    tc = cfg.get(\"text_config\", cfg)\n    edits = {}\n\n    def set_(key, val):\n        edits[key] = [tc.get(key), val]\n        tc[key] = val\n\n    archs = cfg.get(\"architectures\") or []\n    if not any(\"Qwen4Exp\" in a for a in archs):\n        die(f\"base config architectures {archs} carry no Qwen4Exp identifier; \"\n            \"refusing to relabel a foreign model as the proxy\")\n    if \"language_model_only\" in cfg:\n        edits[\"language_model_only\"] = [cfg[\"language_model_only\"], True]\n        cfg[\"language_model_only\"] = True  # the proxy has no vision bytes\n    set_(\"num_hidden_layers\", LAYERS)\n    interval = int(tc.get(\"full_attention_interval\", 4))\n    pattern = [\"linear_attention\"] * max(1, interval - 1) + [\"full_attention\"]\n    set_(\"layer_types\", [pattern[i % len(pattern)] for i in range(LAYERS)])\n    set_(\"num_experts\", EXPERTS)\n    set_(\"num_experts_per_tok\",\n         min(int(tc.get(\"num_experts_per_tok\", TOPK)), EXPERTS))\n    # Every layer routed-MoE, so the admitted block-FP8 kernel runs on every\n    # decode step of the proxy serve.\n    set_(\"decoder_sparse_step\", 1)\n    set_(\"moe_intermediate_size\", MOE_INTER)\n    if \"shared_expert_intermediate_size\" in tc:\n        set_(\"shared_expert_intermediate_size\", MOE_INTER)\n    if \"intermediate_size\" in tc:\n        set_(\"intermediate_size\", 2 * BLOCK)\n    set_(\"max_position_embeddings\",\n         min(int(tc.get(\"max_position_embeddings\", 4096)), 4096))\n    if not (MODELS / \"config.json\").is_file():\n        set_(\"vocab_size\", 4096)  # template tokenizer is paired with 4096\n    # PLE layers survive the layer shrink; the mmap claim needs at least one.\n    ple_ids = [i for i in tc.get(\"ple_layer_ids\", range(LAYERS))\n               if i < LAYERS]\n    if not ple_ids:\n        ple_ids = [LAYERS - 1]\n    set_(\"ple_layer_ids\", ple_ids)\n    # Block-FP8 quantization: MERGE with the workload's quantization_config —\n    # activation_scheme and friends are required by the fork's Fp8Config (a\n    # wholesale replacement fails VllmConfig validation) — and drop the\n    # workload's 943-entry ignore list: it names modules by layer index and\n    # cannot survive the shrink; the builder reinstalls its own below.\n    qc = dict(cfg.get(\"quantization_config\") or {})\n    qc.update({\"quant_method\": \"fp8\", \"weight_block_size\": [BLOCK, BLOCK]})\n    qc.setdefault(\"activation_scheme\", \"dynamic\")\n    qc.pop(\"modules_to_not_convert\", None)\n    edits[\"quantization_config\"] = \"merged; modules_to_not_convert dropped\"\n    cfg[\"quantization_config\"] = qc\n    # Small PLE table: shrink every large ngram-size field; keep heads/dims.\n    for key in list(tc):\n        if \"ngram\" in key.lower() and re.search(r\"(size|base|vocab)\",\n                                                key.lower()):\n            val = tc[key]\n            if isinstance(val, int) and val > 512:\n                set_(key, 512)\n    split_key = next((k for k in tc\n                      if \"split\" in k.lower() and \"ngram\" in k.lower()), None)\n    if split_key is not None:\n        set_(split_key, 2)\n    return edits\n\n\n'''\nsrc = src[:start] + new_shrink + src[end:]\nprint(\"ok: shrink replaced\")\n\n# ---- 2. template: ple_layer_ids ---------------------------------------------\nrep('''        \"split_ngram_parts\": 2,\n    }''', '''        \"split_ngram_parts\": 2,\n        \"ple_layer_ids\": [2],\n    }''', \"template ple_layer_ids\")\n\n# ---- 3. geometry block -------------------------------------------------------\nrep('''def ngram_row_bytes(cfg):\n    \"\"\"Row width of the mmap table. The PLE layer builds its embedding at\n    (padded_vocab_size, self.head_dim) per specs/flashnext/evidence/\n    ple-54129.md section 3; the PLE head_dim is heads_per_ngram x\n    ple_embed_dim when both geometry fields are present, and the attention\n    head_dim is the fallback.\"\"\"\n    heads = cfg.get(\"heads_per_ngram\")\n    dim = cfg.get(\"ple_embed_dim\")\n    if isinstance(heads, int) and isinstance(dim, int):\n        return heads * dim\n    return int(cfg.get(\"head_dim\", 256))\n\n\ndef ngram_geometry(cfg):\n    \"\"\"Mirror the loader's shard mapping (specs/flashnext/evidence/\n    ple-54129.md section 3): shard_size = ceil(org / split); the checkpoint\n    carries ceil(org / shard_size) row-block tensors per PLE layer.\"\"\"\n    base = int(cfg.get(\"ngram_vocab_size_base\", 512))\n    heads = int(cfg.get(\"heads_per_ngram\", 1))\n    div = int(cfg.get(\"make_ngram_vocab_size_divisible_by\", 1) or 1)\n    split = int(cfg.get(\"split_ngram_parts\", 512))\n    total = base * heads\n    padded = math.ceil(total / div) * div if div > 1 else total\n    return {\"base\": base, \"heads\": heads, \"divisible_by\": div,\n            \"split\": split, \"padded_rows\": padded,\n            \"rows_per_shard\": math.ceil(padded / split) if split else padded,\n            \"note\": \"mirror of (org + split - 1) // split; a mismatch is \"\n                    \"caught by the discover_shards validation below\"}\n''', '''def text_cfg(cfg):\n    \"\"\"Multimodal workload configs nest the language model under text_config;\n    the template config is flat.\"\"\"\n    return cfg.get(\"text_config\", cfg)\n\n\ndef ngram_row_bytes(cfg):\n    \"\"\"Row width of the mmap table, in fp8 elements. The PLE layer builds its\n    embedding at (padded_vocab_size, self.head_dim); the workload arithmetic\n    (specs/flashnext/spec.md \"engram table\": 51.2 B params = 2.5 M rows x\n    20480 B) shows head_dim = heads_per_ngram x ple_embed_dim there.\"\"\"\n    tc = text_cfg(cfg)\n    heads = tc.get(\"heads_per_ngram\")\n    dim = tc.get(\"ple_embed_dim\")\n    if isinstance(heads, int) and isinstance(dim, int):\n        return heads * dim\n    return int(tc.get(\"head_dim\", 256))\n\n\ndef ngram_geometry(cfg):\n    \"\"\"Mirror the loader's shard mapping (specs/flashnext/evidence/\n    ple-54129.md section 3): shard_size = ceil(org / split); the checkpoint\n    carries ceil(org / shard_size) row-block tensors per PLE layer. The row\n    count arithmetic is pinned to the workload's 51.2 B-parameter table:\n    rows = ngram_vocab_size_base // heads_per_ngram, then padded to\n    make_ngram_vocab_size_divisible_by.\"\"\"\n    tc = text_cfg(cfg)\n    base = int(tc.get(\"ngram_vocab_size_base\", 512))\n    heads = int(tc.get(\"heads_per_ngram\", 1))\n    div = int(tc.get(\"make_ngram_vocab_size_divisible_by\", 1) or 1)\n    split = int(tc.get(\"split_ngram_parts\", 512))\n    total = base // heads if heads > 1 and base % heads == 0 else base\n    padded = math.ceil(total / div) * div if div > 1 else total\n    return {\"base\": base, \"heads\": heads, \"divisible_by\": div,\n            \"split\": split, \"rows_total\": padded,\n            \"rows_per_shard\": math.ceil(padded / split) if split else padded,\n            \"note\": \"rows = base // heads per the 51.2B-param arithmetic; \"\n                    \"shard_size mirror of (org + split - 1) // split; a \"\n                    \"mismatch is caught by the discover_shards validation\"}\n''', \"geometry\")\n\n# ---- 4. curated weights: tc + prefix aware ----------------------------------\nrep('''    (a) linear-attention module tensors are left to the fork's own init —\n    safe only when the ignore-list keeps them unquantized; (b) PLE shards are\n    written for EVERY layer on the family's per-layer PLE signature.\"\"\"\n    H = int(cfg[\"hidden_size\"])\n    HD = int(cfg.get(\"head_dim\", 256))\n    NH = int(cfg.get(\"num_attention_heads\", 16))\n    NKV = int(cfg.get(\"num_key_value_heads\", 2))\n    V = int(cfg[\"vocab_size\"])\n    E, M = EXPERTS, int(cfg.get(\"moe_intermediate_size\", MOE_INTER))\n    S = int(cfg.get(\"shared_expert_intermediate_size\", 0) or 0)\n    quantize_linears = not bool(cfg.get(\"modules_to_not_convert\"))\n    gen = torch.Generator().manual_seed(SEED)\n    tensors = {}\n    emb = torch.randn(V, H, generator=gen) * 0.02\n    tensors[\"model.embed_tokens.weight\"] = _bf16(emb)\n    tensors[\"lm_head.weight\"] = _bf16(emb)  # tied content keeps logits finite\n    tensors[\"model.norm.weight\"] = _bf16(torch.ones(H))''',\n'''    (a) linear-attention and hyperconnection module tensors are left to the\n    fork's own init — safe only when an ignore-list keeps them unquantized;\n    (b) PLE shards are written only for the config's ple_layer_ids.\"\"\"\n    tc = text_cfg(cfg)\n    # Multimodal configs nest weights under model.language_model.\n    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n    H = int(tc[\"hidden_size\"])\n    HD = int(tc.get(\"head_dim\", 256))\n    NH = int(tc.get(\"num_attention_heads\", 16))\n    NKV = int(tc.get(\"num_key_value_heads\", 2))\n    V = int(tc[\"vocab_size\"])\n    E, M = EXPERTS, int(tc.get(\"moe_intermediate_size\", MOE_INTER))\n    S = int(tc.get(\"shared_expert_intermediate_size\", 0) or 0)\n    quantize_linears = not bool(cfg.get(\"quantization_config\", {})\n                                .get(\"modules_to_not_convert\"))\n    gen = torch.Generator().manual_seed(SEED)\n    tensors = {}\n    emb = torch.randn(V, H, generator=gen) * 0.02\n    tensors[f\"{prefix}.embed_tokens.weight\"] = _bf16(emb)\n    tensors[\"lm_head.weight\"] = _bf16(emb)  # tied content keeps logits finite\n    tensors[f\"{prefix}.norm.weight\"] = _bf16(torch.ones(H))''', \"curated head\")\n\nrep('''    for i, lt in enumerate(cfg[\"layer_types\"]):\n        p = f\"model.layers.{i}\"''',\n'''    for i, lt in enumerate(tc[\"layer_types\"]):\n        p = f\"{prefix}.layers.{i}\"''', \"curated loop\")\n\n# ---- 5. write_ple_shards: ple layers only, prefix aware ----------------------\nrep('''    which is finite by construction.\"\"\"\n    rb = ngram_row_bytes(cfg)\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]\n    files = 0\n    scale = _f32(torch.ones(1))\n    main = {}\n    for layer in range(int(cfg[\"num_hidden_layers\"])):\n        for s in range(split):\n            name = (f\"model.layers.{layer}.ple.ple_embedding.\"\n                    f\"ngram_embedding.shard_{s:05d}.weight\")''',\n'''    which is finite by construction.\"\"\"\n    tc = text_cfg(cfg)\n    prefix = \"model.language_model\" if \"text_config\" in cfg else \"model\"\n    rb = ngram_row_bytes(cfg)\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]\n    ple_layers = tc.get(\"ple_layer_ids\") or range(int(tc[\"num_hidden_layers\"]))\n    files = 0\n    scale = _f32(torch.ones(1))\n    main = {}\n    for layer in ple_layers:\n        for s in range(split):\n            name = (f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n                    f\"ngram_embedding.shard_{s:05d}.weight\")''', \"ple writer\")\n\nrep('''        main[f\"model.layers.{layer}.ple.ple_embedding.\"\n             f\"ngram_embedding.weight_scale\"] = scale''',\n'''        main[f\"{prefix}.layers.{layer}.ple.ple_embedding.\"\n             f\"ngram_embedding.weight_scale\"] = scale''', \"ple scale name\