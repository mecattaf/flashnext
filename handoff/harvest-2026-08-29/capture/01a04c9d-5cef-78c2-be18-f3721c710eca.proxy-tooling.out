"modules_to_not_convert\"))\nprint(\"layer_types head\", cfg[\"layer_types\"][:5], \"... len\", len(cfg[\"layer_types\"]))\nm = json.load(open('out2/proxy-manifest.json'))\nprint(\"base:\", m[\"base_config_source\"], \"| tokenizer:\", m[\"tokenizer_source\"])\nprint(\"ngram geom:\", m[\"geometry\"][\"ngram\"])\nimport glob\nprint(\"files:\", len(glob.glob('out2/*.safetensors')))\nEOF"}}}}
