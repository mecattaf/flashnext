\\n# default the engine reads through an is-set probe (the VLLM_USE_DEEP_GEMM /\\n# VLLM_ROCM_USE_AITER family stays UNSET). VLLM_PLE_MMAP itself is a plain\\n# bool(int(getenv)) read, so pinning it here is safe and is the claim.\\n#\\n# Every failure writes a fail receipt (graded, never silently skipped — spec\\n# F.12) and exits non-zero.\\nset -euo pipefail\\n\\nREPO_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\\nIMAGE=\"${FN_IMAGE:-flashnext:dev}\"\\nPROXY_DIR=\"${FN_PROXY_DIR:-${FN_STATE_DIR:-$HOME/.local/state/flashnext}/proxy-checkpoint}\"\\nPORT=\"${FN_PROXY_PORT:-1235}\"\\nCTR=\"flashnext-proxy-serve\"\\nOUT=\"$REPO_ROOT/results/receipts/proxy.json\"\\n\\nlog() { echo \"run-proxy: $*\" >&2; }\\n\\nmkdir -p \"$REPO_ROOT/results/receipts\"\\n\\n# The receipt writer: one JSON object {\"step\",\"status\",\"ts\",\"data\"}, driven\\n# by env so the bash trap can use it too. Never overwrites an existing,\\n# parseable receipt (a later fail must not clobber the detail an earlier\\n# stage recorded).\\nwrite_receipt() {  # $1=status  $2=data-json\\n    FN_STATUS=\"$1\" FN_DATA=\"$2\" FN_OUT=\"$OUT\" python3 - <<\\'PY\\'\\nimport json, os, sys, time\\nout = os.environ[\"FN_OUT\"]\\ntry:\\n    existing = json.load(open(out))\\n    if isinstance(existing, dict) and existing.get(\"step\") == \"proxy\":\\n        print(f\"run-proxy: receipt already written ({existing.get(\\'status\\')}); keeping it\",\\n              file=sys.stderr)\\n        sys.exit(0)\\nexcept Exception:\\n    pass\\ntry:\\n    data = json.loads(os.environ[\"FN_DATA\"])\\nexcept Exception as e:\\n    data = {\"error\": f\"unparseable data payload: {e}\"}\\njson.dump({\"step\": \"proxy\", \"status\": os.environ[\"FN_STATUS\"],\\n           \"ts\": time.strftime(\"%FT%T\"), \"data\": data},\\n          open(out, \"w\"), indent=1)\\nprint(f\"run-proxy: proxy receipt ({os.environ[\\'FN_STATUS\\']}): {out}\",\\n      file=sys.stderr)\\nPY\\n}\\n\\ncleanup_container() {\\n    podman rm -f \"$CTR\" >/dev/null 2>&1 || true\\n}\\n\\non_error() {\\n    local line=\"$1\"\\n    log \"FAILED at line $line — recording a fail receipt and cleaning up\"\\n    local tailtxt=\"\"\\n    tailtxt=\"$(podman logs --tail 40 \"$CTR\" 2>&1 || true)\"\\n    FN_TAIL=\"$tailtxt\" FN_LINE=\"$line\" write_receipt \"fail\" \\\\\\n        \"$(python3 -c \\'import json,os; print(json.dumps({\"aborted_at_line\": int(os.environ[\"FN_LINE\"]), \"serve_log_tail\": os.environ[\"FN_TAIL\"].splitlines()[-40:]}))\\')\"\\n    cleanup_container\\n    exit 1\\n}\\ntrap \\'on_error $LINENO\\' ERR\\n\\n# --- 0. the checkpoint gate ----------------------------------------------------\\nif [ ! -f \"$PROXY_DIR/config.json\" ]; then\\n    write_receipt \"fail\" \"{\\\\\"error\\\\\": \\\\\"no proxy checkpoint at $PROXY_DIR (config.json missing)\\\\\", \\\\\"typed_blocker\\\\\": \\\\\"run scripts/make-proxy.sh first\\\\\"}\"\\n    log \"FATAL: no proxy checkpoint at $PROXY_DIR — run scripts/make-proxy.sh first\"\\n    exit 1\\nfi\\nif ! podman image exists \"$IMAGE\" 2>/dev/null; then\\n    write_receipt \"fail\" \"{\\\\\"error\\\\\": \\\\\"image $IMAGE not found\\\\\", \\\\\"typed_blocker\\\\\": \\\\\"run container/build.sh first\\\\\"}\"\\n    log \"FATAL: image $IMAGE not found — run container/build.sh first\"\\n    exit 1\\nfi\\n\\ncleanup_container\\nBUILD_INFO=\"$(podman run --rm --entrypoint cat \"$IMAGE\" /opt/flashnext/build-info.json 2>/dev/null || echo \\'{}\\')\"\\nlog \"engine identity: $(echo \"$BUILD_INFO\" | python3 -c \\'import json,sys\\ntry:\\n    b = json.load(sys.stdin); print(b.get(\"fork_commit\", \"unknown\"))\\nexcept Exception: print(\"unknown\")\\')\"\\n\\n# --- 1. the serve: single node, mmap path engaged, piecewise per ruling P10 ----\\n# Do not add comments inside the backslash-continued `vllm serve` command\\n# below: a \\'#\\' there silently comments out every remaining argument.\\nlog \"serving $PROXY_DIR as \\'flashnext-proxy\\' on 127.0.0.1:$PORT (VLLM_PLE_MMAP=1, piecewise)\"\\npodman run -d --name \"$CTR\" \\\\\\n    --network host --ipc host \\\\\\n    --device /dev/kfd --device /dev/dri \\\\\\n    --security-opt seccomp=unconfined \\\\\\n    --group-add keep-groups --ulimit memlock=-1:-1 \\\\\\n    -v \"$PROXY_DIR:/var/tmp/flashnext-proxy:ro\" \\\\\\n    -e VLLM_PLE_MMAP=1 \\\\\\n    -e HF_HUB_OFFLINE=1 \\\\\\n    -e VLLM_NO_USAGE_STATS=1 \\\\\\n    -e VLLM_DO_NOT_TRACK=1 \\\\\\n    -e PYTHONHASHSEED=0 \\\\\\n    -e HSA_ENABLE_INTERRUPT=1 \\\\\\n    -e PYTORCH_HIP_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.85\" \\\\\\n    \"$IMAGE\" bash -lc \"exec vllm serve /var/tmp/flashnext-proxy \\\\\\n        --served-model-name flashnext-proxy \\\\\\n        --host 127.0.0.1 \\\\\\n        --port $PORT \\\\\\n        --tensor-parallel-size 1 \\\\\\n        --max-model-len 4096 \\\\\\n        --gpu-memory-utilization 0.6 \\\\\\n        --disable-log-requests \\\\\\n        -cc.cudagraph_mode=PIECEWISE\"\\n\\n# --- 2. wait, complete, assert, shut down, receipt -----------------------------\\nexport FN_API=\"http://127.0.0.1:$PORT\"\\nexport FN_CTR=\"$CTR\"\\nexport FN_OUT=\"$OUT\"\\nexport FN_BOOT_TIMEOUT=\"${FN_PROXY_BOOT_TIMEOUT:-3600}\"\\nexport FN_BUILD_INFO=\"$BUILD_INFO\"\\nexport FN_PROXY_DIR=\"$PROXY_DIR\"\\nexport FN_IMAGE=\"$IMAGE\"\\n\\npython3 - <<\\'PY\\'\\nimport json, math, os, subprocess, sys, time, urllib.error, urllib.request\\n\\nAPI = os.environ[\"FN_API\"]\\nCTR = os.environ[\"FN_CTR\"]\\nMODEL = \"flashnext-proxy\"\\nBOOT_TIMEOUT = int(os.environ[\"FN_BOOT_TIMEOUT\"])\\n\\ndef podman(*args, timeout=600):\\n    return subprocess.run([\"podman\", *args], capture_output=True, text=True,\\n                          timeout=timeout)\\n\\ndef container_running():\\n    p = podman(\"inspect\", \"-f\", \"{{.State.Running}}\", CTR, timeout=30)\\n    return p.returncode == 0 and p.stdout.strip() == \"true\"\\n\\ndef serve_log_tail(n=60):\\n    p = podman(\"logs\", \"--tail\", str(n), CTR, timeout=60)\\n    return (p.stdout + p.stderr).splitlines()\\n\\ndef get(path, timeout=10):\\n    with urllib.request.urlopen(API + path, timeout=timeout) as r:\\n        return json.loads(r.read())\\n\\ndef post(path, body, timeout=3600):\\n    req = urllib.request.Request(API + path, data=json.dumps(body).encode(),\\n                                 headers={\"Content-Type\": \"application/json\"})\\n    with urllib.request.urlopen(req, timeout=timeout) as r:\\n        return json.loads(r.read())\\n\\nstatus = \"pass\"\\ndata = {\\n    \"checkpoint\": \"/var/tmp/flashnext-proxy\",\\n    \"serve\": {\"mode\": \"single-node\", \"vllm_ple_mmap\": 1,\\n              \"cudagraph_mode\": \"PIECEWISE\", \"port\": API.rsplit(\":\", 1)[-1],\\n              \"served_model_name\": MODEL},\\n    \"mmap_engaged\": False, \"finite_logits\": False,\\n    \"shutdown\": {\"clean\": False, \"exit_code\": None},\\n}\\n\\n# Engine identity and the builder\\'s manifest ride with the claim.\\ntry:\\n    data[\"engine\"] = json.loads(os.environ[\"FN_BUILD_INFO\"])\\nexcept Exception:\\n    data[\"engine\"] = {}\\ntry:\\n    data[\"checkpoint_manifest\"] = json.load(\\n        open(os.path.join(os.environ[\"FN_PROXY_DIR\"], \"proxy-manifest.json\")))\\nexcept Exception as e:\\n    data[\"checkpoint_manifest\"] = f\"unreadable: {e}\"\\n\\n# --- wait for the API (cold triton compile makes this the long pole) --------\\ndeadline = time.time() + BOOT_TIMEOUT\\nstarted = time.time()\\nready = False\\nwhile time.time() < deadline:\\n    if not container_running():\\n        status = \"fail\"\\n        data[\"error\"] = \"serve container died during boot\"\\n        data[\"serve_log_tail\"] = serve_log_tail()\\n        break\\n    try:\\n        models = [m[\"id\"] for m in get(\"/v1/models\").get(\"data\", [])]\\n        if MODEL in models:\\n            ready = True\\n            break\\n    except Exception:\\n        pass\\n    time.sleep(5)\\ndata[\"serve\"][\"boot_seconds\"] = round(time.time() - started, 1)\\nif not ready and status == \"pass\":\\n    status = \"fail\"\\n    data[\"error\"] = f\"API never answered inside {BOOT_TIMEOUT}s\"\\n    data[\"serve_log_tail\"] = serve_log_tail()\\n\\n# --- one greedy completion, finite logits asserted via the API --------------\\nif ready:\\n    prompt = \"First light on the proxy checkpoint proves \"\\n    try:\\n        r = post(\"/v1/completions\",\\n                 {\"model\": MODEL, \"prompt\": prompt, \"max_tokens\": 16,\\n                  \"temperature\": 0, \"logprobs\": 5})\\n        choice = r[\"choices\"][0]\\n        data[\"completion\"] = {\\n            \"prompt\": prompt,\\n            \"text\": choice[\"text\"],\\n            \"finish_reason\": choice.get(\"finish_reason\"),\\n            \"tokens\": r.get(\"usage\", {}).get(\"completion_tokens\"),\\n        }\\n        # The API-visible face of the logits: every returned logprob value.\\n        values = []\\n        lp = choice.get(\"logprobs\") or {}\\n        for x in lp.get(\"token_logprobs\") or []:\\n            if x is not None:\\n                values.append(float(x))\\n        for top in lp.get(\"top_logprobs\") or []:\\n            for v in (top or {}).values():\\n                if v is not None:\\n                    values.append(float(v))\\n        data[\"logprobs_checked\"] = len(values)\\n        data[\"finite_logits\"] = bool(values) and all(math.isfinite(v)\\n                                                     for v in values)\\n        if not data[\"finite_logits\"]:\\n            status = \"fail\"\\n            data[\"error\"] = data.get(\\n                \"error\", \"no finite logprob values returned — logits not proven finite\")\\n    except Exception as e:\\n        status = \"fail\"\\n        data[\"error\"] = f\"completion failed: {e.__class__.__name__}: {e}\"\\n        data[\"serve_log_tail\"] = serve_log_tail()\\n\\n# --- mmap engagement: the claim is \\'with the mmap path engaged\\' --------------\\nlogtext = \"\\\\n\".join(serve_log_tail(20000)).lower()\\nmentions = logtext.count(\"ple_mmap\")\\ndata[\"mmap\"] = {\"log_mentions\": mentions,\\n                \"engaged\": mentions > 0}\\ndata[\"mmap_engaged\"] = mentions > 0\\nif ready and mentions == 0:\\n    status = \"fail\"\\n    data[\"error\"] = data.get(\\n        \"error\", \"\") + \" | VLLM_PLE_MMAP never shows in the serve log — the table path did not engage\"\\n\\n# --- clean shutdown: SIGTERM, graceful exit code, container removed -----------\\nstop = podman(\"stop\", \"-t\", \"120\", CTR, timeout=240)\\ninsp = podman(\"inspect\", \"-f\", \"{{.State.ExitCode}}\", CTR, timeout=30)\\ntry:\\n    code = int(insp.stdout.strip())\\nexcept Exception:\\n    code = None\\ndata[\"shutdown\"] = {\"clean\": stop.returncode == 0 and code == 0,\\n                    \"exit_code\": code}\\nif not data[\"shutdown\"][\"clean\"]:\\n    status = \"fail\"\\n    data[\"error\"] = data.get(\"error\", \"\") + \\\\\\n        f\" | unclean shutdown (stop rc={stop.returncode}, exit={code})\"\\npodman(\"rm\", \"-f\", CTR)\\n\\n# --- the receipt: results/receipts/proxy.json --------------------------------\\nreceipt = {\"step\": \"proxy\", \"status\": status,\\n           \"ts\": time.strftime(\"%FT%T\"), \"data\": data}\\nwith open(os.environ[\"FN_OUT\"], \"w\") as f:\\n    json.dump(receipt, f, indent=1)\\nprint(f\"run-proxy: proxy receipt ({status}): {os.environ[\\'FN_OUT\\']}\",\\n      file=sys.stderr)\\nsys.exit(0 if status == \"pass\" else 1)\\nPY\\n# A non-zero exit above means the step failed; the ERR trap has recorded the\\n# fail receipt (or kept the one the python stage wrote) and cleaned up.\\ncleanup_container\\nlog \"receipt: $OUT\"\\n' : is-set probe VLLM_USE_DEEP_GEMM in run-proxy.sh\n\ntests/test_proxy_tooling.py:69: AssertionError\n=========================== short test summary info ============================\nFAILED tests/test_proxy_tooling.py::ProxyTooling::test_no_is_set_probe_exports\n1 failed, 46 passed in 0.18s\n"}]},"isError":false}
