odel_parallel(1, 1)\n            except Exception as e:\n                note(f\"distributed bootstrap for introspection: {e!r}\")\n            cls = ModelRegistry.resolve_model_cls(mc.architectures, mc)[0]'''\nassert src.count(old) == 1\nopen(p, 'w').write(src.replace(old, new))\nprint(\"ok\")\nEOF\nbash -n scripts/make-proxy.sh && time bash scripts/make-proxy.sh 2>&1 | tail -12","timeout":1200}}}}
