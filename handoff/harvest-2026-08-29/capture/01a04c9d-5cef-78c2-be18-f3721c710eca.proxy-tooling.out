{"type":"tool_execution_end","toolCallId":"call_b3a51ca902ca434fa32640be","toolName":"read","result":{"content":[{"type":"text","text":"# flashnext:dev — the engine fork built from source at the exactly pinned wheel set\n# ============================================================================\n#\n# Recipe shape adapted from kyuz0/amd-strix-halo-vllm-toolboxes,\n# `Dockerfile.ubuntu-repoamd` @ 23cb726, credited per THIRD_PARTY_NOTICES.md.\n# That recipe is MIT licensed; the notice is retained here as required:\n#\n#   MIT License — Copyright (c) kyuz0 (amd-strix-halo-vllm-toolboxes)\n#\n#   Permission is hereby granted, free of charge, to any person obtaining a\n#   copy of this software and associated documentation files (the \"Software\"),\n#   to deal in the Software without restriction, including without limitation\n#   the rights to use, copy, modify, merge, publish, distribute, sublicense,\n#   and/or sell copies of the Software, and to permit persons to whom the\n#   Software is furnished to do so, subject to the following conditions:\n#\n#   The above copyright notice and this permission notice shall be included in\n#   all copies or substantial portions of the Software.\n#\n#   THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n#   DEALINGS IN THE SOFTWARE.\n#\n# What changed vs the donor recipe (per IMPORTS.md sections 1 and 2):\n#   - torch is pinned to the fork's exact pin 2.13.0+rocm7.14.0 from the AMD\n#     stable multi-arch index (the index tops out there; no ROCm 10 wheels\n#     exist for gfx1151 — specs/flashnext/evidence/kyuz0-rocm10.md).\n#   - torchaudio is OMITTED; we drop the audio extra rather than downgrade\n#     torch to 2.11 (torchaudio capped kyuz0's auto-resolved set there).\n#   - the engine is the flashnext fork (mecattaf/vllm, branch flashnext),\n#     built from source for gfx1151, not a stock vLLM ref.\n#   - designed for overnight iteration: bind-mount a fork checkout over\n#     /opt/vllm and a host dir over /root/.ccache (see container/build.sh);\n#     the editable install then recompiles only what a one-line patch touched.\n#\n# Wheel provenance: the torch/triton/vision/rocm-sdk substrate comes ONLY\n# from the vendor stable index (spec F.11). Generic Python build tooling\n# (setuptools, wheel, packaging, setuptools-scm) and vLLM's upstream runtime\n# dependencies resolve from PyPI as upstream vLLM does; none of those is part\n# of the pinned substrate.\n\nFROM docker.io/ubuntu:24.04\n\nARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n# The exactly pinned wheel set (IMPORTS.md section 1). The triton pin is the\n# wheel accompanying the torch 2.13.0 set on the vendor stable index —\n# verified by pip's own resolver: torch 2.13.0+rocm7.14.0 depends on exactly\n# triton==3.8.0+git4cff872c.rocm7.14.0 (anything else is ResolutionImpossible).\n# < 3.8 awareness (IMPORTS.md): the fork's fp8-upcast gate keys on triton < 3.8,\n# so on this wheel the admission stands but the in-kernel upcast is bypassed —\n# fp8 dots ride triton 3.8's own lowering, and the fidelity checkpoint grades it.\nARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\nARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\nARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n# The from-source engine build needs the HIP compiler + cmake packages, which\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\nARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n# images ship as separate device packages (torch loads them from torch/.kpack/).\n# Without these the first kernel launch dies with hipErrorInvalidImage.\nARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n\nENV DEBIAN_FRONTEND=noninteractive\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n        python3.12 python3.12-venv python3.12-dev \\\n        git ca-certificates curl \\\n        build-essential cmake ninja-build ccache \\\n        cargo rustc libnuma-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Python 3.12 venv at /opt/venv (pip arrives via ensurepip — no external fetch).\nRUN python3.12 -m venv /opt/venv\nENV VIRTUAL_ENV=/opt/venv \\\n    PATH=/opt/venv/bin:$PATH \\\n    PIP_NO_CACHE_DIR=0 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    CCACHE_DIR=/root/.ccache \\\n    HOME=/root\n\n# Python build tooling (setuptools is served by the vendor index itself; the\n# rest is generic build-time tooling, not substrate).\nRUN pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \\\n        setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n\n# ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\nRUN pip install --index-url ${ROCM_WHL} \\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n\n# ---- the engine fork, built from source for gfx1151 ----\nARG VLLM_REPO=https://github.com/mecattaf/vllm\nARG VLLM_BRANCH=flashnext\nENV VLLM_TARGET_DEVICE=rocm \\\n    PYTORCH_ROCM_ARCH=gfx1151\n\n# If a host fork checkout is bind-mounted over /opt/vllm (build.sh -v), keep\n# it — that is the incremental-iteration path. Otherwise clone the baseline.\nRUN if [ ! -d /opt/vllm/.git ]; then \\\n        git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm /opt/vllm; \\\n    fi \\\n    && git -C /opt/vllm rev-parse HEAD > /opt/flashnext-fork-commit \\\n    && git -C /opt/vllm rev-parse --abbrev-ref HEAD >> /opt/flashnext-fork-commit\n\n# Editable, no build isolation: the build links against the venv's pinned\n# torch and never resolves build-system.requires (the fork's torch==2.11.0\n# build-system pin is therefore irrelevant here — IMPORTS.md section 1).\n# Build artifacts land inside /opt/vllm, so a bind-mounted checkout keeps\n# them across rebuilds and ccache (on PATH, auto-detected by vLLM's cmake)\n# recompiles only what changed.\nRUN pip install -e /opt/vllm --no-build-isolation\n\n# ---- the fn_ instrument overlay ----\n# Lands the instrument modules importable at the top level of site-packages.\nCOPY container/rootfs/ /opt/venv/lib/python3.12/site-packages/\n\n# ---- build identity ----\nRUN mkdir -p /opt/flashnext && python3 - <<'PY'\nimport json, time, importlib.metadata as md\ndef ver(name):\n    try:\n        return md.version(name)\n    except md.PackageNotFoundError:\n        return \"unknown\"\nlines = open(\"/opt/flashnext-fork-commit\").read().splitlines()\ninfo = {\n    \"lane\": \"container\",\n    \"image\": \"flashnext:dev\",\n    \"fork_repo\": \"https://github.com/mecattaf/vllm\",\n    \"fork_commit\": lines[0],\n    \"fork_branch\": lines[1] if len(lines) > 1 else \"flashnext\",\n    \"torch\": md.version(\"torch\"),\n    \"torchvision\": md.version(\"torchvision\"),\n    \"triton\": md.version(\"triton\"),\n    \"rocm_sdk_core\": ver(\"rocm-sdk-core\"),\n    \"amd_torch_device_gfx1151\": ver(\"amd-torch-device-gfx1151\"),\n    \"gpu_target\": \"gfx1151\",\n    \"built_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\n}\njson.dump(info, open(\"/opt/flashnext/build-info.json\", \"w\"), indent=1)\nPY\nRUN cat /opt/flashnext/build-info.json\n\nWORKDIR /opt/vllm\nCMD [\"bash\"]\n"}]},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_b513cb3e97fd4453b9117f5b","toolName":"read","result":{"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Validate every overnight receipt under results/receipts/.\n\nA receipt is one JSON object: {\"step\": str, \"status\": \"pass\"|\"fail\",\n\"ts\": str, \"data\": {...}}. Missing receipts are legal (the step has not\nrun); a present receipt must be well-formed, and hard bounds are enforced\nper step. Any violation exits 2 — this is the ladder gate that makes the\novernight claims graded rather than narrated.\n\"\"\"\n\nimport json\nimport pathlib\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nRECEIPTS = ROOT / \"results\" / \"receipts\"\n\n# Per-step hard bounds: step-name prefix -> checker(data) -> error or None.\ndef _residency(d):\n    for rank, gib in (d.get(\"gtt_gib_per_rank\") or {}).items():\n        if gib > 80:\n            return f\"rank {rank} GTT {gib} GiB exceeds the 80 GiB bound\"\n    if d.get(\"table_gpu_resident_bytes\", 0) != 0:\n        return \"table has GPU-resident bytes; the mmap path is not engaged\"\n    if not d.get(\"read_after_warmed_decode\", False):\n        return \"residency was not read after a warmed decode\"\n    return None\n\ndef _tp2(d):\n    if not d.get(\"byte_identical_repeat\", False):\n        return \"greedy repeat was not byte-identical\"\n    return None\n\ndef _weights(d):\n    if d.get(\"shards\", 0) < 131:\n        return f\"only {d.get('shards')} shards staged\"\n    return None\n\ndef _bench(d):\n    if d.get(\"loads_per_arm\", 0) < 3:\n        return \"fewer than 3 loads per arm\"\n    if not d.get(\"counterbalanced\", False):\n        return \"arms were not counterbalanced\"\n    return None\n\ndef _context(d):\n    ratio = d.get(\"decode_ratio_vs_short_context\")\n    if ratio is not None and ratio < 0.9:\n        return f\"full-context decode ratio {ratio} below the 0.9 bound\"\n    return None\n\ndef _smoke(d):\n    ap = (d.get(\"aperture\") or {}).get(\"ttm_pages_limit\")\n    if ap is not None and ap != 33554432:\n        return f\"aperture {ap} diverges from the 33554432-page ceiling\"\n    return None\n\nBOUNDS = {\n    \"residency\": _residency,\n    \"tp2\": _tp2,\n    \"weights\": _weights,\n    \"bench\": _bench,\n    \"context\": _context,\n    \"smoke\": _smoke,\n}\n\ndef _handoff_patch_ok() -> str | None:\n    \"\"\"When the catalog patch exists it must parse as a git patch.\"\"\"\n    import subprocess\n    patch = ROOT / \"handoff\" / \"catalog-row.patch\"\n    if not patch.is_file():\n        return None\n    proc = subprocess.run([\"git\", \"apply\", \"--stat\", str(patch)],\n                          capture_output=True, text=True)\n    if proc.returncode != 0:\n        return f\"handoff/catalog-row.patch does not parse: {proc.stderr.strip()}\"\n    return None\n\n\ndef main() -> int:\n    bad = 0\n    err = _handoff_patch_ok()\n    if err:\n        print(f\"receipts-verify: {err}\")\n        bad += 1\n    if not RECEIPTS.is_dir():\n        print(\"receipts-verify: no receipts directory; nothing ran\")\n        return 2 if bad else 0\n    seen = 0\n    for path in sorted(RECEIPTS.glob(\"*.json\")):\n        seen += 1\n        try:\n            r = json.loads(path.read_text())\n        except json.JSONDecodeError as e:\n            print(f\"receipts-verify: {path.name}: invalid JSON: {e}\")\n            bad += 1\n            continue\n        for key in (\"step\", \"status\", \"ts\"):\n            if key not in r:\n                print(f\"receipts-verify: {path.name}: missing '{key}'\")\n                bad += 1\n        if r.get(\"status\") == \"fail\":\n            print(f\"receipts-verify: {path.name}: step '{r.get('step')}' FAILED\")\n            bad += 1\n        for prefix, check in BOUNDS.items():\n            if str(r.get(\"step\", \"\")).startswith(prefix):\n                err = check(r.get(\"data\") or {})\n                if err:\n                    print(f\"receipts-verify: {path.name}: {err}\")\n                    bad += 1\n    print(f\"receipts-verify: {seen} receipts checked, {bad} violations\")\n    return 2 if bad else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}]},"isError":false}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_b3a51ca902ca434fa32640be","toolName":"read","content":[{"type":"text","text":"# flashnext:dev — the engine fork built from source at the exactly pinned wheel set\n# ============================================================================\n#\n# Recipe shape adapted from kyuz0/amd-strix-halo-vllm-toolboxes,\n# `Dockerfile.ubuntu-repoamd` @ 23cb726, credited per THIRD_PARTY_NOTICES.md.\n# That recipe is MIT licensed; the notice is retained here as required:\n#\n#   MIT License — Copyright (c) kyuz0 (amd-strix-halo-vllm-toolboxes)\n#\n#   Permission is hereby granted, free of charge, to any person obtaining a\n#   copy of this software and associated documentation files (the \"Software\"),\n#   to deal in the Software without restriction, including without limitation\n#   the rights to use, copy, modify, merge, publish, distribute, sublicense,\n#   and/or sell copies of the Software, and to permit persons to whom the\n#   Software is furnished to do so, subject to the following conditions:\n#\n#   The above copyright notice and this permission notice shall be included in\n#   all copies or substantial portions of the Software.\n#\n#   THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n#   DEALINGS IN THE SOFTWARE.\n#\n# What changed vs the donor recipe (per IMPORTS.md sections 1 and 2):\n#   - torch is pinned to the fork's exact pin 2.13.0+rocm7.14.0 from the AMD\n#     stable multi-arch index (the index tops out there; no ROCm 10 wheels\n#     exist for gfx1151 — specs/flashnext/evidence/kyuz0-rocm10.md).\n#   - torchaudio is OMITTED; we drop the audio extra rather than downgrade\n#     torch to 2.11 (torchaudio capped kyuz0's auto-resolved set there).\n#   - the engine is the flashnext fork (mecattaf/vllm, branch flashnext),\n#     built from source for gfx1151, not a stock vLLM ref.\n#   - designed for overnight iteration: bind-mount a fork checkout over\n#     /opt/vllm and a host dir over /root/.ccache (see container/build.sh);\n#     the editable install then recompiles only what a one-line patch touched.\n#\n# Wheel provenance: the torch/triton/vision/rocm-sdk substrate comes ONLY\n# from the vendor stable index (spec F.11). Generic Python build tooling\n# (setuptools, wheel, packaging, setuptools-scm) and vLLM's upstream runtime\n# dependencies resolve from PyPI as upstream vLLM does; none of those is part\n# of the pinned substrate.\n\nFROM docker.io/ubuntu:24.04\n\nARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n# The exactly pinned wheel set (IMPORTS.md section 1). The triton pin is the\n# wheel accompanying the torch 2.13.0 set on the vendor stable index —\n# verified by pip's own resolver: torch 2.13.0+rocm7.14.0 depends on exactly\n# triton==3.8.0+git4cff872c.rocm7.14.0 (anything else is ResolutionImpossible).\n# < 3.8 awareness (IMPORTS.md): the fork's fp8-upcast gate keys on triton < 3.8,\n# so on this wheel the admission stands but the in-kernel upcast is bypassed —\n# fp8 dots ride triton 3.8's own lowering, and the fidelity checkpoint grades it.\nARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\nARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\nARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n# The from-source engine build needs the HIP compiler + cmake packages, which\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\nARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n# images ship as separate device packages (torch loads them from torch/.kpack/).\n# Without these the first kernel launch dies with hipErrorInvalidImage.\nARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n\nENV DEBIAN_FRONTEND=noninteractive\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n        python3.12 python3.12-venv python3.12-dev \\\n        git ca-certificates curl \\\n        build-essential cmake ninja-build ccache \\\n        cargo rustc libnuma-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Python 3.12 venv at /opt/venv (pip arrives via ensurepip — no external fetch).\nRUN python3.12 -m venv /opt/venv\nENV VIRTUAL_ENV=/opt/venv \\\n    PATH=/opt/venv/bin:$PATH \\\n    PIP_NO_CACHE_DIR=0 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    CCACHE_DIR=/root/.ccache \\\n    HOME=/root\n\n# Python build tooling (setuptools is served by the vendor index itself; the\n# rest is generic build-time tooling, not substrate).\nRUN pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \\\n        setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n\n# ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\nRUN pip install --index-url ${ROCM_WHL} \\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n\n# ---- the engine fork, built from source for gfx1151 ----\nARG VLLM_REPO=https://github.com/mecattaf/vllm\nARG VLLM_BRANCH=flashnext\nENV VLLM_TARGET_DEVICE=rocm \\\n    PYTORCH_ROCM_ARCH=gfx1151\n\n# If a host fork checkout is bind-mounted over /opt/vllm (build.sh -v), keep\n# it — that is the incremental-iteration path. Otherwise clone the baseline.\nRUN if [ ! -d /opt/vllm/.git ]; then \\\n        git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm /opt/vllm; \\\n    fi \\\n    && git -C /opt/vllm rev-parse HEAD > /opt/flashnext-fork-commit \\\n    && git -C /opt/vllm rev-parse --abbrev-ref HEAD >> /opt/flashnext-fork-commit\n\n# Editable, no build isolation: the build links against the venv's pinned\n# torch and never resolves build-system.requires (the fork's torch==2.11.0\n# build-system pin is therefore irrelevant here — IMPORTS.md section 1).\n# Build artifacts land inside /opt/vllm, so a bind-mounted checkout keeps\n# them across rebuilds and ccache (on PATH, auto-detected by vLLM's cmake)\n# recompiles only what changed.\nRUN pip install -e /opt/vllm --no-build-isolation\n\n# ---- the fn_ instrument overlay ----\n# Lands the instrument modules importable at the top level of site-packages.\nCOPY container/rootfs/ /opt/venv/lib/python3.12/site-packages/\n\n# ---- build identity ----\nRUN mkdir -p /opt/flashnext && python3 - <<'PY'\nimport json, time, importlib.metadata as md\ndef ver(name):\n    try:\n        return md.version(name)\n    except md.PackageNotFoundError:\n        return \"unknown\"\nlines = open(\"/opt/flashnext-fork-commit\").read().splitlines()\ninfo = {\n    \"lane\": \"container\",\n    \"image\": \"flashnext:dev\",\n    \"fork_repo\": \"https://github.com/mecattaf/vllm\",\n    \"fork_commit\": lines[0],\n    \"fork_branch\": lines[1] if len(lines) > 1 else \"flashnext\",\n    \"torch\": md.version(\"torch\"),\n    \"torchvision\": md.version(\"torchvision\"),\n    \"triton\": md.version(\"triton\"),\n    \"rocm_sdk_core\": ver(\"rocm-sdk-core\"),\n    \"amd_torch_device_gfx1151\": ver(\"amd-torch-device-gfx1151\"),\n    \"gpu_target\": \"gfx1151\",\n    \"built_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\n}\njson.dump(info, open(\"/opt/flashnext/build-info.json\", \"w\"), indent=1)\nPY\nRUN cat /opt/flashnext/build-info.json\n\nWORKDIR /opt/vllm\nCMD [\"bash\"]\n"}],"isError":false,"timestamp":1787991848015}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call_b3a51ca902ca434fa32640be","toolName":"read","content":[{"type":"text","text":"# flashnext:dev — the engine fork built from source at the exactly pinned wheel set\n# ============================================================================\n#\n# Recipe shape adapted from kyuz0/amd-strix-halo-vllm-toolboxes,\n# `Dockerfile.ubuntu-repoamd` @ 23cb726, credited per THIRD_PARTY_NOTICES.md.\n# That recipe is MIT licensed; the notice is retained here as required:\n#\n#   MIT License — Copyright (c) kyuz0 (amd-strix-halo-vllm-toolboxes)\n#\n#   Permission is hereby granted, free of charge, to any person obtaining a\n#   copy of this software and associated documentation files (the \"Software\"),\n#   to deal in the Software without restriction, including without limitation\n#   the rights to use, copy, modify, merge, publish, distribute, sublicense,\n#   and/or sell copies of the Software, and to permit persons to whom the\n#   Software is furnished to do so, subject to the following conditions:\n#\n#   The above copyright notice and this permission notice shall be included in\n#   all copies or substantial portions of the Software.\n#\n#   THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n#   DEALINGS IN THE SOFTWARE.\n#\n# What changed vs the donor recipe (per IMPORTS.md sections 1 and 2):\n#   - torch is pinned to the fork's exact pin 2.13.0+rocm7.14.0 from the AMD\n#     stable multi-arch index (the index tops out there; no ROCm 10 wheels\n#     exist for gfx1151 — specs/flashnext/evidence/kyuz0-rocm10.md).\n#   - torchaudio is OMITTED; we drop the audio extra rather than downgrade\n#     torch to 2.11 (torchaudio capped kyuz0's auto-resolved set there).\n#   - the engine is the flashnext fork (mecattaf/vllm, branch flashnext),\n#     built from source for gfx1151, not a stock vLLM ref.\n#   - designed for overnight iteration: bind-mount a fork checkout over\n#     /opt/vllm and a host dir over /root/.ccache (see container/build.sh);\n#     the editable install then recompiles only what a one-line patch touched.\n#\n# Wheel provenance: the torch/triton/vision/rocm-sdk substrate comes ONLY\n# from the vendor stable index (spec F.11). Generic Python build tooling\n# (setuptools, wheel, packaging, setuptools-scm) and vLLM's upstream runtime\n# dependencies resolve from PyPI as upstream vLLM does; none of those is part\n# of the pinned substrate.\n\nFROM docker.io/ubuntu:24.04\n\nARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n# The exactly pinned wheel set (IMPORTS.md section 1). The triton pin is the\n# wheel accompanying the torch 2.13.0 set on the vendor stable index —\n# verified by pip's own resolver: torch 2.13.0+rocm7.14.0 depends on exactly\n# triton==3.8.0+git4cff872c.rocm7.14.0 (anything else is ResolutionImpossible).\n# < 3.8 awareness (IMPORTS.md): the fork's fp8-upcast gate keys on triton < 3.8,\n# so on this wheel the admission stands but the in-kernel upcast is bypassed —\n# fp8 dots ride triton 3.8's own lowering, and the fidelity checkpoint grades it.\nARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\nARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\nARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n# The from-source engine build needs the HIP compiler + cmake packages, which\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\nARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n# images ship as separate device packages (torch loads them from torch/.kpack/).\n# Without these the first kernel launch dies with hipErrorInvalidImage.\nARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n\nENV DEBIAN_FRONTEND=noninteractive\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n        python3.12 python3.12-venv python3.12-dev \\\n        git ca-certificates curl \\\n        build-essential cmake ninja-build ccache \\\n        cargo rustc libnuma-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Python 3.12 venv at /opt/venv (pip arrives via ensurepip — no external fetch).\nRUN python3.12 -m venv /opt/venv\nENV VIRTUAL_ENV=/opt/venv \\\n    PATH=/opt/venv/bin:$PATH \\\n    PIP_NO_CACHE_DIR=0 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    CCACHE_DIR=/root/.ccache \\\n    HOME=/root\n\n# Python build tooling (setuptools is served by the vendor index itself; the\n# rest is generic build-time tooling, not substrate).\nRUN pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \\\n        setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n\n# ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\nRUN pip install --index-url ${ROCM_WHL} \\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n\n# ---- the engine fork, built from source for gfx1151 ----\nARG VLLM_REPO=https://github.com/mecattaf/vllm\nARG VLLM_BRANCH=flashnext\nENV VLLM_TARGET_DEVICE=rocm \\\n    PYTORCH_ROCM_ARCH=gfx1151\n\n# If a host fork checkout is bind-mounted over /opt/vllm (build.sh -v), keep\n# it — that is the incremental-iteration path. Otherwise clone the baseline.\nRUN if [ ! -d /opt/vllm/.git ]; then \\\n        git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm /opt/vllm; \\\n    fi \\\n    && git -C /opt/vllm rev-parse HEAD > /opt/flashnext-fork-commit \\\n    && git -C /opt/vllm rev-parse --abbrev-ref HEAD >> /opt/flashnext-fork-commit\n\n# Editable, no build isolation: the build links against the venv's pinned\n# torch and never resolves build-system.requires (the fork's torch==2.11.0\n# build-system pin is therefore irrelevant here — IMPORTS.md section 1).\n# Build artifacts land inside /opt/vllm, so a bind-mounted checkout keeps\n# them across rebuilds and ccache (on PATH, auto-detected by vLLM's cmake)\n# recompiles only what changed.\nRUN pip install -e /opt/vllm --no-build-isolation\n\n# ---- the fn_ instrument overlay ----\n# Lands the instrument modules importable at the top level of site-packages.\nCOPY container/rootfs/ /opt/venv/lib/python3.12/site-packages/\n\n# ---- build identity ----\nRUN mkdir -p /opt/flashnext && python3 - <<'PY'\nimport json, time, importlib.metadata as md\ndef ver(name):\n    try:\n        return md.version(name)\n    except md.PackageNotFoundError:\n        return \"unknown\"\nlines = open(\"/opt/flashnext-fork-commit\").read().splitlines()\ninfo = {\n    \"lane\": \"container\",\n    \"image\": \"flashnext:dev\",\n    \"fork_repo\": \"https://github.com/mecattaf/vllm\",\n    \"fork_commit\": lines[0],\n    \"fork_branch\": lines[1] if len(lines) > 1 else \"flashnext\",\n    \"torch\": md.version(\"torch\"),\n    \"torchvision\": md.version(\"torchvision\"),\n    \"triton\": md.version(\"triton\"),\n    \"rocm_sdk_core\": ver(\"rocm-sdk-core\"),\n    \"amd_torch_device_gfx1151\": ver(\"amd-torch-device-gfx1151\"),\n    \"gpu_target\": \"gfx1151\",\n    \"built_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\n}\njson.dump(info, open(\"/opt/flashnext/build-info.json\", \"w\"), indent=1)\nPY\nRUN cat /opt/flashnext/build-info.json\n\nWORKDIR /opt/vllm\nCMD [\"bash\"]\n"}],"isError":false,"timestamp":1787991848015}}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_b513cb3e97fd4453b9117f5b","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Validate every overnight receipt under results/receipts/.\n\nA receipt is one JSON object: {\"step\": str, \"status\": \"pass\"|\"fail\",\n\"ts\": str, \"data\": {...}}. Missing receipts are legal (the step has not\nrun); a present receipt must be well-formed, and hard bounds are enforced\nper step. Any violation exits 2 — this is the ladder gate that makes the\novernight claims graded rather than narrated.\n\"\"\"\n\nimport json\nimport pathlib\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nRECEIPTS = ROOT / \"results\" / \"receipts\"\n\n# Per-step hard bounds: step-name prefix -> checker(data) -> error or None.\ndef _residency(d):\n    for rank, gib in (d.get(\"gtt_gib_per_rank\") or {}).items():\n        if gib > 80:\n            return f\"rank {rank} GTT {gib} GiB exceeds the 80 GiB bound\"\n    if d.get(\"table_gpu_resident_bytes\", 0) != 0:\n        return \"table has GPU-resident bytes; the mmap path is not engaged\"\n    if not d.get(\"read_after_warmed_decode\", False):\n        return \"residency was not read after a warmed decode\"\n    return None\n\ndef _tp2(d):\n    if not d.get(\"byte_identical_repeat\", False):\n        return \"greedy repeat was not byte-identical\"\n    return None\n\ndef _weights(d):\n    if d.get(\"shards\", 0) < 131:\n        return f\"only {d.get('shards')} shards staged\"\n    return None\n\ndef _bench(d):\n    if d.get(\"loads_per_arm\", 0) < 3:\n        return \"fewer than 3 loads per arm\"\n    if not d.get(\"counterbalanced\", False):\n        return \"arms were not counterbalanced\"\n    return None\n\ndef _context(d):\n    ratio = d.get(\"decode_ratio_vs_short_context\")\n    if ratio is not None and ratio < 0.9:\n        return f\"full-context decode ratio {ratio} below the 0.9 bound\"\n    return None\n\ndef _smoke(d):\n    ap = (d.get(\"aperture\") or {}).get(\"ttm_pages_limit\")\n    if ap is not None and ap != 33554432:\n        return f\"aperture {ap} diverges from the 33554432-page ceiling\"\n    return None\n\nBOUNDS = {\n    \"residency\": _residency,\n    \"tp2\": _tp2,\n    \"weights\": _weights,\n    \"bench\": _bench,\n    \"context\": _context,\n    \"smoke\": _smoke,\n}\n\ndef _handoff_patch_ok() -> str | None:\n    \"\"\"When the catalog patch exists it must parse as a git patch.\"\"\"\n    import subprocess\n    patch = ROOT / \"handoff\" / \"catalog-row.patch\"\n    if not patch.is_file():\n        return None\n    proc = subprocess.run([\"git\", \"apply\", \"--stat\", str(patch)],\n                          capture_output=True, text=True)\n    if proc.returncode != 0:\n        return f\"handoff/catalog-row.patch does not parse: {proc.stderr.strip()}\"\n    return None\n\n\ndef main() -> int:\n    bad = 0\n    err = _handoff_patch_ok()\n    if err:\n        print(f\"receipts-verify: {err}\")\n        bad += 1\n    if not RECEIPTS.is_dir():\n        print(\"receipts-verify: no receipts directory; nothing ran\")\n        return 2 if bad else 0\n    seen = 0\n    for path in sorted(RECEIPTS.glob(\"*.json\")):\n        seen += 1\n        try:\n            r = json.loads(path.read_text())\n        except json.JSONDecodeError as e:\n            print(f\"receipts-verify: {path.name}: invalid JSON: {e}\")\n            bad += 1\n            continue\n        for key in (\"step\", \"status\", \"ts\"):\n            if key not in r:\n                print(f\"receipts-verify: {path.name}: missing '{key}'\")\n                bad += 1\n        if r.get(\"status\") == \"fail\":\n            print(f\"receipts-verify: {path.name}: step '{r.get('step')}' FAILED\")\n            bad += 1\n        for prefix, check in BOUNDS.items():\n            if str(r.get(\"step\", \"\")).startswith(prefix):\n                err = check(r.get(\"data\") or {})\n                if err:\n                    print(f\"receipts-verify: {path.name}: {err}\")\n                    bad += 1\n    print(f\"receipts-verify: {seen} receipts checked, {bad} violations\")\n    return 2 if bad else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"timestamp":1787991848016}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call_b513cb3e97fd4453b9117f5b","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Validate every overnight receipt under results/receipts/.\n\nA receipt is one JSON object: {\"step\": str, \"status\": \"pass\"|\"fail\",\n\"ts\": str, \"data\": {...}}. Missing receipts are legal (the step has not\nrun); a present receipt must be well-formed, and hard bounds are enforced\nper step. Any violation exits 2 — this is the ladder gate that makes the\novernight claims graded rather than narrated.\n\"\"\"\n\nimport json\nimport pathlib\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nRECEIPTS = ROOT / \"results\" / \"receipts\"\n\n# Per-step hard bounds: step-name prefix -> checker(data) -> error or None.\ndef _residency(d):\n    for rank, gib in (d.get(\"gtt_gib_per_rank\") or {}).items():\n        if gib > 80:\n            return f\"rank {rank} GTT {gib} GiB exceeds the 80 GiB bound\"\n    if d.get(\"table_gpu_resident_bytes\", 0) != 0:\n        return \"table has GPU-resident bytes; the mmap path is not engaged\"\n    if not d.get(\"read_after_warmed_decode\", False):\n        return \"residency was not read after a warmed decode\"\n    return None\n\ndef _tp2(d):\n    if not d.get(\"byte_identical_repeat\", False):\n        return \"greedy repeat was not byte-identical\"\n    return None\n\ndef _weights(d):\n    if d.get(\"shards\", 0) < 131:\n        return f\"only {d.get('shards')} shards staged\"\n    return None\n\ndef _bench(d):\n    if d.get(\"loads_per_arm\", 0) < 3:\n        return \"fewer than 3 loads per arm\"\n    if not d.get(\"counterbalanced\", False):\n        return \"arms were not counterbalanced\"\n    return None\n\ndef _context(d):\n    ratio = d.get(\"decode_ratio_vs_short_context\")\n    if ratio is not None and ratio < 0.9:\n        return f\"full-context decode ratio {ratio} below the 0.9 bound\"\n    return None\n\ndef _smoke(d):\n    ap = (d.get(\"aperture\") or {}).get(\"ttm_pages_limit\")\n    if ap is not None and ap != 33554432:\n        return f\"aperture {ap} diverges from the 33554432-page ceiling\"\n    return None\n\nBOUNDS = {\n    \"residency\": _residency,\n    \"tp2\": _tp2,\n    \"weights\": _weights,\n    \"bench\": _bench,\n    \"context\": _context,\n    \"smoke\": _smoke,\n}\n\ndef _handoff_patch_ok() -> str | None:\n    \"\"\"When the catalog patch exists it must parse as a git patch.\"\"\"\n    import subprocess\n    patch = ROOT / \"handoff\" / \"catalog-row.patch\"\n    if not patch.is_file():\n        return None\n    proc = subprocess.run([\"git\", \"apply\", \"--stat\", str(patch)],\n                          capture_output=True, text=True)\n    if proc.returncode != 0:\n        return f\"handoff/catalog-row.patch does not parse: {proc.stderr.strip()}\"\n    return None\n\n\ndef main() -> int:\n    bad = 0\n    err = _handoff_patch_ok()\n    if err:\n        print(f\"receipts-verify: {err}\")\n        bad += 1\n    if not RECEIPTS.is_dir():\n        print(\"receipts-verify: no receipts directory; nothing ran\")\n        return 2 if bad else 0\n    seen = 0\n    for path in sorted(RECEIPTS.glob(\"*.json\")):\n        seen += 1\n        try:\n            r = json.loads(path.read_text())\n        except json.JSONDecodeError as e:\n            print(f\"receipts-verify: {path.name}: invalid JSON: {e}\")\n            bad += 1\n            continue\n        for key in (\"step\", \"status\", \"ts\"):\n            if key not in r:\n                print(f\"receipts-verify: {path.name}: missing '{key}'\")\n                bad += 1\n        if r.get(\"status\") == \"fail\":\n            print(f\"receipts-verify: {path.name}: step '{r.get('step')}' FAILED\")\n            bad += 1\n        for prefix, check in BOUNDS.items():\n            if str(r.get(\"step\", \"\")).startswith(prefix):\n                err = check(r.get(\"data\") or {})\n                if err:\n                    print(f\"receipts-verify: {path.name}: {err}\")\n                    bad += 1\n    print(f\"receipts-verify: {seen} receipts checked, {bad} violations\")\n    return 2 if bad else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"timestamp":1787991848016}}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Next, check container/build.sh and the Containerfile to see how the fork's checkout is placed inside the container (the path), and also check receipts-verify.py for the receipt schema validation of proxy.json.\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_b3a51ca902ca434fa32640be","name":"read","arguments":{"path":"/home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/container/Containerfile"}},{"type":"toolCall","id":"call_b513cb3e97fd4453b9117f5b","name":"read","arguments":{"path":"/home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/receipts-verify.py"}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":12920,"output":163,"cacheRead":25600,"cacheWrite":0,"reasoning":42,"totalTokens":38683,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787991841053,"responseId":"chatcmpl-3bf4b536-3520-437d-8e01-ed6d4c567194","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_b3a51ca902ca434fa32640be","toolName":"read","content":[{"type":"text","text":"# flashnext:dev — the engine fork built from source at the exactly pinned wheel set\n# ============================================================================\n#\n# Recipe shape adapted from kyuz0/amd-strix-halo-vllm-toolboxes,\n# `Dockerfile.ubuntu-repoamd` @ 23cb726, credited per THIRD_PARTY_NOTICES.md.\n# That recipe is MIT licensed; the notice is retained here as required:\n#\n#   MIT License — Copyright (c) kyuz0 (amd-strix-halo-vllm-toolboxes)\n#\n#   Permission is hereby granted, free of charge, to any person obtaining a\n#   copy of this software and associated documentation files (the \"Software\"),\n#   to deal in the Software without restriction, including without limitation\n#   the rights to use, copy, modify, merge, publish, distribute, sublicense,\n#   and/or sell copies of the Software, and to permit persons to whom the\n#   Software is furnished to do so, subject to the following conditions:\n#\n#   The above copyright notice and this permission notice shall be included in\n#   all copies or substantial portions of the Software.\n#\n#   THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n#   DEALINGS IN THE SOFTWARE.\n#\n# What changed vs the donor recipe (per IMPORTS.md sections 1 and 2):\n#   - torch is pinned to the fork's exact pin 2.13.0+rocm7.14.0 from the AMD\n#     stable multi-arch index (the index tops out there; no ROCm 10 wheels\n#     exist for gfx1151 — specs/flashnext/evidence/kyuz0-rocm10.md).\n#   - torchaudio is OMITTED; we drop the audio extra rather than downgrade\n#     torch to 2.11 (torchaudio capped kyuz0's auto-resolved set there).\n#   - the engine is the flashnext fork (mecattaf/vllm, branch flashnext),\n#     built from source for gfx1151, not a stock vLLM ref.\n#   - designed for overnight iteration: bind-mount a fork checkout over\n#     /opt/vllm and a host dir over /root/.ccache (see container/build.sh);\n#     the editable install then recompiles only what a one-line patch touched.\n#\n# Wheel provenance: the torch/triton/vision/rocm-sdk substrate comes ONLY\n# from the vendor stable index (spec F.11). Generic Python build tooling\n# (setuptools, wheel, packaging, setuptools-scm) and vLLM's upstream runtime\n# dependencies resolve from PyPI as upstream vLLM does; none of those is part\n# of the pinned substrate.\n\nFROM docker.io/ubuntu:24.04\n\nARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n# The exactly pinned wheel set (IMPORTS.md section 1). The triton pin is the\n# wheel accompanying the torch 2.13.0 set on the vendor stable index —\n# verified by pip's own resolver: torch 2.13.0+rocm7.14.0 depends on exactly\n# triton==3.8.0+git4cff872c.rocm7.14.0 (anything else is ResolutionImpossible).\n# < 3.8 awareness (IMPORTS.md): the fork's fp8-upcast gate keys on triton < 3.8,\n# so on this wheel the admission stands but the in-kernel upcast is bypassed —\n# fp8 dots ride triton 3.8's own lowering, and the fidelity checkpoint grades it.\nARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\nARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\nARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n# The from-source engine build needs the HIP compiler + cmake packages, which\n# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\nARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n# images ship as separate device packages (torch loads them from torch/.kpack/).\n# Without these the first kernel launch dies with hipErrorInvalidImage.\nARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n\nENV DEBIAN_FRONTEND=noninteractive\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n        python3.12 python3.12-venv python3.12-dev \\\n        git ca-certificates curl \\\n        build-essential cmake ninja-build ccache \\\n        cargo rustc libnuma-dev \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Python 3.12 venv at /opt/venv (pip arrives via ensurepip — no external fetch).\nRUN python3.12 -m venv /opt/venv\nENV VIRTUAL_ENV=/opt/venv \\\n    PATH=/opt/venv/bin:$PATH \\\n    PIP_NO_CACHE_DIR=0 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    CCACHE_DIR=/root/.ccache \\\n    HOME=/root\n\n# Python build tooling (setuptools is served by the vendor index itself; the\n# rest is generic build-time tooling, not substrate).\nRUN pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \\\n        setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n\n# ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\nRUN pip install --index-url ${ROCM_WHL} \\\n        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n\n# ---- the engine fork, built from source for gfx1151 ----\nARG VLLM_REPO=https://github.com/mecattaf/vllm\nARG VLLM_BRANCH=flashnext\nENV VLLM_TARGET_DEVICE=rocm \\\n    PYTORCH_ROCM_ARCH=gfx1151\n\n# If a host fork checkout is bind-mounted over /opt/vllm (build.sh -v), keep\n# it — that is the incremental-iteration path. Otherwise clone the baseline.\nRUN if [ ! -d /opt/vllm/.git ]; then \\\n        git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm /opt/vllm; \\\n    fi \\\n    && git -C /opt/vllm rev-parse HEAD > /opt/flashnext-fork-commit \\\n    && git -C /opt/vllm rev-parse --abbrev-ref HEAD >> /opt/flashnext-fork-commit\n\n# Editable, no build isolation: the build links against the venv's pinned\n# torch and never resolves build-system.requires (the fork's torch==2.11.0\n# build-system pin is therefore irrelevant here — IMPORTS.md section 1).\n# Build artifacts land inside /opt/vllm, so a bind-mounted checkout keeps\n# them across rebuilds and ccache (on PATH, auto-detected by vLLM's cmake)\n# recompiles only what changed.\nRUN pip install -e /opt/vllm --no-build-isolation\n\n# ---- the fn_ instrument overlay ----\n# Lands the instrument modules importable at the top level of site-packages.\nCOPY container/rootfs/ /opt/venv/lib/python3.12/site-packages/\n\n# ---- build identity ----\nRUN mkdir -p /opt/flashnext && python3 - <<'PY'\nimport json, time, importlib.metadata as md\ndef ver(name):\n    try:\n        return md.version(name)\n    except md.PackageNotFoundError:\n        return \"unknown\"\nlines = open(\"/opt/flashnext-fork-commit\").read().splitlines()\ninfo = {\n    \"lane\": \"container\",\n    \"image\": \"flashnext:dev\",\n    \"fork_repo\": \"https://github.com/mecattaf/vllm\",\n    \"fork_commit\": lines[0],\n    \"fork_branch\": lines[1] if len(lines) > 1 else \"flashnext\",\n    \"torch\": md.version(\"torch\"),\n    \"torchvision\": md.version(\"torchvision\"),\n    \"triton\": md.version(\"triton\"),\n    \"rocm_sdk_core\": ver(\"rocm-sdk-core\"),\n    \"amd_torch_device_gfx1151\": ver(\"amd-torch-device-gfx1151\"),\n    \"gpu_target\": \"gfx1151\",\n    \"built_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\n}\njson.dump(info, open(\"/opt/flashnext/build-info.json\", \"w\"), indent=1)\nPY\nRUN cat /opt/flashnext/build-info.json\n\nWORKDIR /opt/vllm\nCMD [\"bash\"]\n"}],"isError":false,"timestamp":1787991848015},{"role":"toolResult","toolCallId":"call_b513cb3e97fd4453b9117f5b","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"Validate every overnight receipt under results/receipts/.\n\nA receipt is one JSON object: {\"step\": str, \"status\": \"pass\"|\"fail\",\n\"ts\": str, \"data\": {...}}. Missing receipts are legal (the step has not\nrun); a present receipt must be well-formed, and hard bounds are enforced\nper step. Any violation exits 2 — this is the ladder gate that makes the\novernight claims graded rather than narrated.\n\"\"\"\n\nimport json\nimport pathlib\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nRECEIPTS = ROOT / \"results\" / \"receipts\"\n\n# Per-step hard bounds: step-name prefix -> checker(data) -> error or None.\ndef _residency(d):\n    for rank, gib in (d.get(\"gtt_gib_per_rank\") or {}).items():\n        if gib > 80:\n            return f\"rank {rank} GTT {gib} GiB exceeds the 80 GiB bound\"\n    if d.get(\"table_gpu_resident_bytes\", 0) != 0:\n        return \"table has GPU-resident bytes; the mmap path is not engaged\"\n    if not d.get(\"read_after_warmed_decode\", False):\n        return \"residency was not read after a warmed decode\"\n    return None\n\ndef _tp2(d):\n    if not d.get(\"byte_identical_repeat\", False):\n        return \"greedy repeat was not byte-identical\"\n    return None\n\ndef _weights(d):\n    if d.get(\"shards\", 0) < 131:\n        return f\"only {d.get('shards')} shards staged\"\n    return None\n\ndef _bench(d):\n    if d.get(\"loads_per_arm\", 0) < 3:\n        return \"fewer than 3 loads per arm\"\n    if not d.get(\"counterbalanced\", False):\n        return \"arms were not counterbalanced\"\n    return None\n\ndef _context(d):\n    ratio = d.get(\"decode_ratio_vs_short_context\")\n    if ratio is not None and ratio < 0.9:\n        return f\"full-context decode ratio {ratio} below the 0.9 bound\"\n    return None\n\ndef _smoke(d):\n    ap = (d.get(\"aperture\") or {}).get(\"ttm_pages_limit\")\n    if ap is not None and ap != 33554432:\n        return f\"aperture {ap} diverges from the 33554432-page ceiling\"\n    return None\n\nBOUNDS = {\n    \"residency\": _residency,\n    \"tp2\": _tp2,\n    \"weights\": _weights,\n    \"bench\": _bench,\n    \"context\": _context,\n    \"smoke\": _smoke,\n}\n\ndef _handoff_patch_ok() -> str | None:\n    \"\"\"When the catalog patch exists it must parse as a git patch.\"\"\"\n    import subprocess\n    patch = ROOT / \"handoff\" / \"catalog-row.patch\"\n    if not patch.is_file():\n        return None\n    proc = subprocess.run([\"git\", \"apply\", \"--stat\", str(patch)],\n                          capture_output=True, text=True)\n    if proc.returncode != 0:\n        return f\"handoff/catalog-row.patch does not parse: {proc.stderr.strip()}\"\n    return None\n\n\ndef main() -> int:\n    bad = 0\n    err = _handoff_patch_ok()\n    if err:\n        print(f\"receipts-verify: {err}\")\n        bad += 1\n    if not RECEIPTS.is_dir():\n        print(\"receipts-verify: no receipts directory; nothing ran\")\n        return 2 if bad else 0\n    seen = 0\n    for path in sorted(RECEIPTS.glob(\"*.json\")):\n        seen += 1\n        try:\n            r = json.loads(path.read_text())\n        except json.JSONDecodeError as e:\n            print(f\"receipts-verify: {path.name}: invalid JSON: {e}\")\n            bad += 1\n            continue\n        for key in (\"step\", \"status\", \"ts\"):\n            if key not in r:\n                print(f\"receipts-verify: {path.name}: missing '{key}'\")\n                bad += 1\n        if r.get(\"status\") == \"fail\":\n            print(f\"receipts-verify: {path.name}: step '{r.get('step')}' FAILED\")\n            bad += 1\n        for prefix, check in BOUNDS.items():\n            if str(r.get(\"step\", \"\")).startswith(prefix):\n                err = check(r.get(\"data\") or {})\n                if err:\n                    print(f\"receipts-verify: {path.name}: {err}\")\n                    bad += 1\n    print(f\"receipts-verify: {seen} receipts checked, {bad} violations\")\n    return 2 if bad else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"timestamp":1787991848016}]}
