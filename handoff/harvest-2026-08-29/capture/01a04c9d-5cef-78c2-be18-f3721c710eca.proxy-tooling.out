lace('''        \"ngram_vocab_size_base\": 512,\n        \"heads_per_ngram\": 1,\n        \"ple_embed_dim\": 256,\n        \"make_ngram_vocab_size_divisible_by\": 128,\n        \"split_ngram_parts\": 2,\n    }''', '''        \"ngram_vocab_size_base\": 512,\n        \"heads_per_ngram\": 1,\n        \"ple_embed_dim\": 256,\n        \"make_ngram_vocab_size_divisible_by\": 128,\n        \"split_ngram_parts\": 2,\n        \"ple_layer_ids\": [2],\n    }''')\n\nopen(p, 'w').write(src)\nEOF\nbash -n scripts/make-proxy.sh && echo BASH-OK"}}
