eout=60)\\n    return (p.stdout + p.stderr).splitlines()\\n\\ndef get(path, timeout=10):\\n    with urllib.request.urlopen(API + path, timeout=timeout) as r:\\n        return json.loads(r.read())\\n\\ndef post(path, body, timeout=3600):\\n    req = urllib.request.Request(API + path, data=json.dumps(body).encode(),\\n                                 headers={\"Content-Type\": \"application/json\"})\\n    with urllib.request.urlopen(req, timeout=timeout) as r:\\n        return json.loads(r.read())\\n\\nstatus = \"pass\"\\ndata = {\\n    \"checkpoint\": \"/var/tmp/flashnext-proxy\",\\n    \"serve\": {\"mode\": \"single-node\", \"vllm_ple_mmap\": 1,\\n              \"cudagraph_mode\": \"PIECEWISE\", \"port\": API.rsplit(\":\", 1)[-1],\\n              \"served_model_name\": MODEL},\\n    \"mmap_engaged\": False, \"finite_logits\": False,\\n    \"shutdown\": {\"clean\": False, \"exit_code\": None},\\n}\\n\\n# Engine identity and the builder\\'s manifest ride with the claim.\\ntry:\\n    data[\"engine\"] = json.loads(os.environ[\"FN_BUILD_INFO\"])\\nexcept Exception:\\n    data[\"engine\"] = {}\\ntry:\\n    data[\"checkpoint_manifest\"] = json.load(\\n        open(os.path.join(os.environ[\"FN_PROXY_DIR\"], \"proxy-manifest.json\")))\\nexcept Exception as e:\\n    data[\"checkpoint_manifest\"] = f\"unreadable: {e}\"\\n\\n# --- wait for the API (cold triton compile makes this the long pole) --------\\ndeadline = time.time() + BOOT_TIMEOUT\\nstarted = time.time()\\nready = False\\nwhile time.time() < deadline:\\n    if not container_running():\\n        status = \"fail\"\\n        data[\"error\"] = \"serve container died during boot\"\\n        data[\"serve_log_tail\"] = serve_log_tail()\\n        break\\n    try:\\n        models = [m[\"id\"] for m in get(\"/v1/models\").get(\"data\", [])]\\n        if MODEL in models:\\n            ready = True\\n            break\\n    except Exception:\\n        pass\\n    time.sleep(5)\\ndata[\"serve\"][\"boot_seconds\"] = round(time.time() - started, 1)\\nif not ready and status == \"pass\":\\n    status = \"fail\"\\n    data[\"error\"] = f\"API never answered inside {BOOT_TIMEOUT}s\"\\n    data[\"serve_log_tail\"] = serve_log_tail()\\n\\n# --- one greedy completion, finite logits asserted via the API --------------\\nif ready:\\n    prompt = \"First light on the proxy checkpoint proves \"\\n    try:\\n        r = post(\"/v1/completions\",\\n                 {\"model\": MODEL, \"prompt\": prompt, \"max_tokens\": 16,\\n                  \"temperature\": 0, \"logprobs\": 5})\\n        choice = r[\"choices\"][0]\\n        data[\"completion\"] = {\\n            \"prompt\": prompt,\\n            \"text\": choice[\"text\"],\\n            \"finish_reason\": choice.get(\"finish_reason\"),\\n            \"tokens\": r.get(\"usage\", {}).get(\"completion_tokens\"),\\n        }\\n        # The API-visible face of the logits: every returned logprob value.\\n        values = []\\n        lp = choice.get(\"logprobs\") or {}\\n        for x in lp.get(\"token_logprobs\") or []:\\n            if x is not None:\\n                values.append(float(x))\\n        for top in lp.get(\"top_logprobs\") or []:\\n            for v in (top or {}).values():\\n                if v is not None:\\n                    values.append(float(v))\\n        data[\"logprobs_checked\"] = len(values)\\n        data[\"finite_logits\"] = bool(values) and all(math.isfinite(v)\\n                                                     for v in values)\\n        if not data[\"finite_logits\"]:\\n            status = \"fail\"\\n            data[\"error\"] = data.get(\\n                \"error\", \"no finite logprob values returned — logits not proven finite\")\\n    except Exception as e:\\n        status = \"fail\"\\n        data[\"error\"] = f\"completion failed: {e.__class__.__name__}: {e}\"\\n        data[\"serve_log_tail\"] = serve_log_tail()\\n\\n# --- mmap engagement: the claim is \\'with the mmap path engaged\\' --------------\\nlogtext = \"\\\\n\".join(serve_log_tail(20000)).lower()\\nmentions = logtext.count(\"ple_mmap\")\\ndata[\"mmap\"] = {\"log_mentions\": mentions,\\n                \"engaged\": mentions > 0}\\ndata[\"mmap_engaged\"] = mentions > 0\\nif ready and mentions == 0:\\n    status = \"fail\"\\n    data[\"error\"] = data.get(\\n        \"error\", \"\") + \" | VLLM_PLE_MMAP never shows in the serve log — the table path did not engage\"\\n\\n# --- clean shutdown: SIGTERM, graceful exit code, container removed -----------\\nstop = podman(\"stop\", \"-t\", \"120\", CTR, timeout=240)\\ninsp = podman(\"inspect\", \"-f\", \"{{.State.ExitCode}}\", CTR, timeout=30)\\ntry:\\n    code = int(insp.stdout.strip())\\nexcept Exception:\\n    code = None\\ndata[\"shutdown\"] = {\"clean\": stop.returncode == 0 and code == 0,\\n                    \"exit_code\": code}\\nif not data[\"shutdown\"][\"clean\"]:\\n    status = \"fail\"\\n    data[\"error\"] = data.get(\"error\", \"\") + \\\\\\n        f\" | unclean shutdown (stop rc={stop.returncode}, exit={code})\"\\npodman(\"rm\", \"-f\", CTR)\\n\\n# --- the receipt: results/receipts/proxy.json --------------------------------\\nreceipt = {\"step\": \"proxy\", \"status\": status,\\n           \"ts\": time.strftime(\"%FT%T\"), \"data\": data}\\nwith open(os.environ[\"FN_OUT\"], \"w\") as f:\\n    json.dump(receipt, f, indent=1)\\nprint(f\"run-proxy: proxy receipt ({status}): {os.environ[\\'FN_OUT\\']}\",\\n      file=sys.stderr)\\nsys.exit(0 if status == \"pass\" else 1)\\nPY\\n# A non-zero exit above means the step failed; the ERR trap has recorded the\\n# fail receipt (or kept the one the python stage wrote) and cleaned up.\\ncleanup_container\\nlog \"receipt: $OUT\"\\n' : is-set probe VLLM_USE_DEEP_GEMM in run-proxy.sh\n\ntests/test_proxy_tooling.py:69: AssertionError\n=========================== short test summary info ============================\nFAILED tests/test_proxy_tooling.py::ProxyTooling::test_no_is_set_probe_exports\n1 failed, 46 passed in 0.18