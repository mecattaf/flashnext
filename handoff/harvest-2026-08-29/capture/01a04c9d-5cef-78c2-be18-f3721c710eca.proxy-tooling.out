/flashnext/cac9adc5400c/proxy-tooling && python3 - <<'EOF'\np = 'scripts/make-proxy.sh'\nsrc = open(p).read()\n\ndef rep(old, new, label):\n    global src\n    assert src.count(old) == 1, f\"BAD: {label}\"\n    src = src.replace(old, new)\n    print(\"ok:\", label)\n\nrep('''            fused_map[base] = [(pt, sz) for pt, sz in pairs]''',\n'''            fused_map[base] = (mod_path, [(pt, sz) for pt, sz in pairs])''',\n\"fused_map stores mod_path\")\n\nrep('''                if base in fused_map:\n                    for part, rows in fused_map[base]:\n                        write_linear(f\"{base}.{part}\", (rows, shape[1]))\n                    continue''',\n'''                if base in fused_map:\n                    mod_path, pairs = fused_map[base]\n                    for part, rows in pairs:\n                        write_linear(f\"{mod_path}.{part}\", (rows, shape[1]))\n                    continue''',\n\"write at mod_path\")\n\nopen(p, 'w').write(src)\nprint(\"DONE\")\nEOF\nbash -n scripts/make-proxy.sh && bash scripts/make-proxy.sh 2>&1 | tail -2 && python3 -c \"\nimport json, struct, pathlib\nf = pathlib.Path.home()/'.local/state/flashnext/proxy-checkpoint/model-00001-of-00001.safetensors'\nn = struct.unpack('<Q', open(f,'rb').read(8))[0]\nh = json.loads(open(f,'rb').read()[8:8+n])\nla = sorted(x for x in h if 'layers.0.linear_attn' in x and 'in_proj' in x)\nprint({x: h[x]['shape'] for x in la})\nhc = sorted(x for x in h if 'attn_hyper_connection' in x and 'layers.0' in x)\nprint({x: h[x]['shape'] for x in hc})\nprint('total:', len(h))\n\"","timeout":600}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":1489,"output":967,"cacheRead":253952,"cacheWrite":0,"reasoning":417,"totalTokens":256408,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787997014987,"responseId":"chatcmpl-48593127-bcd0-4893-b7c0-fdc87dee00f0","rawStopReason":"tool_calls"},"toolResul