{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"\n[{\"newText\": \"        mc = ModelConfig(model=str(OUT))\\n        vc = VllmConfig(model_config=mc)\\n        # The QSA full-attention path probes FlashAttention availability, and\\n        # the probe wants an initialized HIP device even though the model\\n        # itself lands on meta.\\n        try:\\n            torch.cuda.init()\\n        except Exception:\\n            pass\\n        with set_current_vllm_config(vc):\", \"oldText\": \"        mc = ModelConfig(model=str(OUT))\\n        vc = VllmConfig(model_config=mc)\\n        with set_current_vllm_config(vc):\"}]\n\n"}}
