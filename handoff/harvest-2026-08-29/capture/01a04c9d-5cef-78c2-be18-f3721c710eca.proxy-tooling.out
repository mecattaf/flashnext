 ngram_row_bytes(cfg)\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]","oldText":"    Values are fp8 zeros at scale 1.0: the PLE contribution is exactly zero,\n    which is finite by construction.\"\"\"\n    HD = int(cfg.get(\"head_dim\", 256))\n    rows, split = geom[\"rows_per_shard\"], geom[\"split\"]"},{"newText":"            save_safetensors(\n                OUT / f\"model-ple-{layer}-{s:05d}.safetensors\",\n                {name: _fp8(torch.zeros(rows, rb))})","oldText":"            save_safetensors(\n                OUT / f\"model-ple-{layer}-{s:05d}.safetensors\",\n                {name: _fp8(torch.zeros(rows, HD))})"}],"path":"/home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/make-proxy.sh"}}],"api":"openai-completions","provider":"qwen-token-plan","model":"qwen3.8-max","usage":{"input":2200,"output":1399,"cacheRead":142336,"cacheWrite":0,"reasoning":856,"totalTokens":145935,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1787994023564,"responseId":"chatcmpl-5635fab7-3a02-427c-98fe-d266f494d07e","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_f732f99ada6846e7bafed40d","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 3 block(s) in /home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/make-proxy.sh."}],"details":{"diff":"     ...\n 307         MANIFEST[\"scaffold\"][\"fork_modules_probed\"].append(entry)\n 308     return ple_mmap\n 309 \n 310 \n+311 def ngram_row_bytes(cfg):\n+312     \"\"\"Row width of the mmap table. The PLE layer builds its embedding at\n+313     (padded_vocab_size, self.head_dim) per specs/flashnext/evidence/\n+314     ple-54129.md section 3; the PLE head_dim is heads_per_ngram x\n+315     ple_embed_dim when both geometry fields are present, and the attention\n+316     head_dim is the fallback.\"\"\"\n+317     heads = cfg.get(\"heads_per_ngram\")\n+318     dim = cfg.get(\"ple_embed_dim\")\n+319     if isinstance(heads, int) and isinstance(dim, int):\n+320         return heads * dim\n+321     return int(cfg.get(\"head_dim\", 256))\n+322 \n+323 \n 311 def ngram_geometry(cfg):\n 312     \"\"\"Mirror the loader's shard mapping (specs/flashnext/evidence/\n 313     ple-54129.md section 3): shard_size = ceil(org / split); the checkpoint\n 314     carries ceil(org / shard_size) row-block tensors per PLE layer.\"\"\"\n     ...\n 472     \"\"\"One row-block tensor per shard under the discover_shards naming, plus\n 473     the per-layer global weight_scale the load_weights interception keeps.\n 474     Values are fp8 zeros at scale 1.0: the PLE contribution is exactly zero,\n 475     which is finite by construction.\"\"\"\n-476     HD = int(cfg.get(\"head_dim\", 256))\n+489     rb = ngram_row_bytes(cfg)\n 477     rows, split = geom[\"rows_per_shard\"], geom[\"split\"]\n 478     files = 0\n 479     scale = _f32(torch.ones(1))\n 480     main = {}\n     ...\n 483             name = (f\"model.layers.{layer}.ple.ple_embedding.\"\n 484                     f\"ngram_embedding.shard_{s:05d}.weight\")\n 485             save_safetensors(\n 486                 OUT / f\"model-ple-{layer}-{s:05d}.safetensors\",\n-487                 {name: _fp8(torch.zeros(rows, HD))})\n+500                 {name: _fp8(torch.zeros(rows, rb))})\n 488             files += 1\n 489         main[f\"model.layers.{layer}.ple.ple_embedding.\"\n 490              f\"ngram_embedding.weight_scale\"] = scale\n 491     return files, main\n     ...","patch":"--- /home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/make-proxy.sh\n+++ /home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/scripts/make-proxy.sh\n@@ -307,8 +307,21 @@\n         MANIFEST[\"scaffold\"][\"fork_modules_probed\"].append(entry)\n     return ple_mmap\n \n \n+def ngram_row_bytes(cfg):\n+    \"\"\"Row width of the mm