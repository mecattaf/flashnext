{"type":"message_update","assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_8c59e742e14941be9a210ec6","name":"edit","arguments":{"edits":[{"newText":"    def test_no_is_set_probe_exports(self):\n        # Spec F.9 (mirrored from host/fn-env.sh): never export a default the\n        # engine reads through an is-set probe — exporting the value it\n        # already has diverts the fp8 oracle into a hard raise. Check the\n        # directive lines, not the prose that explains the discipline.\n        probes = (\"VLLM_USE_DEEP_GEMM\", \"VLLM_MOE_USE_DEEP_GEMM\",\n                  \"VLLM_ROCM_USE_AITER\")\n        for name, text in ((\"make-proxy.sh\", self.make),\n                           (\"run-proxy.sh\", self.run)):\n            directives = [ln for ln in text.splitlines()\n                          if re.match(r\"\\s*(-e\\s+|--env\\S*\\s+|export\\s+)\", ln)]\n            joined = \"\\n\".join(directives)\n            for probe in probes:\n                self.assertNotIn(probe, joined,\n                                 f\"is-set probe {probe} exported in {name}\")","oldText":"    def test_no_is_set_probe_exports(self):\n        # Spec F.9 (mirrored from host/fn-env.sh): never export a default the\n        # engine reads through an is-set probe — exporting the value it\n        # already has diverts the fp8 oracle into a hard raise.\n        for probe in (\"VLLM_USE_DEEP_GEMM\", \"VLLM_MOE_USE_DEEP_GEMM\",\n                      \"VLLM_ROCM_USE_AITER\"):\n            for name, text in ((\"make-proxy.sh\", self.make),\n                               (\"run-proxy.sh\", self.run)):\n                self.assertNotIn(probe, text,\n                                 f\"is-set probe {probe} in {name}\")"}],"path":"/home/tom/.local/state/tally/campaigns/flashnext/flashnext/cac9adc5400c/proxy-tooling/tests/test_proxy_tooling.py"}}}}
