TALLY_FINAL_MESSAGE={"available":true,"baseRev":"a428fee66b83d95682b418d5fdb4d975068e66ab","head":"d89f338f1e74622415022809f9becb28b73f86fa","patch":"diff --git a/container/Containerfile b/container/Containerfile\nnew file mode 100644\nindex 0000000..18c1c02\n--- /dev/null\n+++ b/container/Containerfile\n@@ -0,0 +1,147 @@\n+# flashnext:dev — the engine fork built from source at the exactly pinned wheel set\n+# ============================================================================\n+#\n+# Recipe shape adapted from kyuz0/amd-strix-halo-vllm-toolboxes,\n+# `Dockerfile.ubuntu-repoamd` @ 23cb726, credited per THIRD_PARTY_NOTICES.md.\n+# That recipe is MIT licensed; the notice is retained here as required:\n+#\n+#   MIT License — Copyright (c) kyuz0 (amd-strix-halo-vllm-toolboxes)\n+#\n+#   Permission is hereby granted, free of charge, to any person obtaining a\n+#   copy of this software and associated documentation files (the \"Software\"),\n+#   to deal in the Software without restriction, including without limitation\n+#   the rights to use, copy, modify, merge, publish, distribute, sublicense,\n+#   and/or sell copies of the Software, and to permit persons to whom the\n+#   Software is furnished to do so, subject to the following conditions:\n+#\n+#   The above copyright notice and this permission notice shall be included in\n+#   all copies or substantial portions of the Software.\n+#\n+#   THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n+#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n+#   DEALINGS IN THE SOFTWARE.\n+#\n+# What changed vs the donor recipe (per IMPORTS.md sections 1 and 2):\n+#   - torch is pinned to the fork's exact pin 2.13.0+rocm7.14.0 from the AMD\n+#     stable multi-arch index (the index tops out there; no ROCm 10 wheels\n+#     exist for gfx1151 — specs/flashnext/evidence/kyuz0-rocm10.md).\n+#   - torchaudio is OMITTED; we drop the audio extra rather than downgrade\n+#     torch to 2.11 (torchaudio capped kyuz0's auto-resolved set there).\n+#   - the engine is the flashnext fork (mecattaf/vllm, branch flashnext),\n+#     built from source for gfx1151, not a stock vLLM ref.\n+#   - designed for overnight iteration: bind-mount a fork checkout over\n+#     /opt/vllm and a host dir over /root/.ccache (see container/build.sh);\n+#     the editable install then recompiles only what a one-line patch touched.\n+#\n+# Wheel provenance: the torch/triton/vision/rocm-sdk substrate comes ONLY\n+# from the vendor stable index (spec F.11). Generic Python build tooling\n+# (setuptools, wheel, packaging, setuptools-scm) and vLLM's upstream runtime\n+# dependencies resolve from PyPI as upstream vLLM does; none of those is part\n+# of the pinned substrate.\n+\n+FROM docker.io/ubuntu:24.04\n+\n+ARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n+# The exactly pinned wheel set (IMPORTS.md section 1). The triton pin is the\n+# wheel accompanying the torch 2.13.0 set on the vendor stable index —\n+# verified by pip's own resolver: torch 2.13.0+rocm7.14.0 depends on exactly\n+# triton==3.8.0+git4cff872c.rocm7.14.0 (anything else is ResolutionImpossible).\n+# < 3.8 awareness (IMPORTS.md): the fork's fp8-upcast gate keys on triton < 3.8,\n+# so on this wheel the admission stands but the in-kernel upcast is bypassed —\n+# fp8 dots ride triton 3.8's own lowering, and the fidelity checkpoint grades it.\n+ARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\n+ARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\n+ARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n+# The from-source engine build needs the HIP compiler + cmake packages, which\n+# the runtime wheels do not pull in; devel files merge into _rocm_sdk_core.\n+ARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n+# The generic torch/torchvision wheels carry no device kernels; gfx1151 kernel\n+# images ship as separate device packages (torch loads them from torch/.kpack/).\n+# Without these the first kernel launch dies with hipErrorInvalidImage.\n+ARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n+\n+ENV DEBIAN_FRONTEND=noninteractive\n+RUN apt-get update && apt-get install -y --no-install-recommends \\\n+        python3.12 python3.12-venv python3.12-dev \\\n+        git ca-certificates curl \\\n+        build-essential cmake ninja-build ccache \\\n+        cargo rustc libnuma-dev \\\n+    && rm -rf /var/lib/apt/lists/*\n+\n+# Python 3.12 venv at /opt/venv (pip arrives via ensurepip — no external fetch).\n+RUN python3.12 -m venv /opt/venv\n+ENV VIRTUAL_ENV=/opt/venv \\\n+    PATH=/opt/venv/bin:$PATH \\\n+    PIP_NO_CACHE_DIR=0 \\\n+    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n+    CCACHE_DIR=/root/.ccache \\\n+    HOME=/root\n+\n+# Python build tooling (setuptools is served by the vendor index itself; the\n+# rest is generic build-time tooling, not substrate).\n+RUN pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \\\n+        setuptools wheel packaging \"setuptools-scm>=8.0\" setuptools-rust\n+\n+# ---- the pinned wheel substrate (vendor stable index only, spec F.11) ----\n+RUN pip install --index-url ${ROCM_WHL} \\\n+        ${TORCH_PIN} ${TORCHVISION_PIN} ${TRITON_PIN} ${ROCM_DEVEL_PIN} ${DEVICE_PINS}\n+\n+# ---- the engine fork, built from source for gfx1151 ----\n+ARG VLLM_REPO=https://github.com/mecattaf/vllm\n+ARG VLLM_BRANCH=flashnext\n+ENV VLLM_TARGET_DEVICE=rocm \\\n+    PYTORCH_ROCM_ARCH=gfx1151\n+\n+# If a host fork checkout is bind-mounted over /opt/vllm (build.sh -v), keep\n+# it — that is the incremental-iteration path. Otherwise clone the baseline.\n+RUN if [ ! -d /opt/vllm/.git ]; then \\\n+        git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm /opt/vllm; \\\n+    fi \\\n+    && git -C /opt/vllm rev-parse HEAD > /opt/flashnext-fork-commit \\\n+    && git -C /opt/vllm rev-parse --abbrev-ref HEAD >> /opt/flashnext-fork-commit\n+\n+# Editable, no build isolation: the build links against the venv's pinned\n+# torch and never resolves build-system.requires (the fork's torch==2.11.0\n+# build-system pin is therefore irrelevant here — IMPORTS.md section 1).\n+# Build artifacts land inside /opt/vllm, so a bind-mounted checkout keeps\n+# them across rebuilds and ccache (on PATH, auto-detected by vLLM's cmake)\n+# recompiles only what changed.\n+RUN pip install -e /opt/vllm --no-build-isolation\n+\n+# ---- the fn_ instrument overlay ----\n+# Lands the instrument modules importable at the top level of site-packages.\n+COPY container/rootfs/ /opt/venv/lib/python3.12/site-packages/\n+\n+# ---- build identity ----\n+RUN mkdir -p /opt/flashnext && python3 - <<'PY'\n+import json, time, importlib.metadata as md\n+def ver(name):\n+    try:\n+        return md.version(name)\n+    except md.PackageNotFoundError:\n+        return \"unknown\"\n+lines = open(\"/opt/flashnext-fork-commit\").read().splitlines()\n+info = {\n+    \"lane\": \"container\",\n+    \"image\": \"flashnext:dev\",\n+    \"fork_repo\": \"https://github.com/mecattaf/vllm\",\n+    \"fork_commit\": lines[0],\n+    \"fork_branch\": lines[1] if len(lines) > 1 else \"flashnext\",\n+    \"torch\": md.version(\"torch\"),\n+    \"torchvision\": md.version(\"torchvision\"),\n+    \"triton\": md.version(\"triton\"),\n+    \"rocm_sdk_core\": ver(\"rocm-sdk-core\"),\n+    \"amd_torch_device_gfx1151\": ver(\"amd-torch-device-gfx1151\"),\n+    \"gpu_target\": \"gfx1151\",\n+    \"built_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"),\n+}\n+json.dump(info, open(\"/opt/flashnext/build-info.json\", \"w\"), indent=1)\n+PY\n+RUN cat /opt/flashnext/build-info.json\n+\n+WORKDIR /opt/vllm\n+CMD [\"bash\"]\ndiff --git a/container/build.sh b/container/build.sh\nnew file mode 100755\nindex 0000000..dd6b2cd\n--- /dev/null\n+++ b/container/build.sh\n@@ -0,0 +1,110 @@\n+#!/usr/bin/env bash\n+# Container engine build — flashnext:dev (the ruling P4 container lane).\n+#\n+# Order per the task: packaging tests first, then the image build, then the\n+# build receipt. Any error lands a receipt with status \"fail\" — the receipts\n+# gate grades this step, so failure is recorded, never silent.\n+#\n+# Overnight-iteration hooks (see container/Containerfile header):\n+#   FN_VLLM_SRC=/path/to/vllm-checkout   bind-mount the fork source over\n+#                                        /opt/vllm; the editable install's\n+#                                        build artifacts persist there, so a\n+#                                        one-line patch rebuild recompiles\n+#                                        only what changed.\n+#   FN_CCACHE_DIR=/path/to/ccache        host compiler cache (default\n+#                                        .build/ccache next to this repo),\n+#                                        mounted at /root/.ccache.\n+#   FN_IMAGE=name:tag                    image tag (default flashnext:dev).\n+#\n+# Enter the image for edit-and-restart iteration without a rebuild:\n+#   podman run --rm -it --device /dev/kfd --device /dev/dri \\\n+#     --security-opt seccomp=unconfined --ipc=host \\\n+#     -v \"$FN_VLLM_SRC:/opt/vllm\" flashnext:dev bash\n+#   # inside: edit, then `pip install -e /opt/vllm --no-build-isolation`\n+set -euo pipefail\n+\n+REPO_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n+cd \"$REPO_ROOT\"\n+\n+IMAGE=\"${FN_IMAGE:-flashnext:dev}\"\n+OUT=\"$REPO_ROOT/results/receipts/build.json\"\n+CCACHE_DIR_HOST=\"${FN_CCACHE_DIR:-$REPO_ROOT/.build/ccache}\"\n+PIP_CACHE_HOST=\"${FN_PIP_CACHE_DIR:-$REPO_ROOT/.build/pip-cache}\"\n+\n+STATUS=\"pass\"\n+TORCH=\"\" TRITON=\"\" FORK_COMMIT=\"\" IMAGE_DIGEST=\"\"\n+START_EPOCH=\"$(date +%s)\"\n+\n+write_receipt() {\n+    local status=\"$1\"\n+    local wall=$(( $(date +%s) - START_EPOCH ))\n+    mkdir -p \"$(dirname \"$OUT\")\"\n+    FN_STATUS=\"$status\" FN_TS=\"$(date -u +%FT%TZ)\" FN_WALL=\"$wall\" \\\n+    FN_TORCH=\"$TORCH\" FN_TRITON=\"$TRITON\" FN_FORK=\"$FORK_COMMIT\" \\\n+    FN_DIGEST=\"$IMAGE_DIGEST\" FN_IMAGE_NAME=\"$IMAGE\" python3 - \"$OUT\" <<'PY'\n+import json, os, sys\n+r = {\n+    \"step\": \"build\",\n+    \"status\": os.environ[\"FN_STATUS\"],\n+    \"ts\": os.environ[\"FN_TS\"],\n+    \"data\": {\n+        \"lane\": \"container\",\n+        \"image\": os.environ[\"FN_IMAGE_NAME\"],\n+        \"torch\": os.environ[\"FN_TORCH\"] or None,\n+        \"triton\": os.environ[\"FN_TRITON\"] or None,\n+        \"fork_commit\": os.environ[\"FN_FORK\"] or None,\n+        \"image_digest\": os.environ[\"FN_DIGEST\"] or None,\n+        \"wall_clock_s\": int(os.environ[\"FN_WALL\"]),\n+    },\n+}\n+json.dump(r, open(sys.argv[1], \"w\"), indent=1)\n+print(f\"build receipt ({os.environ['FN_STATUS']}): {sys.argv[1]}\")\n+PY\n+}\n+\n+on_error() {\n+    echo \"container/build.sh: FAILED — writing fail receipt\" >&2\n+    STATUS=\"fail\"\n+    write_receipt \"fail\" || true\n+    exit 1\n+}\n+trap on_error ERR\n+\n+echo \"==> packaging tests first\"\n+python3 -m unittest discover -s \"$REPO_ROOT/tests\"\n+\n+echo \"==> rootfs overlay stage (instruments land here when present)\"\n+mkdir -p \"$REPO_ROOT/container/rootfs\"\n+[ -e \"$REPO_ROOT/container/rootfs/.keep\" ] || touch \"$REPO_ROOT/container/rootfs/.keep\"\n+\n+echo \"==> caches\"\n+mkdir -p \"$CCACHE_DIR_HOST\" \"$PIP_CACHE_HOST\"\n+\n+BUILD_ARGS=(--tag \"$IMAGE\" --file container/Containerfile\n+            --volume \"$CCACHE_DIR_HOST:/root/.ccache\"\n+            --volume \"$PIP_CACHE_HOST:/root/.cache/pip\")\n+if [ -n \"${FN_VLLM_SRC:-}\" ]; then\n+    echo \"==> bind-mounting fork checkout: $FN_VLLM_SRC -> /opt/vllm\"\n+    BUILD_ARGS+=(--volume \"$FN_VLLM_SRC:/opt/vllm\")\n+fi\n+\n+echo \"==> podman build $IMAGE\"\n+podman build \"${BUILD_ARGS[@]}\" \"$REPO_ROOT\"\n+\n+echo \"==> reading build identity from the image\"\n+BUILD_INFO=\"$(podman run --rm --entrypoint /usr/bin/env \"$IMAGE\" \\\n+    cat /opt/flashnext/build-info.json)\"\n+echo \"$BUILD_INFO\"\n+TORCH=\"$(echo \"$BUILD_INFO\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"torch\"])')\"\n+TRITON=\"$(echo \"$BUILD_INFO\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"triton\"])')\"\n+FORK_COMMIT=\"$(echo \"$BUILD_INFO\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"fork_commit\"])')\"\n+\n+IMAGE_DIGEST=\"$(podman inspect --format '{{.Digest}}' \"$IMAGE\" 2>/dev/null || true)\"\n+if [ -z \"$IMAGE_DIGEST\" ]; then\n+    # Local builds carry no registry digest; the image id is the stable name.\n+    IMAGE_DIGEST=\"$(podman inspect --format '{{.Id}}' \"$IMAGE\")\"\n+fi\n+\n+write_receipt \"$STATUS\"\n+python3 -c \"import json,sys; sys.exit(0 if json.load(open('$OUT'))['status']=='pass' else 1)\"\n+echo \"==> flashnext:dev built; receipt: $OUT\"\ndiff --git a/container/rootfs/.keep b/container/rootfs/.keep\nnew file mode 100644\nindex 0000000..6387ced\n--- /dev/null\n+++ b/container/rootfs/.keep\n@@ -0,0 +1,3 @@\n+# Marker: the instruments task lands fn_synctrace.py, fn_offload_batch.py and\n+# fn_expert_union.py here; container/build.sh ensures this directory exists\n+# so the Containerfile's COPY of the overlay is well-formed either way.\ndiff --git a/results/receipts/build.json b/results/receipts/build.json\nnew file mode 100644\nindex 0000000..53989f1\n--- /dev/null\n+++ b/results/receipts/build.json\n@@ -0,0 +1,14 @@\n+{\n+ \"step\": \"build\",\n+ \"status\": \"pass\",\n+ \"ts\": \"2026-08-29T07:07:21Z\",\n+ \"data\": {\n+  \"lane\": \"container\",\n+  \"image\": \"flashnext:dev\",\n+  \"torch\": \"2.13.0+rocm7.14.0\",\n+  \"triton\": \"3.8.0+git4cff872c.rocm7.14.0\",\n+  \"fork_commit\": \"bdb6f0420e797de9266de593326368091085cc3b\",\n+  \"image_digest\": \"sha256:175edc169402e327c4eed823caec30d196b7f824712e3a498333da87282f24de\",\n+  \"wall_clock_s\": 839\n+ }\n+}\n\\ No newline at end of file\ndiff --git a/./.build/build.log b/./.build/build.log\nnew file mode 100644\nindex 0000000..ef4c9fb\n--- /dev/null\n+++ b/./.build/build.log\n@@ -0,0 +1,1699 @@\n+==> packaging tests first\n+.........\n+----------------------------------------------------------------------\n+Ran 9 tests in 0.650s\n+\n+OK\n+==> rootfs overlay stage (instruments land here when present)\n+==> caches\n+==> podman build flashnext:dev\n+STEP 1/23: FROM docker.io/ubuntu:24.04\n+STEP 2/23: ARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/\n+--> Using cache d5257090b1224c897c2608ad60420ad6af3c4f2646b7459e573402215939a8a9\n+--> d5257090b122\n+STEP 3/23: ARG TORCH_PIN=\"torch==2.13.0+rocm7.14.0\"\n+--> Using cache a5a3ea77d9cfa2f7a85efaaabe8899c203022a004bdc7889761828edf45aec68\n+--> a5a3ea77d9cf\n+STEP 4/23: ARG TORCHVISION_PIN=\"torchvision==0.28.0+rocm7.14.0\"\n+--> Using cache d4b021e37b31d8f2626f95928c7925528d7c197add463a29aedb4719d5d415f4\n+--> d4b021e37b31\n+STEP 5/23: ARG TRITON_PIN=\"triton==3.8.0+git4cff872c.rocm7.14.0\"\n+--> Using cache 96de71d0f88318406b35da23776b581039f6f9e4780f1af53e7dd2e68c14a54e\n+--> 96de71d0f883\n+STEP 6/23: ARG ROCM_DEVEL_PIN=\"rocm-sdk-devel==7.14.0\"\n+--> Using cache 875cf1f93265ee59c011bec58ce910d0d992592d754b2120d8968bfb0ddeee8d\n+--> 875cf1f93265\n+STEP 7/23: ARG DEVICE_PINS=\"amd-torch-device-gfx1151==2.13.0+rocm7.14.0 amd-torchvision-device-gfx1151==0.28.0+rocm7.14.0 rocm-sdk-device-gfx1151==7.14.0\"\n+--> 4bc94de7841d\n+STEP 8/23: ENV DEBIAN_FRONTEND=noninteractive\n+--> f647f8f04bbf\n+STEP 9/23: RUN apt-get update && apt-get install -y --no-install-recommends         python3.12 python3.12-venv python3.12-dev         git ca-certificates curl         build-essential cmake ninja-build ccache         cargo rustc libnuma-dev     && rm -rf /var/lib/apt/lists/*\n+