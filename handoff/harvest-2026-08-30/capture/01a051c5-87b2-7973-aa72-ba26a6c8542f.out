3a8882e61c9b2ce9","revision":"sha256:3a8882e61c9b2ce9ef7a7904e06778f0284df952e4a68deb4f8e6e1caba1a225","taskId":"bench-harness"},{"mergeCommit":"6e818349eeb947501ac04ba83e826764a042011c","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/proxy-tooling-9cb06ca07951b228","revision":"sha256:9cb06ca07951b2287bda5724f848b7f77a439185529991cf017a8022957d13a8","taskId":"proxy-tooling"},{"mergeCommit":"bfd358b923b35a4a80dad2163d7e8ec16aaf81b6","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/morning-ledger-27a15022aaf7c70c","revision":"sha256:27a15022aaf7c70c3c32d63b27cf07bf64e1e0097b435707dd270c06ab414996","taskId":"morning-ledger"},{"mergeCommit":"377ba269689b458c10903c86e579816d39478b34","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/catalog-handoff-7f3033dbd7a5c6b6","revision":"sha256:7f3033dbd7a5c6b695b70874814d89053eec1372194895793dc8534f9f4d03ed","taskId":"catalog-handoff"},{"mergeCommit":"0a89657f40b8654fed9a050b77458f46f0e5c559","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/rdma-package-fe9122567f61a3ff","revision":"sha256:fe9122567f61a3ff2f0fa2ba872e08f885158cdaa3d584270bd72b3302f22bbc","taskId":"rdma-package"},{"mergeCommit":"bdc42fc2d0a44bc934845e3aa65421ba51b94721","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/usb4stream-bench-75b32ae929f161f9","revision":"sha256:75b32ae929f161f972eb9544f33d653ee19a939a595012f6c112e3c4e69bb00e","taskId":"usb4stream-bench"}],"checkpoints":[{"ref":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-weights-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a/6e818349eeb947501ac04ba83e826764a042011c","revision":"6e818349eeb947501ac04ba83e826764a042011c","taskId":"cp-weights"},{"ref":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-build-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a/6e818349eeb947501ac04ba83e826764a042011c","revision":"6e818349eeb947501ac04ba83e826764a042011c","taskId":"cp-build"}],"remaining":["cp-smoke","cp-proxy","cp-tp2","cp-bench","cp-close","cp-usb4stream","rocm10-probe"],"frontier":[],"diagnoses":[{"attempt":1,"comment":"local://campaign/flashnext/attempt-receipts/49","diagnosis":"Traced checkpoint cp-smoke's exit 1 to a stdin-plumbing defect in scripts/run-smoke.sh, not to any probe logic: the podman invocation at scripts/run-smoke.sh:10 omits -i, so the heredoc body never reaches the container's `python3 -`. Evidence: (1) the capture for this attempt (/home/tom/.local/state/tally/capture/archive/01a051b2-032b-70c0-af16-724b46f58392.cp-smoke/checkpoint.json) contains exactly one stdout line, the trailing `smoke receipt: ...` echo, and zero container stdout even though the embedded program unconditionally prints `json.dumps(r, indent=1)`; stderr is empty, so no probe ever raised. (2) No receipt exists anywhere in the worktree: results/receipts/ holds build.json, weights-coordinator.json, weights-worker.json and no smoke.json, and results/receipts/failed/ was never created, so the container wrote nothing at all. (3) The trailing validator then exits 1 solely because results/receipts/smoke.json is absent — that is the observed exit code, with a clean `git status` and head == baseRev 6e818349eeb947501ac04ba83e826764a042011c. (4) Reproduced the mechanism directly: `podman run --rm docker.io/library/ubuntu:24.04 cat - <<EOF` prints nothing, while the same command with -i prints the heredoc line; podman does not attach stdin without -i or -a stdin, so `python3 -` reads an empty program, does nothing, and exits 0 under set -euo pipefail. (5) This is not a regression from the authorized fix: `git log -- scripts/run-smoke.sh` shows the podman line has lacked -i in all four revisions (9a31e0b, 520f24b, 9480958, 7509202), and all four archived cp-smoke captures (01a05114, 01a05128, 01a05150, 01a051b2) show the byte-identical single-line stdout and exit 1. The admission-probe TypeError repaired at 7509202 was found by manual in-container repro and is real, but it could never have been reached by the checkpoint command itself, so steering notes 6 and 8 authorized a retry against a cause that was not the one firing here. Nothing in the container, the GPU aperture, or the image is implicated: localhost/flashnext:dev exists and cp-build passed. The fix is a one-token source edit outside this checkpoint's authority — checkpoints must not modify the repository and never retry — hence blocked. Note the identical defect in scripts/make-proxy.sh:116, whose heredoc-to-`python3 -` invocation also omits -i and will fail the same silent way when the proxy checkpoint runs.\n\nCheckpoint capture: /home/tom/.local/state/tally/capture/archive/01a051b2-032b-70c0-af16-724b46f58392.cp-smoke/checkpoint.json","proposal":{"acceptanceCriteria":[{"argv":["bash","-c","grep -n 'podman run' scripts/run-smoke.sh | grep -Eq -- ' (-i|--interactive|-a stdin)( |$)'"],"description":"The smoke script's podman invocation attaches stdin, so the heredoc program is delivered to the container instead of being discarded.","id":"heredoc-reaches-container"},{"argv":["bash","scripts/run-smoke.sh"],"description":"scripts/run-smoke.sh executes the five probes in-container and exits 0.","id":"smoke-runs-and-passes"},{"argv":["python3","-c","import [redacted-token] d['status']=='pass',d;assert set(d['data'])>={'arch','fp8_cast','registry','aperture','admission'},d"],"description":"results/receipts/smoke.json exists with status pass and records all five probes.","id":"pass-receipt-present"},{"argv":["bash","-c","bash scripts/run-smoke.sh && git diff --quiet && git diff --cached --quiet"],"description":"A second run over the already-correct base leaves every tracked file byte-identical, satisfying the checkpoint-purity contract.","id":"rerun-is-pure"},{"argv":["bash","-c","grep -n 'podman run' scripts/make-proxy.sh | grep -Eq -- ' (-i|--interactive|-a stdin)( |$)'"],"description":"scripts/make-proxy.sh's podman invocation also attaches stdin, so its heredoc is not silently discarded.","id":"proxy-builder-stdin-fixed"}],"dependencies":["cp-build"],"goal":"Make the container heredocs actually execute. In scripts/run-smoke.sh, add -i (or -a stdin) to the `podman run` invocation on line 10 so the `python3 -` heredoc body is delivered to the container; apply the same fix to the `podman run` invocation at scripts/make-proxy.sh:116, which has the identical silent-no-op defect. Add no other behavioral change: the five probes (arch, fp8_cast, registry, aperture, admission), the D12 failed/ quarantine, the receipt-restore purity guard, and the trailing validator all stay as written. After the fix, `bash scripts/run-smoke.sh` must run the probes in-container, print the receipt JSON, land results/receipts/smoke.json with status pass (or a fail receipt under results/receipts/failed/ if a probe genuinely fails), and exit 0; a second run over the already-correct base must leave every tracked file byte-identical per the checkpoint-purity note. Commit the receipt inside the lane commit so the later cp-smoke checkpoint re-run is a pure validator.","kind":"amendment-task","paths":["scripts/run-smoke.sh","scripts/make-proxy.sh","results/receipts/smoke.json"]},"taskId":"cp-smoke","verdict":"blocked"}],"retries":[],"outcomes":[],"deferrals":[],"blocked":[{"blockedBy":["cp-smoke"],"taskId":"cp-smoke"},{"blockedBy":["cp-smoke"],"taskId":"cp-proxy"},{"blockedBy":["cp-smoke"],"taskId":"cp-tp2"},{"blockedBy":["cp-smoke"],"taskId":"cp-bench"},{"blockedBy":["cp-smoke"],"taskId":"cp-close"},{"blockedBy":["cp-smoke"],"taskId":"cp-usb4stream"},{"blockedBy":["cp-smoke"],"taskId":"rocm10-probe"}],"quiescent":true,"escalation":"local://campaign/flashnext/attempt-receipts/50","closingSummary":null,"warnings":["campaign pardon local://campaign/flashnext/attempt-receipts/44 pardoned 1 earlier machine receipt(s) for task(s) 'cp-weights', 'proxy-tooling'"]},"maintenance":{"blockingJobs":[],"cleaned":["pass:/home/tom/.local/state/tally/campaigns/flashnext/.state/passes/d61e9adb6535.json"],"currentRunHash":"6cc007678eb7","liveRuns":[],"warnings":[]},"checkpoints":[],"merged":[],"published":{"action":"already-published","baseBranch":"main","integrationHead":"6e818349eeb947501ac04ba83e826764a042011c","provenHead":"6e818349eeb947501ac04ba83e826764a042011c","reason":"the gate-proven head 6e818349eeb947501ac04ba83e826764a042011c is already reachable from main","receipt":{"actor":"spec-build-driver","baseBranch":"main","campaign":"flashnext","provenBy":{"reference":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-weights-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a/6e818349eeb947501ac04ba83e826764a042011c","taskId":"cp-weights"},"schemaVersion":1,"sha":"6e818349eeb947501ac04ba83e826764a042011c","writtenAt":"2026-08-30T08:25:01.762Z"},"receiptRef":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/publish/6e818349eeb947501ac04ba83e826764a042011c","regateRequired":false,"sha":"6e818349eeb947501ac04ba83e826764a042011c"},"failures":[],"diagnoses":[],"retries":[],"outcomes":[],"deferrals":[],"continuation":null,"escalation":null}}}
