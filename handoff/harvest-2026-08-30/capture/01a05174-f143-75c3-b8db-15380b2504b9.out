ms\",\"details\":{\"adapter\":\"spec-build-driver\",\"attempt\":1,\"taskUuid\":\"01a0516e-f9d2-7011-9650-d602023a0bc5\",\"timeoutMs\":10000,\"exitEvidencePassed\":false,\"verdict\":\"failed\",\"exitCode\":1,\"stderrTail\":\"spec-build-driver: checkpoint command changed tracked files instead of validating the prepared base\",\"stderrTruncated\":false,\"projectionTimeoutMessage\":\"configured finalMessage capture for adapter \\\"spec-build-driver\\\" was not projected within 10000 ms\"}}}}","taskId":"cp-weights"}],"outcomes":[],"deferrals":[],"blocked":[{"blockedBy":["cp-weights"],"taskId":"cp-weights"},{"blockedBy":["cp-smoke"],"taskId":"cp-smoke"},{"blockedBy":["cp-smoke"],"taskId":"cp-proxy"},{"blockedBy":["cp-weights","cp-smoke"],"taskId":"cp-tp2"},{"blockedBy":["cp-weights","cp-smoke"],"taskId":"cp-bench"},{"blockedBy":["cp-weights","cp-smoke"],"taskId":"cp-close"},{"blockedBy":["cp-weights","cp-smoke"],"taskId":"cp-usb4stream"},{"blockedBy":["cp-weights","cp-smoke"],"taskId":"rocm10-probe"}],"quiescent":true,"escalation":"local://campaign/flashnext/attempt-receipts/48","closingSummary":null,"warnings":["campaign pardon local://campaign/flashnext/attempt-receipts/44 pardoned 1 earlier machine receipt(s) for task(s) 'cp-weights', 'proxy-tooling'"]},"maintenance":{"blockingJobs":[],"cleaned":["pass:/home/tom/.local/state/tally/campaigns/flashnext/.state/passes/f1a0a0f7f066.json"],"currentRunHash":"f7dada7af85c","liveRuns":[],"warnings":[]},"checkpoints":[],"merged":[],"published":{"action":"already-published","baseBranch":"main","integrationHead":"6e818349eeb947501ac04ba83e826764a042011c","provenHead":"6e818349eeb947501ac04ba83e826764a042011c","reason":"main already names the gate-proven head 6e818349eeb947501ac04ba83e826764a042011c","receipt":{"actor":"spec-build-driver","baseBranch":"main","campaign":"flashnext","provenBy":{"reference":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-build-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb