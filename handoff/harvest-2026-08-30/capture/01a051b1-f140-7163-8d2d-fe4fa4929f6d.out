TALLY_FINAL_MESSAGE={"baseRevision":"6e818349eeb947501ac04ba83e826764a042011c","blocked":[],"campaign":"flashnext","checkpoints":[{"ref":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-weights-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a/6e818349eeb947501ac04ba83e826764a042011c","revision":"6e818349eeb947501ac04ba83e826764a042011c","taskId":"cp-weights"},{"ref":"refs/tally/spec-build/v1/9580b7cc868de0369023d414/checkpoint/cp-build-eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a/6e818349eeb947501ac04ba83e826764a042011c","revision":"6e818349eeb947501ac04ba83e826764a042011c","taskId":"cp-build"}],"closingSummary":null,"complete":false,"deferrals":[{"taskId":"cp-close","waitingOn":["rocm10-probe"]},{"taskId":"cp-usb4stream","waitingOn":["rocm10-probe"]}],"diagnoses":[],"escalation":null,"frontier":[{"argv":["bash","scripts/run-smoke.sh"],"dependencies":["cp-build"],"id":"cp-smoke","kind":"checkpoint","revision":"sha256:f6d3bc428003f8bb40eb0422b1c3199fd1957b0cf966ff153c17a9b5d5bc4225","runtimeMaxSec":1800,"title":"Checkpoint: in-container smoke — identity, fp8 cast, admission"}],"inputEpochs":{"bench-harness":"sha256:2352e45654aa40b953261c40e9f6ec94f1092cad33d430f9ecf48e6f10e3c5eb","catalog-handoff":"sha256:fa1945bd26929400395e1558066dc8da6fa92c8aeb8bd8a7d67889c299b593b1","container-recipe":"sha256:981aa35aa579b82b18c1ede5fb88941cd5b2e93e4e7b7281b1cebc7499f0e9d2","cp-bench":"sha256:53dbfe255415291d956633e2d00b29286d6a3cd941a76445aee2aef80b9bc91b","cp-build":"sha256:720d98665c281a8144756f37706614663292014bff9c8ccc3707e89a21ac634f","cp-close":"sha256:226ca62a13854ba5874a0d1f6c8550189366bc43380226a538b3833e6f86b3ed","cp-proxy":"sha256:aef12b28092229f2b8b78491659ea8a0c44aac71f53a51ef306995df8dd70859","cp-smoke":"sha256:cc682842e7009032007bcf2e03f7231bf67be122934e74adea281482d45d0433","cp-tp2":"sha256:df6b9ecbb1f7282c57207d4641ccda5345f5d46e57eb80fa2080ac5541fc5d59","cp-usb4stream":"sha256:d61287c37f657b312db7c66e833eb8b8c24573dac8a99b36188b9c07c64ae9d3","cp-weights":"sha256:b87c12721a67cb1258e406067e05429057371a3412b08432876a3a742ff0f5c3","host-tooling":"sha256:ad4bb29b6c6bacc7d9daa9617564856e0e1a0af53dda59eea5115534cb964ce2","instruments":"sha256:e34767dab3eca75dda2803f93efa1bf837e425ded47003e570121faf816ecd34","morning-ledger":"sha256:c23fa1e2f52cb151440d0aff5200096bc0b16690f5aaf32dce3a43ad0dbf909a","proxy-tooling":"sha256:3f6deb4f07f8adc611bc9c93fdff33dd517fcb684a224df431bc70c02c509614","rdma-package":"sha256:298dec85f9460f8c7242792998749d016d8b18745ee239e6c80b513115fffd01","rocm10-probe":"sha256:9172b564f8874f45b15aa00a43cd69ffc11864db5de3df8d030a0148a34b5d67","usb4stream-bench":"sha256:9ecb4cc938499d939627bc75d64481b8c70859aa48bceaa777234aea7c9a3d3e"},"merged":[{"mergeCommit":"ff1731c6c5886748faa13231e2f6012936bfb5dd","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/container-recipe-6e8621b55de3a3a9","revision":"sha256:6e8621b55de3a3a9c646edd59fb1c26372db042e230f9d2d3ec5a4e08d329361","taskId":"container-recipe"},{"mergeCommit":"1e2eef72397ee0a8053ed816a70e25e55e7aa304","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/instruments-16ab40e19244fd0f","revision":"sha256:16ab40e19244fd0f9cde08858a2c348ff99e701e0a8ce46b6e99fc84b6d36c5b","taskId":"instruments"},{"mergeCommit":"754e1118d0ce0414aa2f72fb2a7fdaa668e857cc","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/host-tooling-ab66c582012f053f","revision":"sha256:ab66c582012f053ffa092301faf6a9b042d52ad26c6baa1b6d149083241af99d","taskId":"host-tooling"},{"mergeCommit":"d618da613f55c39f5c520dcd2f499bb07e8da225","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/bench-harness-3a8882e61c9b2ce9","revision":"sha256:3a8882e61c9b2ce9ef7a7904e06778f0284df952e4a68deb4f8e6e1caba1a225","taskId":"bench-harness"},{"mergeCommit":"6e818349eeb947501ac04ba83e826764a042011c","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/proxy-tooling-9cb06ca07951b228","revision":"sha256:9cb06ca07951b2287bda5724f848b7f77a439185529991cf017a8022957d13a8","taskId":"proxy-tooling"},{"mergeCommit":"bfd358b923b35a4a80dad2163d7e8ec16aaf81b6","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/morning-ledger-27a15022aaf7c70c","revision":"sha256:27a15022aaf7c70c3c32d63b27cf07bf64e1e0097b435707dd270c06ab414996","taskId":"morning-ledger"},{"mergeCommit":"377ba269689b458c10903c86e579816d39478b34","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/catalog-handoff-7f3033dbd7a5c6b6","revision":"sha256:7f3033dbd7a5c6b695b70874814d89053eec1372194895793dc8534f9f4d03ed","taskId":"catalog-handoff"},{"mergeCommit":"0a89657f40b8654fed9a050b77458f46f0e5c559","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/rdma-package-fe9122567f61a3ff","revision":"sha256:fe9122567f61a3ff2f0fa2ba872e08f885158cdaa3d584270bd72b3302f22bbc","taskId":"rdma-package"},{"mergeCommit":"bdc42fc2d0a44bc934845e3aa65421ba51b94721","pullRequest":"local://mecattaf/flashnext/tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/usb4stream-bench-75b32ae929f161f9","revision":"sha256:75b32ae929f161f972eb9544f33d653ee19a939a595012f6c112e3c4e69bb00e","taskId":"usb4stream-bench"}],"outcomes":[],"quiescent":false,"remaining":["cp-smoke","cp-proxy","cp-tp2","cp-bench","cp-close","cp-usb4stream","rocm10-probe"],"repository":"mecattaf/flashnext","retries":[],"schemaVersion":1,"source":{"path":"silent-factory-worklists/flashnext.json","revision":"939356b78c83d6f77002f20fe426e664fa8e531d","sha256":"sha256:eaf42577547a236aec30c9fac118031545389f7e13c9672f04194c1adb38c58a"},"tasks":[{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n container/build.sh && grep -q 'torch==2.13.0+rocm7.14.0' container/Containerfile && grep -q 'repo.amd.com/rocm/whl-multi-arch' container/Containerfile && grep -q 'mecattaf/vllm' container/Containerfile && grep -q 'flashnext:dev' container/build.sh && grep -qi 'MIT' container/Containerfile"],"description":"The recipe pins the exact wheel set, the fork branch, and the image tag, and is syntax-clean.","id":"recipe-pins"}],"conflictDomains":["container","results/receipts"],"deliveredBehaviors":["A reproducible image build from the fork at the exactly pinned wheel set","A build receipt the receipts gate can grade"],"dependencies":[],"goal":"THE PRIMARY ENGINE LANE of spec ruling P4 (the nix wiring in the tree is the graduation lane — leave it alone). Write container/Containerfile and container/build.sh implementing IMPORTS.md sections 1 and 2 and spec claim 3.1 (specs/flashnext/spec.md#r3), designed for overnight iteration: the fork checkout and its build directory are bind-mounted volumes with ccache enabled so a one-line patch rebuild recompiles only what changed, and the image can be entered for edit-and-restart iteration without a rebuild. Containerfile: Ubuntu 24.04; python 3.12 venv at /opt/venv; install torch 2.13.0+rocm7.14.0 and torchvision 0.28.0+rocm7.14.0 and the matching triton wheel from the vendor stable index https://repo.amd.com/rocm/whl-multi-arch/ (record the exact resolved triton version); git clone --depth 1 --branch flashnext https://github.com/mecattaf/vllm and build it from source against those wheels for GPU target gfx1151 (relax nothing: the torch pin is satisfied exactly; drop audio extras rather than adding torchaudio); COPY container/rootfs/ into site-packages so the fn_ instrument modules land importable; write /opt/flashnext/build-info.json inside the image carrying the fork commit, torch, triton, and image build time. build.sh: run the packaging tests first, then podman build tagged flashnext:dev, then write results/receipts/build.json as {step:\"build\", status, ts, data:{torch, triton, fork_commit, image_digest}} with status fail on any error. Credit the recipe shape to the MIT toolbox recipe named in THIRD_PARTY_NOTICES.md in the Containerfile header. Boundaries: touch only container/ and results/receipts/.","id":"container-recipe","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r3","IMPORTS.md","specs/flashnext/evidence/kyuz0-rocm10.md"],"styleReferences":["scripts/run-smoke.sh"]},"revision":"sha256:6e8621b55de3a3a9c646edd59fb1c26372db042e230f9d2d3ec5a4e08d329361","title":"Container recipe: pinned wheel set + engine fork built from source"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -m py_compile container/rootfs/fn_synctrace.py container/rootfs/fn_offload_batch.py container/rootfs/fn_expert_union.py && grep -l 'Adapted from' container/rootfs/fn_*.py | wc -l | grep -qx 3 && python3 -m unittest tests.test_instruments -v"],"description":"All three modules compile, carry notices, and their tests pass.","id":"instruments-compile-with-notices"}],"conflictDomains":["container/rootfs","tests"],"deliveredBehaviors":["Instruments importable inside the image with FN_ kill-switches, default off","Notice headers travel with every adapted module"],"dependencies":[],"goal":"Create container/rootfs/ carrying three instrument modules adapted from the Apache-2.0 reference implementation, per specs/flashnext/evidence/ds4-vllm-manifest.md section 3, renamed to the FN_ env prefix: fn_synctrace.py (wraps the handful of tensor methods that force a blocking device-to-host sync, ~25 events per step, driven from a FN_PROFILE window), fn_offload_batch.py (the store-batch and promote budget helpers fixing the upstream offload defect; env FN_OFFLOAD_STORE_BATCH_FRAC and FN_OFFLOAD_PROMOTE_FRAC), and fn_expert_union.py (counts distinct routed experts per decode step; the reference wrapped a routing entry the workload never calls — re-target the wrap onto the stock fused-mixture router entry fused_topk in vllm/model_executor/layers/fused_moe/router/fused_topk_router.py as established in specs/flashnext/evidence/qsa-53896.md section 4; env FN_EXPERT_UNION with FN_EU_START, FN_EU_CALLS, FN_EU_OUT). Every module keeps an adaptation notice header naming the upstream file and license. Add tests/test_instruments.py asserting: py_compile passes for each module, each carries the notice header, and fn_offload_batch budget arithmetic matches the reference invariants (floor at max group size; promote counted in blocks). Boundaries: touch only container/rootfs/ and tests/.","id":"instruments","kind":"implementation","readFirst":{"specSections":["specs/flashnext/evidence/ds4-vllm-manifest.md","specs/flashnext/evidence/qsa-53896.md"],"styleReferences":["scripts/receipts-verify.py"]},"revision":"sha256:16ab40e19244fd0f9cde08858a2c348ff99e701e0a8ce46b6e99fc84b6d36c5b","title":"Engagement-proof instruments adapted into the container overlay"},{"acceptanceCriteria":[{"argv":["bash","-euc","for f in host/*.sh scripts/run-tp2.sh; do bash -n \"$f\"; done && grep -q 'PYTHONHASHSEED=0' host/fn-env.sh && grep -q 'NCCL_SOCKET_IFNAME' host/fn-env.sh && grep -q 'thunderbolt0' host/fn-env.sh && grep -q 'NCCL_IB_DISABLE=1' host/fn-env.sh && grep -q 'VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=FN_' host/fn-env.sh && grep -q 'ExecStopPost' host/systemd/flashnext-pair.service && ! grep -q 'WantedBy' host/systemd/flashnext-pair.service && python3 -m unittest tests.test_host_tooling -v"],"description":"Env doctrine present, units teardown-safe, all scripts syntax-clean, host tests pass.","id":"host-doctrine"}],"conflictDomains":["host","scripts/run-tp2.sh","tests"],"deliveredBehaviors":["One command stands the pair service; one command tears it down; failure cannot strand ranks","First light produces the four receipts the ladder grades"],"dependencies":[],"goal":"Write the host/ tooling and scripts/run-tp2.sh per spec claims 4.2, 4.3, 4.4, 4.5 and 6.1 (specs/flashnext/spec.md#r4, #r6), composing the disciplines in specs/flashnext/evidence/ds4-vllm-manifest.md section 5 and specs/flashnext/evidence/dotfiles-observed.md section 5. host/fn-env.sh: PYTHONHASHSEED=0; PYTORCH_HIP_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.85; HSA_ENABLE_INTERRUPT=1; inductor and triton cache dirs under the state directory, never tmpfs; NCCL_SOCKET_IFNAME set ONLY to the Thunderbolt rails that carry a routable /30 IP (rail 0 thunderbolt0/10.99.0.x is guaranteed; rail 1 thunderbolt1 is trained-but-IP-unconfigured today per dotfiles modules/lowlat-cluster.nix and MUST NOT be listed until it has a peer IP — a peerless link-local rail in the list hangs RCCL bootstrap; the env file computes this from `ip -br addr` at write time and logs which rails it chose, rather than hardcoding both); NCCL_IB_DISABLE=1 UNCONDITIONALLY (an ibverbs device now exists on the rails from the pre-arm bake; without this pin RCCL autodetects verbs and silently rides unproven RDMA — sockets are the transport of record until the attended morning A/B, evidence host/rdma/ab-protocol.md); VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=FN_; VLLM_PLE_MMAP=1; a loud comment forbidding exports of engine defaults read through is-set probes. host/fn-cluster-up.sh: podman on both nodes (worker over ssh on the wire), distributed head on the coordinator and worker join, worker python pool capped small, a hard two-GPU gate before serve, then the serve process at tensor-parallel size 2 with eager execution, model directory /var/lib/local-models/flashnext-fp8, served name flashnext; reap stranded serve processes before start and gate on zero residue. host/fn-cluster-down.sh: idempotent teardown both nodes. host/fn-preflight.sh: byte-diff of both ranks' FN_ env, latency-hold device read on both ends, per-rail link-speed record, round-trip probe on both rails. host/systemd/flashnext-pair.service: oneshot, RemainAfterExit, ExecStopPost teardown, no install section. scripts/run-tp2.sh: preflight, up, two greedy 300-token completions byte-compared, residency read after 50 warmed decode tokens (GTT per rank from sysfs plus process RSS plus table page-cache residency), fidelity capture (fixed-prompt losses and frontier logits under results/), then a 262144-context probe, writing receipts tp2.json, residency.json, fidelity.json, context.json per the receipts-verify.py schema. Extend tests/test_repo_invariants.py-adjacent coverage with tests/test_host_tooling.py asserting the env file carries the doctrine lines and unit files carry ExecStopPost and no WantedBy install. Boundaries: touch only host/, scripts/run-tp2.sh, and tests/.","id":"host-tooling","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r4","specs/flashnext/spec.md#r6","specs/flashnext/evidence/ds4-vllm-manifest.md","specs/flashnext/evidence/dotfiles-observed.md"],"styleReferences":["scripts/stage-weights.sh","scripts/run-smoke.sh"]},"revision":"sha256:ab66c582012f053ffa092301faf6a9b042d52ad26c6baa1b6d149083241af99d","title":"Pair-service orchestration: env doctrine, cluster up/down, first-light runner"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -m py_compile bench/fn-stream-client.py && bash -n bench/run-matrix.sh && python3 -m unittest tests.test_bench_client -v"],"description":"Client compiles, separation test passes, matrix script is syntax-clean.","id":"bench-honest-client"}],"conflictDomains":["bench","tests"],"deliveredBehaviors":["A client whose prefill number is a measurement, not a proxy","A matrix whose every number carries its protocol"],"dependencies":[],"goal":"Write bench/fn-stream-client.py and bench/run-matrix.sh per spec claims 6.2 and 6.3 (specs/flashnext/spec.md#r6). The client measures per-request time-to-first-token client-side AND scrapes the server metrics endpoint to separate scheduler queue wait from prompt processing — the reference harness's client published a prefill column that duplicated its first-token column (specs/flashnext/evidence/nix-strix-halo.md section 4.4); ours must not. Emit CSV with explicit column semantics in a header comment, plus a sha256 fingerprint of every completion's token ids. run-matrix.sh: arms interleaved A-B-B-A, three loads per arm, medians reported, depth series 0, 10240, 102400 tokens, speculative decoding on and off arms, results committed under results/ and a bench.json receipt {loads_per_arm, counterbalanced:true, arms, fingerprints}. Add tests/test_bench_client.py: feed the client parser a fixture with known queue and processing times and assert the two columns separate them. Boundaries: touch only bench/ and tests/.","id":"bench-harness","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/evidence/nix-strix-halo.md"],"styleReferences":["scripts/receipts-verify.py"]},"revision":"sha256:3a8882e61c9b2ce9ef7a7904e06778f0284df952e4a68deb4f8e6e1caba1a225","title":"Measurement harness: honest client and counterbalanced matrix"},{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n scripts/make-proxy.sh scripts/run-proxy.sh && grep -q 'results/receipts/proxy.json' scripts/run-proxy.sh"],"description":"Both scripts are syntax-clean and reference the receipt path.","id":"proxy-scripts-clean"},{"argv":["bash","-euc","grep -q 'VLLM_PLE_MMAP=1' scripts/run-proxy.sh && grep -q 'limit-mm-per-prompt' scripts/run-proxy.sh && grep -qE 'enforce.eager|enforce_eager' scripts/run-proxy.sh && ! grep -q 'skip-mm-profiling' scripts/run-proxy.sh"],"description":"run-proxy.sh serves with the mmap PLE path, eager execution, and the text-only multimodal limit that avoids the encoder-profiling OOM.","id":"proxy-serve-flags"},{"argv":["bash","-euc","grep -q '/var/tmp/flashnext-proxy' scripts/make-proxy.sh && grep -q 'weight_block_size' scripts/make-proxy.sh && grep -q '128' scripts/make-proxy.sh && grep -q 'tests/models' scripts/make-proxy.sh"],"description":"make-proxy.sh builds the synthetic checkpoint at the agreed path with block-FP8 128x128 experts and reuses the fork's test scaffolding.","id":"proxy-checkpoint-layout"},{"argv":["bash","-euc","[ -z \"$(git status --porcelain)\" ]"],"description":"The lane is fully committed: no uncommitted or untracked files remain after the task's commit.","id":"proxy-lane-clean"}],"conflictDomains":["scripts/make-proxy.sh","scripts/run-proxy.sh","tests","results/receipts/proxy.json"],"deliveredBehaviors":["The admitted kernel path and the ported table path execute on this GPU before any real weight byte is loaded"],"dependencies":["container-recipe"],"goal":"Re-scope proxy-tooling to authoring and committing the two scripts, and widen its write boundary to include the receipt the scripts produce. Deliverables: (1) scripts/make-proxy.sh, in the style of scripts/run-smoke.sh, runs inside the flashnext:dev container and builds the synthetic checkpoint under /var/tmp/flashnext-proxy — same architecture identifier as the workload, a handful of layers, 8 experts in block-FP8 with weight_block_size 128 by 128, and a small lookup table using the shard tensor name the mmap path expects — reusing the fork's tests/models/ scaffolding inside the fork checkout instead of inventing generators, and detecting an existing checkpoint so a rebuild is skipped. (2) scripts/run-proxy.sh serves that checkpoint single-node from the container with VLLM_PLE_MMAP=1 and eager execution, requests one greedy completion, asserts finite logits via the API, shuts the server down cleanly, and writes results/receipts/proxy.json, recording the serve env choices in the receipt data so cp-proxy and the later TP=2 serve reproduce them. The serve command must carry --limit-mm-per-prompt with image and video set to 0 (JSON quoted for the shell) so profile_run skips the vision-encoder pass that allocated 274877906944 bytes; keep gpu_memory_utilization at 0.6; do not use --skip-mm-profiling; do not set VLLM_ROCM_APU_UNIFIED_MEMORY, since the host logs integrated_gpu=False and that steer was superseded. PYTORCH_HIP_ALLOC_CONF=expandable_segments:True is optional. (3) Any script-level test coverage lives under tests/. Explicitly out of scope for this task: performing the live GPU first light. The scripts must be authored, syntax-clean, and committed on the assigned branch without requiring a serve run; cp-proxy owns executing run-proxy.sh and producing the real results/receipts/proxy.json. Granting results/receipts/proxy.json to the write boundary matches the container-recipe precedent (results/receipts/build.json committed in c1363cb) and makes authorized steering comment 7 executable instead of self-defeating, and it lets a receipt produced by an opportunistic local run be committed rather than dirtying the lane. Final acts, in order: run every acceptance argv and see it pass, git add only paths inside the widened boundary, git commit, then confirm git status --porcelain is empty before returning a final message.","id":"proxy-tooling","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r4","specs/flashnext/evidence/ple-54129.md","specs/flashnext/evidence/moe-dispatch.md"],"styleReferences":["scripts/run-smoke.sh"]},"revision":"sha256:9cb06ca07951b2287bda5724f848b7f77a439185529991cf017a8022957d13a8","title":"Proxy checkpoint builder and single-node first-light runner (rev 2: latch cleared)"},{"acceptanceCriteria":[{"argv":["bash","-euc","grep -q 'Receipt review' docs/MORNING.md && grep -q 'Open items' docs/MORNING.md && grep -q 'Promotion checklist' docs/MORNING.md && grep -q 'Optimization menu' docs/MORNING.md && grep -qi 'blocker' docs/MORNING.md && test -s docs/ANNOUNCE.md"],"description":"The ledger carries its five sections and the announcement draft exists.","id":"ledger-sections"},{"argv":["bash","-euc","test -s docs/DAYRUN-STOP-STATE-2026-08-29.md && grep -q 'Day-run stop-state' docs/DAYRUN-STOP-STATE-2026-08-29.md && grep -q 'operator-called halt' docs/DAYRUN-STOP-STATE-2026-08-29.md && ! grep -q 'Day-run stop-state' docs/MORNING.md && grep -q 'catalog-row.patch' docs/MORNING.md && grep -q 'usb4stream' docs/MORNING.md"],"description":"The 08-29 stop-state is archived verbatim (its identifying lines present in the archive, absent from the new ledger), the prune-causality line is in the checklist, and the stream-primitive receipt row is pre-declared.","id":"ledger-archive"}],"conflictDomains":["docs/MORNING.md","docs/ANNOUNCE.md","docs/DAYRUN-STOP-STATE-2026-08-29.md"],"deliveredBehaviors":["The operator's first ten minutes are a checklist, not archaeology","The community post is ready to publish with the benchmark numbers","Yesterday's stop-state record survives as an archive instead of being clobbered","Receipts that land after the ledger renders are pre-declared rows with their bounds, so nothing the night banks arrives unreviewed"],"dependencies":["host-tooling","bench-harness"],"goal":"AMENDED 2026-08-30: docs/MORNING.md currently holds the operator's 2026-08-29 day-run stop-state record — FIRST move that file verbatim to docs/DAYRUN-STOP-STATE-2026-08-29.md (git mv, keep every byte), THEN write the new docs/MORNING.md per spec claim 7.1 (specs/flashnext/spec.md#r7). This lane renders BEFORE the milestone checkpoints run (it sits early in the serial graph), so the receipt review table has two row kinds: receipts already banked at render time (build, weights, possibly smoke) carry their observed status and the bound they were graded against; every receipt that lands AFTER render is PRE-DECLARED — one row each for preflight, proxy, tp2, residency, fidelity, context, bench, and usb4stream, naming the file path, the bound scripts/receipts-verify.py grades it against, and how to read it. Three pre-declared rows are mandatory and specific: (a) results/receipts/usb4stream.json — cp-usb4stream runs dead-last after cp-close and only when the pair serve is already down; name its three typed outcomes (ok / skipped:REASON / aborted:PHASE:ERRNO), say that data.outcome is where to read them, that 'skipped:serve-up-on-shared-cable' is the EXPECTED outcome after a healthy night, and that a skipped or aborted outcome is the typed blocker for that step per F.12; (b) results/receipts/failed/ — the quarantine directory: any step that fails its own grading writes its fail receipt THERE so one graded failure cannot redden every later gate run; every file present there in the morning is a typed blocker the operator reviews first; (c) results/receipts/failed/context.json — if present, the honest full-context decode ratio undershot the 0.9 bound (12 full-attention layers walking 256K KV; the community precedent shows about a 2x falloff by 50-73k) — a typed performance finding routed to the optimization menu, deliberately NOT a campaign failure. Also render: the open-items list (every UNKNOWN from the spec with its drain state); the promotion checklist (what the operator verifies before any fleet change, per ruling P13 — and state the causality plainly: the fleet's local-models sync retires any staged artifact that has no catalog row; it pruned the staged checkpoint from BOTH nodes on 08-29 around 20:07/20:14; applying handoff/catalog-row.patch is the act that makes staging durable, and it must precede any rebuild or any restart of the model-sync trigger service); the transport-rung caveat (if any receipt records fn_transport_rung wire-fallback, the night ran on the 5GbE wire: valid but degraded receipts, and bench.json then does NOT satisfy the rail-sockets Gate 0 for verbs bring-up — healing rail 0 is the morning's first transport act); the optimization menu; and a blocker template implementing ruling P16. The optimization menu carries, beyond the original items (tuned mixture-kernel config generation for this GPU, graph-capture matrix, jumbo-frame A-B, draft-length sweep, the four-bit expert lane pointers from IMPORTS.md): the speculative-head depth sweep n in 1 to 4 plus the index-share and padded-drafter knobs (UNKNOWN-5); the attended RDMA go/no-go with the honest cost (2-4 attended hours, two more reboots, worker deploy-path fix first, nothing staged for kernel 7.2.2 yet) and honest expectation (about +3.4 percent measured precedent over held TCP); the stream-primitive morning decision rule (attended port of the reference doorbell allreduce onto the in-tree stream device ONLY if the banked exchange p50 at 8-16 KiB is at or under about 40 microseconds AND the bench matrix shows decode is allreduce-dominated — noting the stream bench likely runs attended in the morning after teardown, since it skips while the pair serves); the full-context decode probe follow-up when deferred; a rejected-with-reason register so nothing is re-litigated (the community int4-WMMA expert lane: bound to a different runtime's artifact, single-device only, unreachable even in its own public release; the indexer rotation plus FP4 QAT art: fidelity art for a different model family's trained indexer graph — our engine's indexer is weight-free bf16 with no such trained graph, so transplanting it would corrupt top-k selection); the load-phase page-cache drop-behind remedy pointer for repo issue 2 (release file pages in chunks behind the loader); a per-shape kernel block-size tuning item for the 2560x640 and 640x2560 expert shapes (community precedent: a forced tile choice beat the auto-selector on exactly these shapes); and a note to audit the drafter hidden-state versus prefix-cache position sync before the speculative profile is declared production (a community v1.1 fix records the failure mode: cached target prefix reused while the drafter state timeline sits elsewhere breaks multi-turn — the operator files the repo issue). Also write docs/ANNOUNCE.md: a short community post draft describing the setup (two 128 GB unified-memory desktops, two fast rails, one control wire), what was built overnight, where the evidence lives, and where benchmarks land. Boundaries: touch only docs/MORNING.md, docs/ANNOUNCE.md, and docs/DAYRUN-STOP-STATE-2026-08-29.md.","id":"morning-ledger","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/spec.md#r7","IMPORTS.md"],"styleReferences":["README.md"]},"revision":"sha256:27a15022aaf7c70c3c32d63b27cf07bf64e1e0097b435707dd270c06ab414996","title":"Archive the stop-state, then render the morning ledger and the announcement draft"},{"acceptanceCriteria":[{"argv":["bash","-euc","git apply --stat handoff/catalog-row.patch >/dev/null && test -s handoff/README.md"],"description":"The patch parses as a git patch and the handoff note exists.","id":"catalog-patch-wellformed"}],"conflictDomains":["handoff"],"deliveredBehaviors":["The morning catalog declaration is one git apply plus one review, not authoring work","The operator knows the patch is what stops the sync service from pruning the staged weights again"],"dependencies":[],"goal":"Write handoff/catalog-row.patch per spec claim 5.2 (specs/flashnext/spec.md#r5): a git format patch against the fleet configuration repository adding the workload checkpoint as a snapshot-layout artifact row assigned to both hosts, following the existing snapshot-layout precedent row in that repository's model library file, with pinned upstream revision and per-file byte counts read from the staged copy under /var/lib/local-models/flashnext-fp8 (or from the library mount when staging has not finished). Add handoff/README.md explaining exactly what the operator applies and verifies in the morning — and state the urgency plainly: the fleet's local-models sync retires any staged artifact that has no catalog row (it pruned the staged checkpoint from BOTH nodes on 2026-08-29, triggered at boot, on rebuilds, and on model-sync service starts, which is why tonight's campaign had to re-stage 185.6 GB per node); applying this patch is what ends that hazard permanently, and it must be applied BEFORE any rebuild or any restart of the model-sync trigger service. The patch is prepared, never applied, by this campaign. Boundaries: touch only handoff/.","id":"catalog-handoff","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r5","specs/flashnext/evidence/dotfiles-observed.md"],"styleReferences":["THIRD_PARTY_NOTICES.md"]},"revision":"sha256:7f3033dbd7a5c6b695b70874814d89053eec1372194895793dc8534f9f4d03ed","title":"Prepare the fleet catalog patch for the morning operator"},{"acceptanceCriteria":[{"argv":["bash","-euc","bash -n host/rdma/fetch-and-build.sh && grep -q '503c5ae1e72aa9ed91925dafa3d82ee2e992747f' host/rdma/fetch-and-build.sh && grep -q '76ba39b630a70accb72f19388eefe48844b50eb8' host/rdma/fetch-and-build.sh && ! grep -qE '^[[:space:]]*(sudo[[:space:]]+)?(insmod|modprobe)[[:space:]]' host/rdma/fetch-and-build.sh && grep -qi 'physically present' host/rdma/attended-bringup.md && grep -qi 'worker first' host/rdma/attended-bringup.md && grep -qi 'deploy' host/rdma/attended-bringup.md && test -s host/rdma/ab-protocol.md"],"description":"Scripts syntax-clean, pins present, no auto-install, attended language present.","id":"rdma-package-sound"},{"argv":["bash","-euc","python3 -m unittest tests.test_rdma_package -v && grep -qi 'odinlink' host/rdma/ab-protocol.md && grep -q '7.2.2' host/rdma/attended-bringup.md && grep -qi 'wire-fallback' host/rdma/attended-bringup.md"],"description":"The pin test exists and passes; the odinlink fold, the 7.2.2 truth, and the wire-rung Gate 0 caveat landed in the docs.","id":"rdma-pin-test"}],"conflictDomains":["host/rdma","tests"],"deliveredBehaviors":["The two pin commits are asserted by the tests suite, not merely present in the script","Tomorrow's attended bring-up doc tells the truth about kernel 7.2.2, the missing verbs devices, the wedge blast radius, and which transport rung a Gate 0 benchmark must carry"],"dependencies":[],"goal":"RE-SCOPED 2026-08-30 (second flow): the package files under host/rdma ALREADY EXIST on main and pass this lane's original acceptance argv verbatim — do NOT rewrite them wholesale, and do not end with an empty diff (the empty-diff completion failure is a known harness hazard). Concrete deliverables now: (1) tests/test_rdma_package.py — the test the original goal promised: assert both pin commits 503c5ae1e72aa9ed91925dafa3d82ee2e992747f and 76ba39b630a70accb72f19388eefe48844b50eb8 appear in host/rdma/fetch-and-build.sh; assert no line of that script begins with insmod or modprobe (optionally sudo-prefixed) — the no-unattended-load invariant, spec F.1; assert host/rdma/attended-bringup.md carries the 'physically present' and 'worker first' language. (2) Fold the odinlink learnings (repo issue 6, evidence at the reference estate the issue names) into host/rdma/ab-protocol.md and host/rdma/attended-bringup.md as short dated appendix sections: terminal-failure framing for verbs init (on ANY init failure: no retry, restore the socket env byte-identical on both ranks, one restart, and the terminal fallback rung is ALWAYS the ethernet wire, never the second rail); the 11 microsecond one-way rail reference figure; the per-cable p2p ceiling asymmetry; and the measured hazard that a verbs transmit toward a closed peer receive ring stalls end-to-end credits and wedges the whole XDomain INCLUDING TCP on the same cable — recovery is reboot-only, which is why no verbs rung may ever appear in an unattended fallback ladder. (3) A dated 'state of tonight' preamble note in attended-bringup.md: no ibverbs device exists on either node right now, the staged module sets cover only kernels 7.1.4 and 7.2.0 while the fleet runs 7.2.2, so the attended morning fetch-and-build on BOTH nodes (running-kernel gate 7.2.2) precedes any A/B; the honest expectation from the one measured community precedent is about +3.4 percent over held TCP — adopt only on a fingerprint-clean counterbalanced majority win. The preamble must ALSO state the Gate 0 transport-rung caveat: the banked socket-transport benchmark that unlocks bring-up must have been measured over the Thunderbolt rail — a bench receipt whose transport record reads fn_transport_rung wire-fallback is a 5GbE artifact and does NOT satisfy Gate 0; on a wire-fallback night the attended morning first heals rail 0 and re-banks a rail-sockets bench before any verbs work. Keep every existing hard rule intact: nothing GPL vendored, nothing installs or loads automatically, one rail only, bring-up starts only after a committed socket-transport benchmark exists under results/. Boundaries: touch only host/rdma and tests/.","id":"rdma-package","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/evidence/ds4-vllm-manifest.md"],"styleReferences":["scripts/stage-weights.sh"]},"revision":"sha256:fe9122567f61a3ff2f0fa2ba872e08f885158cdaa3d584270bd72b3302f22bbc","title":"Close the RDMA package: the missing pin test plus the odinlink and kernel-truth folds"},{"argv":["bash","scripts/stage-weights-both.sh"],"dependencies":[],"id":"cp-weights","kind":"checkpoint","revision":"sha256:69cf7d1bd7e087ed890f0d1f8b8381d531b587536a58320721baf47c58601c2f","runtimeMaxSec":14400,"title":"Checkpoint: re-stage the workload checkpoint onto both nodes (2026-08-30 revision: the fleet's local-models sync pruned both staged trees on 08-29 — the artifact has no catalog row — so this must re-copy ~185.6 GB per node; runs after the attended co [rev 2: validate-only]"},{"argv":["bash","-euc","bash container/build.sh && python3 -c \"import json,subprocess,sys; head=json.loads(subprocess.run(['git','show','HEAD:results/receipts/build.json'],capture_output=True,text=True,check=True).stdout); new=json.load(open('results/receipts/build.json')); inv=('torch','triton','fork_commit'); ok=(new.get('status')=='pass'==head.get('status') and all(new['data'].get(k)==head['data'].get(k) for k in inv)); subprocess.run(['git','checkout','--','results/receipts/build.json'],check=True) if ok else sys.exit('cp-build: receipt drift on contract fields: '+repr({k:(head['data'].get(k),new['data'].get(k)) for k in inv if head['data'].get(k)!=new['data'].get(k)}))\""],"dependencies":["container-recipe","instruments"],"id":"cp-build","kind":"checkpoint","revision":"sha256:68cae62fcf88986db2628efdf2c37cf969bb1294237e54f39207f70237812b21","runtimeMaxSec":14400,"title":"Checkpoint: the container engine build"},{"argv":["bash","scripts/run-smoke.sh"],"dependencies":["cp-build"],"id":"cp-smoke","kind":"checkpoint","revision":"sha256:f6d3bc428003f8bb40eb0422b1c3199fd1957b0cf966ff153c17a9b5d5bc4225","runtimeMaxSec":1800,"title":"Checkpoint: in-container smoke — identity, fp8 cast, admission"},{"argv":["bash","-euc","bash scripts/make-proxy.sh && bash scripts/run-proxy.sh"],"dependencies":["cp-smoke","proxy-tooling"],"id":"cp-proxy","kind":"checkpoint","revision":"sha256:6fbf0ea685ac3069755fa819434b3eee4c2f32dd4214e7d218b7f20c5659a0a6","runtimeMaxSec":3600,"title":"Checkpoint: proxy checkpoint first light, single node"},{"argv":["bash","scripts/run-tp2.sh"],"dependencies":["cp-proxy","cp-weights","host-tooling"],"id":"cp-tp2","kind":"checkpoint","revision":"sha256:d196a72e37ff2e8a46157397702992e95af39dbda52bf246dc953d8ffc1bdbb8","runtimeMaxSec":10800,"title":"Checkpoint: pair first light, residency, fidelity, full context"},{"argv":["bash","bench/run-matrix.sh"],"dependencies":["cp-tp2","bench-harness"],"id":"cp-bench","kind":"checkpoint","revision":"sha256:0d3503afc9cfcbe82ea2feb1076c052074a60b2424d762641f4e45763b32f070","runtimeMaxSec":21600,"title":"Checkpoint: the counterbalanced bench matrix"},{"argv":["bash","-euc","python3 -m unittest discover -s tests && python3 scripts/receipts-verify.py && FN_FORK_STRICT=1 bash scripts/verify-fork.sh"],"dependencies":["cp-bench","morning-ledger","catalog-handoff"],"id":"cp-close","kind":"checkpoint","revision":"sha256:b7c99445b074b20ed636442dd80d830240465c7437ae93f9c75c14b793aa8546","runtimeMaxSec":3600,"title":"Checkpoint: full verification pass over everything the night produced"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -m py_compile bench/usb4stream-bench.py scripts/receipts-verify.py && grep -q 'configfs' bench/usb4stream-bench.py && grep -q 'usb4stream' scripts/receipts-verify.py && ! grep -qE '/dev/tbstream[0-9]' bench/usb4stream-bench.py && grep -q 'serve-up-on-shared-cable' bench/usb4stream-bench.py && test -s docs/USB4STREAM-TRANSPORT.md && python3 -m unittest tests.test_usb4stream_bench -v"],"description":"Bench and checker compile, resolution is configfs-driven with no hardcoded device node, the serve-up skip exists, the memo exists, and the tests pass.","id":"usb4stream-bench-sound"}],"conflictDomains":["bench/usb4stream-bench.py","docs/USB4STREAM-TRANSPORT.md","scripts/receipts-verify.py","tests"],"deliveredBehaviors":["A single-open, skip-safe, retry-proof bench that can bank the first stream-primitive exchange numbers without being able to storm the hop tables, and that refuses to touch the device while the pair is serving on the same cable","The morning reads one memo that settles plugin-versus-port with trigger criteria instead of re-deliberating"],"dependencies":[],"goal":"Author (never run — the dead-last checkpoint runs it) a wedge-safe first-light benchmark of the in-tree USB4 stream primitive, as transport-decision evidence for the morning. Deliverables: (1) bench/usb4stream-bench.py — one file serving both roles (coordinator role is the default; peer role via --role peer --dev PATH; the peer is launched by streaming this same file over the control wire: ssh worker with the script on stdin, never a copy). Non-negotiable mechanics, each existing because an open/close storm against a mismatched peer wedges router hop tables and already darkened rail 0 once: (a) NEVER hardcode a numbered device node and never write a digit directly after the word tbstream anywhere in the file — the numbering is asymmetric across the twins and the coordinator carries PEERLESS cable-B groups at the low indices, where a blocking open waits forever; resolve on EACH node as: the rail netdev carrying the 10.99.0.0/30 address, then readlink /sys/class/net/RAIL/device, then the parent xdomain, then the sibling service whose key attribute is stream, then the configfs group fn0's index attribute, then the device node /dev/tbstream suffixed with that index; require BOTH ends' fn0 configfs groups to exist before any open. (b) Exactly ONE open attempt per side, ever, blocking, under a 30 s alarm; any failure after that point: close whatever is open, kill the ssh child, write the receipt, exit — never reopen, never retry, never write configfs (read ring_size and throttling only). (c) Idempotence guard: if results/receipts/usb4stream.json already exists, exit 0 immediately WITHOUT touching any device — this is what makes harness retries storm-free by construction. (d) Skip preconditions, checked in this order BEFORE any device access, each producing receipt status pass with data.outcome 'skipped:REASON' and exit 0: (i) the pair serve is up — the API answers on the coordinator, or podman reports the serving container running on either node (check the worker over the control wire) — outcome 'skipped:serve-up-on-shared-cable': the stream device shares cable A with the serving rails and a wedge would take the campaign's headline deliverable down, so this bench runs ONLY on an idle cable; (ii) ping -c1 -W2 to the rail peer fails — outcome 'skipped:rail-peer-unreachable'; (iii) either end's fn0 configfs group is missing — outcome 'skipped:configfs-group-missing'. Record data.serve_up true or false in EVERY receipt including skips. (e) Fixed schedule, no adaptivity, no retries: 50 iterations of 4 KiB ping-pong warmup (discarded); RTT at 64, 4096, 16384, 65536 bytes times 500 iterations with p50 and p99 per size; the allreduce-shaped simultaneous exchange at 8192, 16384, 65536 bytes times 500 (both sides write N bytes then read N bytes — ring 1024 times 4 KiB frames buffers this safely); throughput 256 MiB each direction; under 90 s wall total, whole run under a global timeout. (f) The receipt at results/receipts/usb4stream.json: one JSON object, step 'usb4stream', status ALWAYS 'pass' — this bench is evidence-gathering, not a campaign claim, so a mid-run abort is typed as data.outcome 'aborted:PHASE:ERRNO' rather than a fail status that would redden every later gate run; data carries outcome, per-size rtt and exchange p50/p99 fields, throughput both directions, ring_size and throttling as read from configfs, resolved device paths on both ends, open_count (assert exactly 1 per side), serve_up, and loop 'python' for honesty about syscall-loop overhead. (2) scripts/receipts-verify.py: add a 'usb4stream' entry to the BOUNDS table — outcome 'ok' requires open_count 1 and all schedule fields present; 'skipped:' and 'aborted:' outcomes require their reason text and pass. (3) docs/USB4STREAM-TRANSPORT.md — the decision memo: why the collective-library net-plugin route is REJECTED for the latency goal (it sits under the library's proxy and protocol stack, HopID scarcity shared with the network paths forces a multiplexer over one or two long-lived streams, and comm teardown on every serve restart is exactly the open/close pattern the wedge hazard forbids; 3-5 attended days to a fragile prototype, 2-4 attended weeks to overnight-trustworthy); why the real path is a 2-4 attended-day port of the reference doorbell-plus-progress-thread allreduce (the 105 microsecond reference bar) from verbs onto the stream device's read and write, with the receive path run by the progress thread; the morning trigger criteria (banked exchange p50 at 8-16 KiB at or under about 40 microseconds AND the bench matrix showing allreduce-dominated decode); the note that after a healthy night the first real run happens attended in the morning AFTER the pair is torn down (the serve-up skip is deliberate); and a drafted-not-filed issue body for the port. (4) tests/test_usb4stream_bench.py: py-compile both edited python files, assert the no-hardcoded-device-node invariant (no digit after tbstream in the bench source), assert the idempotence guard and the serve-up skip are present, and exercise the receipts checker's three outcome branches with synthetic receipt dicts. Boundaries: touch only bench/usb4stream-bench.py, docs/USB4STREAM-TRANSPORT.md, scripts/receipts-verify.py, and tests/.","id":"usb4stream-bench","kind":"implementation","readFirst":{"specSections":["specs/flashnext/spec.md#r6","specs/flashnext/spec.md#r7","specs/flashnext/evidence/dotfiles-observed.md"],"styleReferences":["scripts/receipts-verify.py","bench/run-matrix.sh"]},"revision":"sha256:75b32ae929f161f972eb9544f33d653ee19a939a595012f6c112e3c4e69bb00e","title":"Author the wedge-safe stream-primitive first-light bench, its receipts bound, and the transport decision memo"},{"argv":["bash","-euc","timeout 900 python3 bench/usb4stream-bench.py"],"dependencies":["cp-close","usb4stream-bench"],"id":"cp-usb4stream","kind":"checkpoint","revision":"sha256:f15eb22132bfaf5a78e1f70eabb85b35e5a104c0518faea7aa225ea191ea98bb","runtimeMaxSec":1200,"title":"Checkpoint: single-open stream-primitive first light (dead-last; runs only when the serve is already down — a live pair on the shared cable is a typed skip; one open attempt ever; never a fail-status receipt)"},{"acceptanceCriteria":[{"argv":["bash","-euc","python3 -c \"import json; r=json.load(open('results/rocm10-probe.json')); assert r['step']=='rocm10-probe' and r['status'] and r['ts'] and isinstance(r['data'],dict) and 'build_ok' in r['data']\" && podman image exists localhost/flashnext:dev && python3 scripts/receipts-verify.py"],"description":"An outcome receipt exists outside the graded receipts dir, the 7.14 image survives untouched, and the receipts gate still passes.","id":"rocm10-probe-recorded"}],"conflictDomains":["results/rocm10-probe.json"],"deliveredBehaviors":["By morning the ROCm 10 question is answered with a measured receipt on this exact hardware instead of a guess","The proven 7.14 image and the whole receipt contract are untouchable by construction"],"dependencies":["cp-bench"],"goal":"Measure whether the ROCm 10.0.0 substrate is viable for this fork on this hardware, without touching the 7.14 lane that served the night. Context: a complete aligned gfx1151/cp312 wheel set exists at https://stable.repo.amd.com/rocm/whl-next/ (verified 2026-08-30; wheels dated 2026-08-26; same upstream versions and the SAME triton git hash 4cff872c as the current pins, so the swap is a pure version-literal substitution) — but no upstream anywhere has run this engine on ROCm 10 on gfx1151, and two failure modes are unmeasured: whether ROCm 10's hipcc compiles the fork's HIP sources, and whether its HSA runtime binds to the in-tree KFD on this kernel. This lane answers both as DATA. Build a second image flashnext:rocm10 from the UNMODIFIED container/Containerfile using its existing build ARGs (ROCM_WHL, TORCH_PIN, TORCHVISION_PIN, TRITON_PIN, ROCM_DEVEL_PIN, DEVICE_PINS at container/Containerfile:48-65 — no recipe edit, so the banked container-recipe acceptance stays true): podman build --tag flashnext:rocm10 --file container/Containerfile --build-arg ROCM_WHL=https://stable.repo.amd.com/rocm/whl-next/ --build-arg 'TORCH_PIN=torch==2.13.0+rocm10.0.0' --build-arg 'TORCHVISION_PIN=torchvision==0.28.0+rocm10.0.0' --build-arg 'TRITON_PIN=triton==3.8.0+git4cff872c.rocm10.0.0' --build-arg 'ROCM_DEVEL_PIN=rocm-sdk-devel==10.0.0' --build-arg 'DEVICE_PINS=amd-torch-device-gfx1151==2.13.0+rocm10.0.0 amd-torchvision-device-gfx1151==0.28.0+rocm10.0.0 rocm-sdk-device-gfx1151==10.0.0' . (a prefetched wheel set may exist under ~/.cache/flashnext-wheels/rocm10/). Then, on the coordinator only, run a minimal GPU binding check in that image (--device /dev/kfd --device /dev/dri --security-opt seccomp=unconfined --ipc=host): torch.cuda.is_available(), torch.cuda.get_device_properties(0).gcnArchName, a small fp16 and a small fp8-block matmul, and importing the engine package. Record the ROCm/HSA and KFD versions the runtime reports plus the running kernel release (a green probe on a 7.2.0 coordinator is strong but not conclusive for the pair; a red probe attributable to KFD must be re-checked on 7.2.2 before ROCm 10 is written off — say so in the notes field). Do not load the checkpoint, do not start a server, do not touch the worker. WRITE THE RECEIPT TO results/rocm10-probe.json — NOT under results/receipts/: scripts/receipts-verify.py fails the campaign gate on any fail-status receipt in that directory, and this lane exists to record an outcome, green or red, never to fail the campaign. The receipt carries {step:'rocm10-probe', status, ts, data:{build_ok, compile_seconds, torch, triton, rocm_sdk_core, gcn_arch, cuda_available, matmul_fp16_ok, matmul_fp8_block_ok, engine_import_ok, kernel_release, notes}} with status 'pass' whenever an outcome was recorded. Never remove or retag flashnext:dev; never edit container/, results/receipts/, or the worklist. If the night is running late this lane is the first thing the operator drops. Boundaries: touch only results/rocm10-probe.json.","id":"rocm10-probe","kind":"implementation","readFirst":{"specSections":["specs/flashnext/evidence/kyuz0-rocm10.md","IMPORTS.md"],"styleReferences":["container/build.sh"]},"revision":"sha256:4a52bd7af71d56aca32a6a809cde1d0baaaef8cbf991ef61f8f7fe52b4e69385","title":"Measure ROCm 10.0.0 viability on a separate image tag, off the critical path, after the bench"}],"warnings":["campaign pardon local://campaign/flashnext/attempt-receipts/44 pardoned 1 earlier machine receipt(s) for task(s) 'cp-weights', 'proxy-tooling'"]}
