ach module, each carries the notice header, and fn_offload_batch budget arithmetic matches the reference invariants (floor at max group size; promote counted in blocks). Boundaries: touch only container/rootfs/ and tests/.\",\"id\":\"instruments\",\"kind\":\"implementation\",\"readFirst\":{\"specSections\":[\"specs/flashnext/evidence/ds4-vllm-manifest.md\",\"specs/flashnext/evidence/qsa-53896.md\"],\"styleReferences\":[\"scripts/receipts-verify.py\"]},\"revision\":\"sha256:16ab40e19244fd0f9cde08858a2c348ff99e701e0a8ce46b6e99fc84b6d36c5b\",\"title\":\"Engagement-proof instruments adapted into the container overlay\"},\"workspace\":{\"baseRev\":\"ff1731c6c5886748faa13231e2f6012936bfb5dd\",\"branch\":\"tally-work/flashnext-e55ddef1f9e3/instruments\",\"conflictDomains\":[\"container/rootfs\",\"tests\"],\"publishBranch\":\"tally/flashnext-campaign-01a050a1-77a7-7483-8f11-139f1d7805ff/instruments-16ab40e19244fd0f\",\"taskId\":\"instruments\",\"worktreePath\":\"/home/tom/.local/state/tally/campaigns/flashnext/flashnext/e55ddef1f9e3/instruments\"},\"steering\":{\"channel\":\"locally-authorized-snapshot\",\"authorizedComments\":[],\"attemptReceipt\":{\"lateRecheckCommentIds\":[],\"preparedCommentIds\":[],\"recheckTruncated\":false,\"rechecked\":true,\"source\":{\"kind\":\"local-jsonl\",\"path\":\"/home/tom/.local/state/tally/campaigns/steering/01a050a1-77a7-7483-8f11-139f1d7805ff/steering-v1.jsonl\",\"preparedCursor\":0,\"recheckedCursor\":0,\"registrationId\":\"01a050a1-77a7-7483-8f11-139f1d7805ff\"}},\"machineDiagnoses\":[],\"machineOutcomes\":[]}}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
