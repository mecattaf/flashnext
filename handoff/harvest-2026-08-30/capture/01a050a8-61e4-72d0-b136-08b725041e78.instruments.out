{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D1BYnxLg8yrW1aF8YHBUJz","type":"tool_result","content":"############### container/rootfs/fn_synctrace.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_synctrace.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_synctrace.py),\n     4\t# Apache License 2.0. Changes: DS4_ surface renamed to FN_; the module is\n     5\t# driven from the flashnext FN_PROFILE window instead of ds4_tl_indexer.\n     6\t\"\"\"Attribute blocking device->host syncs to python call sites.\n     7\t\n     8\tThe upstream motivation (measured on ds4-vllm's 2026-08-07 profile):\n     9\thipMemcpyWithStream at 42% of decode self-CPU and hipStreamSynchronize at\n    10\t16% -- together the dominant cost, once kernel launches are down. But\n    11\t`hipMemcpyWithStream` in a profiler table is just a count; it does not say\n    12\twhich line caused it.\n    13\t\n    14\t`with_stack=True` on the torch profiler answers that in principle and is\n    15\tunusable in practice here: it captures a python stack for every one of\n    16\t~3,200 ops per step, which pegged the worker at 94% CPU and stalled the\n    17\tengine on shm_broadcast.\n    18\t\n    19\tThis is the cheap alternative. It wraps only the handful of Tensor methods\n    20\tthat can force a blocking D2H, and records one `sys._getframe` per call --\n    21\t~25 events per step rather than ~3,200. Overhead is a dict increment on an\n    22\talready-blocking operation, i.e. noise.\n    23\t\n    24\tLimitation worth knowing (retained from upstream): boolean-mask indexing\n    25\t(`x[mask]`) reaches nonzero() inside C++ `at::index`, not through the\n    26\tpython method, so it is NOT counted here. Anything unattributed after this\n    27\tis a candidate for that.\n    28\t\n    29\tDriven from the flashnext FN_PROFILE window driver so it shares that\n    30\twindow (no new env var of its own, hence no ray restart to propagate one).\n    31\tDefault off: nothing installs at import; install()/uninstall() bracket the\n    32\twindow and are the only switches.\n    33\t\"\"\"\n    34\t\n    35\timport collections\n    36\timport sys\n    37\t\n    38\timport torch\n    39\t\n    40\t_counts = collections.Counter()\n    41\t_installed = False\n    42\t_orig = {}\n    43\t# Tensor methods that block on a device->host transfer.\n    44\t_TARGETS = (\"item\", \"tolist\", \"cpu\", \"numpy\", \"nonzero\", \"__float__\", \"__int__\")\n    45\t\n    46\t\n    47\tdef _wrap(name):\n    48\t    orig = getattr(torch.Tensor, name)\n    49\t\n    50\t    def wrapper(self, *a, **kw):\n    51\t        try:\n    52\t            f = sys._getframe(1)\n    53\t            _counts[f\"{f.f_code.co_filename.split('site-packages/')[-1]}:\"\n    54\t                    f\"{f.f_lineno} {f.f_code.co_name}() [{name}]\"] += 1\n    55\t        except Exception:\n    56\t            pass\n    57\t        return orig(self, *a, **kw)\n    58\t\n    59\t    _orig[name] = orig\n    60\t    setattr(torch.Tensor, name, wrapper)\n    61\t\n    62\t\n    63\tdef install():\n    64\t    global _installed\n    65\t    if _installed:\n    66\t        return\n    67\t    for n in _TARGETS:\n    68\t        try:\n    69\t            _wrap(n)\n    70\t        except Exception:\n    71\t            pass\n    72\t    _installed = True\n    73\t\n    74\t\n    75\tdef uninstall():\n    76\t    global _installed\n    77\t    for n, o in _orig.items():\n    78\t        try:\n    79\t            setattr(torch.Tensor, n, o)\n    80\t        except Exception:\n    81\t            pass\n    82\t    _orig.clear()\n    83\t    _installed = False\n    84\t\n    85\t\n    86\tdef reset():\n    87\t    _counts.clear()\n    88\t\n    89\t\n    90\tdef report(steps=1.0):\n    91\t    \"\"\"Formatted table, per-decode-step, most frequent first.\"\"\"\n    92\t    if not _counts:\n    93\t        return (\"### BLOCKING-SYNC ATTRIBUTION ###\\n  (no events -- either the \"\n    94\t                \"tracer never installed, or every sync is bool-mask indexing / \"\n    95\t                \"C++-internal and invisible to a python hook)\\n\\n\")\n    96\t    total = sum(_counts.values())\n    97\t    out = [f\"### BLOCKING-SYNC ATTRIBUTION ({total} events over {steps:.2f} \"\n    98\t           f\"decode steps = {total / max(steps, 1e-9):.1f}/step) ###\"]\n    99\t    for site, n in _counts.most_common(30):\n   100\t        out.append(f\"  {n / max(steps, 1e-9):7.1f}/step  ({n:5d})  {site}\")\n   101\t    out.append(\"\")\n   102\t    return \"\\n\".join(out) + \"\\n\\n\"\n############### container/rootfs/fn_offload_batch.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_offload_batch.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_offload_batch.py),\n     4\t# Apache License 2.0. Changes: DS4_ env surface renamed to FN_\n     5\t# (FN_OFFLOAD_STORE_BATCH_FRAC, FN_OFFLOAD_PROMOTE_FRAC); arithmetic and\n     6\t# invariants unchanged from the reference.\n     7\t\"\"\"Store-batch budget for the KV offloading connector.\n     8\t\n     9\tWhy this exists\n    10\t---------------\n    11\t``OffloadingConnectorScheduler._build_store_jobs`` asks the offloading manager\n    12\tto stage every not-yet-offloaded block of a request in a single\n    13\t``prepare_store()`` call. That call is all-or-nothing: the CPU primary tier\n    14\treturns ``None`` unless it can make room for *every* key at once, and the\n    15\tcaller's failure path logs ``cannot store blocks`` and ``continue``s **without\n    16\tadvancing** ``next_stored_block_idx``.\n    17\t\n    18\tSo a single refusal is not self-correcting. The next step recomputes the range\n    19\tfrom the same unadvanced cursor against a larger ``num_offloadable_tokens``,\n    20\tasks for strictly more than it just failed to get, and fails again. The ask\n    21\tratchets upward until the request is demanding its entire prefix in one call,\n    22\twhich no small tier can ever satisfy. The observed symptom upstream — a 182K\n    23\tprefill against a 256 MiB tier refusing stores — reads like \"the tier must be\n    24\tsized to the in-flight sequence\", but the tier is a proper LRU cache with\n    25\trefcounting: ``TieringOffloadingManager.complete_store`` pins a block via\n    26\t``primary.prepare_read()`` and ``_process_finished_jobs`` unpins it via\n    27\t``primary.complete_read()`` as soon as the secondary-tier write lands. Blocks\n    28\t*do* recycle. Nothing was bounding the ask.\n    29\t\n    30\tBounding it turns the primary tier into a streaming window: each step stages at\n    31\tmost a budget's worth of blocks, those drain to disk, their ref_cnt drops, and\n    32\tthe next step reuses the same slots. The tier then has to cover the drain\n    33\tlatency, not the sequence — which is what makes a disk cache affordable behind\n    34\ta few hundred MiB of RAM.\n    35\t\n    36\tThis lives outside ``vllm`` so the budget arithmetic is unit-testable without\n    37\timporting torch or the connector's dependency graph.\n    38\t\"\"\"\n    39\t\n    40\timport os\n    41\t\n    42\t__all__ = [\n    43\t    \"resolve_store_batch_tokens\",\n    44\t    \"resolve_promote_block_budget\",\n    45\t    \"DEFAULT_FRAC\",\n    46\t    \"FRAC_ENV\",\n    47\t    \"DEFAULT_PROMOTE_FRAC\",\n    48\t    \"PROMOTE_FRAC_ENV\",\n    49\t]\n    50\t\n    51\tFRAC_ENV = \"FN_OFFLOAD_STORE_BATCH_FRAC\"\n    52\tPROMOTE_FRAC_ENV = \"FN_OFFLOAD_PROMOTE_FRAC\"\n    53\t\n    54\t# A quarter of the tier per step. The remaining three quarters absorb blocks\n    55\t# whose disk write is still in flight (ref_cnt > 0, so not evictable) plus the\n    56\t# resident prefix-cache entries the tier exists to serve.\n    57\tDEFAULT_FRAC = 0.25\n    58\t\n    59\t# Half the tier per request for reads. Promotion has the mirror-image failure\n    60\t# of the store ratchet, and it is worse because it wastes disk bandwidth before\n    61\t# failing: lookup() initiates one promotion per matched block with nothing\n    62\t# bounding the total, so a prefix longer than the primary tier evicts its own\n    63\t# earlier promotions to make room for later ones. The prefix is then never\n    64\t# wholly resident, _maximal_prefix_lookup never confirms it, and the request\n    65\t# recomputes everything anyway -- after paying the full disk read. Measured\n    66\t# upstream on a 4,645-token prompt against a 258-block tier: 258 blocks\n    67\t# (512 MiB) read from disk, \"cannot store blocks\", and zero hits.\n    68\t#\n    69\t# Capping the ask below the tier size means the promoted prefix stays resident,\n    70\t# so a partial hit is real work saved instead of thrash. The remainder is left\n    71\t# for in-flight stores, which share the same tier.\n    72\tDEFAULT_PROMOTE_FRAC = 0.5\n    73\t\n    74\t\n    75\tdef _read_frac(frac: float | None, env: str, default: float) -> float:\n    76\t    if frac is not None:\n    77\t        return frac\n    78\t    raw = os.getenv(env)\n    79\t    if raw is None or raw == \"\":\n    80\t        return default\n    81\t    try:\n    82\t        return float(raw)\n    83\t    except ValueError:\n    84\t        return default\n    85\t\n    86\t\n    87\tdef resolve_store_batch_tokens(\n    88\t    num_blocks: int | None,\n    89\t    offloaded_block_sizes: \"list[int] | tuple[int, ...]\",\n    90\t    frac: float | None = None,\n    91\t) -> int | None:\n    92\t    \"\"\"Token budget for one prepare_store() call, or None for unbounded.\n    93\t\n    94\t    Args:\n    95\t        num_blocks: Blocks in the CPU primary tier. None/0 (a spec that does\n    96\t            not expose it) disables bounding.\n    97\t        offloaded_block_sizes: ``offloaded_block_size`` of every KV group. One\n    98\t            token range yields one key per group, so the key count a token\n    99\t            budget produces is the sum of the per-group rates.\n   100\t        frac: Fraction of the tier to spend per step. Defaults to\n   101\t            ``$FN_OFFLOAD_STORE_BATCH_FRAC`` then ``DEFAULT_FRAC``. A value\n   102\t            <= 0 disables bounding, restoring stock vLLM behaviour.\n   103\t\n   104\t    Returns:\n   105\t        Token budget, never smaller than one block of the coarsest group.\n   106\t\n   107\t        That floor is load-bearing, not a rounding nicety. Groups keep separate\n   108\t        cursors over a shared token position, so a budget measured from the\n   109\t        laggard group has to be wide enough to reach every group's existing\n   110\t        cursor; the gap is at most one block of the coarsest group. Below the\n   111\t        floor, some group's target would land under its own cursor, and\n   112\t        ``_build_store_jobs`` assigns ``next_stored_block_idx = num_blocks``\n   113\t        outright — it never takes a max — so the cursor would rewind and the\n   114\t        blocks in between would be skipped for good.\n   115\t    \"\"\"\n   116\t    return _budget(num_blocks, offloaded_block_sizes, frac, FRAC_ENV, DEFAULT_FRAC)\n   117\t\n   118\t\n   119\tdef resolve_promote_block_budget(\n   120\t    num_blocks: int | None, frac: float | None = None\n   121\t) -> int | None:\n   122\t    \"\"\"Max blocks one request may promote, or None for unbounded.\n   123\t\n   124\t    Deliberately counted in **blocks, not tokens**. The token form of this\n   125\t    budget divides by the summed per-group key rate, which a sliding-window\n   126\t    group wrecks: its blocks are tiny and numerous (208 of them against 26 for\n   127\t    a full-attention group on the same 4,645 tokens, measured upstream), so it\n   128\t    dominates the rate and collapses the budget to a few hundred tokens --\n   129\t    about 6% of the prompt -- even though its lookup only ever touches a\n   130\t    bounded tail. Counting the promotions themselves needs no model of any of\n   131\t    that.\n   132\t\n   133\t    Applies to the full-attention prefix scan only; see the call site.\n   134\t    ``FN_OFFLOAD_PROMOTE_FRAC=0`` restores stock behaviour (promote the whole\n   135\t    matched prefix, and thrash if it does not fit).\n   136\t    \"\"\"\n   137\t    if not num_blocks or num_blocks <= 0:\n   138\t        return None\n   139\t    frac = _read_frac(frac, PROMOTE_FRAC_ENV, DEFAULT_PROMOTE_FRAC)\n   140\t    if frac <= 0:\n   141\t        return None\n   142\t    return max(1, int(num_blocks * min(frac, 1.0)))\n   143\t\n   144\t\n   145\tdef _budget(num_blocks, offloaded_block_sizes, frac, env, default):\n   146\t    if not num_blocks or num_blocks <= 0:\n   147\t        return None\n   148\t    sizes = [int(s) for s in offloaded_block_sizes if s and s > 0]\n   149\t    if not sizes:\n   150\t        return None\n   151\t\n   152\t    frac = _read_frac(frac, env, default)\n   153\t    if frac <= 0:\n   154\t        return None\n   155\t\n   156\t    budget_blocks = max(1, int(num_blocks * min(frac, 1.0)))\n   157\t    keys_per_token = sum(1.0 / s for s in sizes)\n   158\t    budget_tokens = int(budget_blocks / keys_per_token)\n   159\t\n   160\t    return max(budget_tokens, max(sizes))\n############### container/rootfs/fn_expert_union.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_expert_union.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_expert_union.py),\n     4\t# Apache License 2.0. Changes:\n     5\t#   - DS4_ env surface renamed to FN_ (kill switch FN_EXPERT_UNION, default off).\n     6\t#   - The wrap is RE-TARGETED. Upstream wrapped the gpt-oss triton_kernels\n     7\t#     routing entry (gpt_oss_triton_kernels_moe.make_routing_data), which the\n     8\t#     flashnext workload never calls: it routes through the stock fused-mixture\n     9\t#     FusedTopKRouter instead (specs/flashnext/evidence/qsa-53896.md section 4).\n    10\t#     This wraps fused_topk in\n    11\t#     vllm/model_executor/layers/fused_moe/router/fused_topk_router.py.\n    12\t\"\"\"FN_EXPERT_UNION=1: measure how many DISTINCT experts a decode step touches.\n    13\t\n    14\tThe decode roof is dominated by routed-expert bytes, and those scale with the\n    15\t*union* of experts the step's positions select, not with top-k-per-token.\n    16\tIndependent routing pushes that union toward num_experts per layer; perfectly\n    17\tcorrelated routing keeps it at top-k. That spread moves the physics ceiling by\n    18\ta large factor, and nothing static can settle it -- it has to be measured\n    19\tagainst real traffic.\n    20\t\n    21\tThis wraps ``fused_topk`` in vLLM's stock fused-mixture router entry\n    22\t(``vllm/model_executor/layers/fused_moe/router/fused_topk_router.py``), the\n    23\tchoke point the flashnext workload actually routes through (FusedMoEFactory ->\n    24\tFusedTopKRouter -> fused_topk). The upstream ds4 target -- the gpt-oss\n    25\ttriton_kernels ``make_routing_data`` -- is never on this model's path, and\n    26\tvLLM's own ``--enable-return-routed-experts`` capturer hangs off\n    27\t``BaseRouter.route()``, which the fused path does not call either.\n    28\t\n    29\t``num_local_experts`` is read from ``gating_output.shape[-1]`` (router logits\n    30\tare ``[M, num_experts]``): tensor shape is host metadata, so that costs no\n    31\tdevice sync.\n    32\t\n    33\tPer call it records (n_rows, n_distinct, n_local_experts) into a preallocated\n    34\tdevice buffer using only elementwise kernels -- no D2H copy, no sync, so it\n    35\tdoes not serialise the step it is measuring. The buffer is copied out once\n    36\twhen the window closes. Slot 0 of the seen-mask absorbs any -1 padding rows so\n    37\tno boolean mask (and therefore no size-dependent sync) is needed.\n    38\t\n    39\tCost: a few extra small kernel launches per routing call. Off unless\n    40\tFN_EXPERT_UNION=1.\n    41\t\n    42\tEnv:\n    43\t    FN_EXPERT_UNION=1         enable (default: off)\n    44\t    FN_EU_START=200           skip this many calls first (warmup + prefill)\n    45\t    FN_EU_CALLS=2000          window size in routing calls\n    46\t    FN_EU_OUT=~/vllm-prof     output directory\n    47\t\n    48\tInstall is deliberately lazy: by the first decode the MoE layers are long\n    49\tsince built, and wrapping at import time of whatever loads this module would\n    50\trisk a circular import. The caller drives install() once the engine is up;\n    51\tinstall() itself re-checks FN_EXPERT_UNION, so a stale call stays a no-op.\n    52\tA probe must never take the engine down: every failure path swallows the\n    53\texception.\n    54\t\"\"\"\n    55\t\n    56\timport atexit\n    57\timport os\n    58\t\n    59\timport torch\n    60\t\n    61\t_ENABLED = os.environ.get(\"FN_EXPERT_UNION\") == \"1\"\n    62\t_START = int(os.environ.get(\"FN_EU_START\", \"200\"))\n    63\t_CALLS = int(os.environ.get(\"FN_EU_CALLS\", \"2000\"))\n    64\t_OUT = os.path.expanduser(os.environ.get(\"FN_EU_OUT\", \"~/vllm-prof\"))\n    65\t\n    66\t_buf = None          # [_CALLS, 3] int32 on device\n    67\t_n = 0               # calls seen\n    68\t_done = False\n    69\t_installed = False\n    70\t\n    71\t\n    72\tdef _record(topk_ids, num_local_experts):\n    73\t    \"\"\"Accumulate one routing call. Device-only; never synchronises.\"\"\"\n    74\t    global _buf, _n, _done\n    75\t    if _done or not num_local_experts:\n    76\t        return\n    77\t    _n += 1\n    78\t    if _n <= _START:\n    79\t        return\n    80\t    i = _n - _START - 1\n    81\t    if i >= _CALLS:\n    82\t        _flush()\n    83\t        return\n    84\t\n    85\t    ids = topk_ids.reshape(-1).long()\n    86\t    if _buf is None:\n    87\t        _buf = torch.zeros(_CALLS, 3, dtype=torch.int32, device=ids.device)\n    88\t\n    89\t    # Slot 0 absorbs the -1 padding rows so no boolean mask (and therefore no\n    90\t    # size-dependent sync) is needed; real experts land at 1..num_local.\n    91\t    seen = torch.zeros(num_local_experts + 1, dtype=torch.bool, device=ids.device)\n    92\t    seen[ids + 1] = True\n    93\t\n    94\t    _buf[i, 0] = topk_ids.shape[0]\n    95\t    _buf[i, 1] = seen[1:].sum()\n    96\t    _buf[i, 2] = num_local_experts\n    97\t\n    98\t\n    99\tdef _flush():\n   100\t    \"\"\"Copy the buffer out once and write the dump.\"\"\"\n   101\t    global _done\n   102\t    if _done or _buf is None:\n   103\t        return\n   104\t    _done = True\n   105\t    try:\n   106\t        rows = _buf.cpu().tolist()\n   107\t        os.makedirs(_OUT, exist_ok=True)\n   108\t        path = os.path.join(_OUT, f\"expert_union_{os.getpid()}.tsv\")\n   109\t        with open(path, \"w\") as fh:\n   110\t            fh.write(\"# n_rows\\tn_distinct\\tn_local_experts\\n\")\n   111\t            for n_rows, n_distinct, n_local in rows:\n   112\t                if n_rows:\n   113\t                    fh.write(f\"{n_rows}\\t{n_distinct}\\t{n_local}\\n\")\n   114\t        print(f\"[fn_expert_union] wrote {path}\", flush=True)\n   115\t    except Exception as exc:  # a probe must never take the engine down\n   116\t        print(f\"[fn_expert_union] flush failed: {exc}\", flush=True)\n   117\t\n   118\t\n   119\tdef install():\n   120\t    \"\"\"Idempotently wrap fused_topk. Safe to call more than once.\"\"\"\n   121\t    global _installed\n   122\t    if not _ENABLED or _installed:\n   123\t        return\n   124\t    try:\n   125\t        from vllm.model_executor.layers.fused_moe.router import (\n   126\t            fused_topk_router as m,\n   127\t        )\n   128\t    except Exception as exc:\n   129\t        print(f\"[fn_expert_union] not installed: {exc}\", flush=True)\n   130\t        return\n   131\t\n   132\t    orig = m.fused_topk\n   133\t\n   134\t    def wrapped(*a, **kw):\n   135\t        res = orig(*a, **kw)\n   136\t        try:\n   137\t            # fused_topk(hidden_states, gating_output, topk, renormalize)\n   138\t            # -> (topk_weights, topk_ids). num_local_experts comes off\n   139\t            # gating_output's shape -- host metadata, no device sync.\n   140\t            gating = kw.get(\"gating_output\")\n   141\t            if gating is None and len(a) > 1:\n   142\t                gating = a[1]\n   143\t            topk_ids = res[1] if isinstance(res, tuple) and len(res) >= 2 else None\n   144\t            n_local = gating.shape[-1] if gating is not None else None\n   145\t            if topk_ids is not None:\n   146\t                _record(topk_ids, n_local)\n   147\t        except Exception:\n   148\t            pass  # never let the probe break routing\n   149\t        return res\n   150\t\n   151\t    wrapped._fn_orig = orig\n   152\t    m.fused_topk = wrapped\n   153\t    _installed = True\n   154\t    # Also flush on shutdown, so a run that ends before the window fills still\n   155\t    # leaves a (shorter) usable dump rather than nothing.\n   156\t    atexit.register(_flush)\n   157\t    print(\n   158\t        f\"[fn_expert_union] installed: skip {_START} calls, window {_CALLS}, \"\n   159\t        f\"out {_OUT}\",\n   160\t        flush=True,\n   161\t    )","is_error":false}]},"parent_tool_use_id":null,"session_id":"1182cd30-62fd-41c8-9446-e16b11d402f2","uuid":"3e5085bd-d242-40ea-9ffd-42d53601c2bd","timestamp":"2026-08-30T03:14:13.009Z","tool_use_result":{"stdout":"############### container/rootfs/fn_synctrace.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_synctrace.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_synctrace.py),\n     4\t# Apache License 2.0. Changes: DS4_ surface renamed to FN_; the module is\n     5\t# driven from the flashnext FN_PROFILE window instead of ds4_tl_indexer.\n     6\t\"\"\"Attribute blocking device->host syncs to python call sites.\n     7\t\n     8\tThe upstream motivation (measured on ds4-vllm's 2026-08-07 profile):\n     9\thipMemcpyWithStream at 42% of decode self-CPU and hipStreamSynchronize at\n    10\t16% -- together the dominant cost, once kernel launches are down. But\n    11\t`hipMemcpyWithStream` in a profiler table is just a count; it does not say\n    12\twhich line caused it.\n    13\t\n    14\t`with_stack=True` on the torch profiler answers that in principle and is\n    15\tunusable in practice here: it captures a python stack for every one of\n    16\t~3,200 ops per step, which pegged the worker at 94% CPU and stalled the\n    17\tengine on shm_broadcast.\n    18\t\n    19\tThis is the cheap alternative. It wraps only the handful of Tensor methods\n    20\tthat can force a blocking D2H, and records one `sys._getframe` per call --\n    21\t~25 events per step rather than ~3,200. Overhead is a dict increment on an\n    22\talready-blocking operation, i.e. noise.\n    23\t\n    24\tLimitation worth knowing (retained from upstream): boolean-mask indexing\n    25\t(`x[mask]`) reaches nonzero() inside C++ `at::index`, not through the\n    26\tpython method, so it is NOT counted here. Anything unattributed after this\n    27\tis a candidate for that.\n    28\t\n    29\tDriven from the flashnext FN_PROFILE window driver so it shares that\n    30\twindow (no new env var of its own, hence no ray restart to propagate one).\n    31\tDefault off: nothing installs at import; install()/uninstall() bracket the\n    32\twindow and are the only switches.\n    33\t\"\"\"\n    34\t\n    35\timport collections\n    36\timport sys\n    37\t\n    38\timport torch\n    39\t\n    40\t_counts = collections.Counter()\n    41\t_installed = False\n    42\t_orig = {}\n    43\t# Tensor methods that block on a device->host transfer.\n    44\t_TARGETS = (\"item\", \"tolist\", \"cpu\", \"numpy\", \"nonzero\", \"__float__\", \"__int__\")\n    45\t\n    46\t\n    47\tdef _wrap(name):\n    48\t    orig = getattr(torch.Tensor, name)\n    49\t\n    50\t    def wrapper(self, *a, **kw):\n    51\t        try:\n    52\t            f = sys._getframe(1)\n    53\t            _counts[f\"{f.f_code.co_filename.split('site-packages/')[-1]}:\"\n    54\t                    f\"{f.f_lineno} {f.f_code.co_name}() [{name}]\"] += 1\n    55\t        except Exception:\n    56\t            pass\n    57\t        return orig(self, *a, **kw)\n    58\t\n    59\t    _orig[name] = orig\n    60\t    setattr(torch.Tensor, name, wrapper)\n    61\t\n    62\t\n    63\tdef install():\n    64\t    global _installed\n    65\t    if _installed:\n    66\t        return\n    67\t    for n in _TARGETS:\n    68\t        try:\n    69\t            _wrap(n)\n    70\t        except Exception:\n    71\t            pass\n    72\t    _installed = True\n    73\t\n    74\t\n    75\tdef uninstall():\n    76\t    global _installed\n    77\t    for n, o in _orig.items():\n    78\t        try:\n    79\t            setattr(torch.Tensor, n, o)\n    80\t        except Exception:\n    81\t            pass\n    82\t    _orig.clear()\n    83\t    _installed = False\n    84\t\n    85\t\n    86\tdef reset():\n    87\t    _counts.clear()\n    88\t\n    89\t\n    90\tdef report(steps=1.0):\n    91\t    \"\"\"Formatted table, per-decode-step, most frequent first.\"\"\"\n    92\t    if not _counts:\n    93\t        return (\"### BLOCKING-SYNC ATTRIBUTION ###\\n  (no events -- either the \"\n    94\t                \"tracer never installed, or every sync is bool-mask indexing / \"\n    95\t                \"C++-internal and invisible to a python hook)\\n\\n\")\n    96\t    total = sum(_counts.values())\n    97\t    out = [f\"### BLOCKING-SYNC ATTRIBUTION ({total} events over {steps:.2f} \"\n    98\t           f\"decode steps = {total / max(steps, 1e-9):.1f}/step) ###\"]\n    99\t    for site, n in _counts.most_common(30):\n   100\t        out.append(f\"  {n / max(steps, 1e-9):7.1f}/step  ({n:5d})  {site}\")\n   101\t    out.append(\"\")\n   102\t    return \"\\n\".join(out) + \"\\n\\n\"\n############### container/rootfs/fn_offload_batch.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_offload_batch.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_offload_batch.py),\n     4\t# Apache License 2.0. Changes: DS4_ env surface renamed to FN_\n     5\t# (FN_OFFLOAD_STORE_BATCH_FRAC, FN_OFFLOAD_PROMOTE_FRAC); arithmetic and\n     6\t# invariants unchanged from the reference.\n     7\t\"\"\"Store-batch budget for the KV offloading connector.\n     8\t\n     9\tWhy this exists\n    10\t---------------\n    11\t``OffloadingConnectorScheduler._build_store_jobs`` asks the offloading manager\n    12\tto stage every not-yet-offloaded block of a request in a single\n    13\t``prepare_store()`` call. That call is all-or-nothing: the CPU primary tier\n    14\treturns ``None`` unless it can make room for *every* key at once, and the\n    15\tcaller's failure path logs ``cannot store blocks`` and ``continue``s **without\n    16\tadvancing** ``next_stored_block_idx``.\n    17\t\n    18\tSo a single refusal is not self-correcting. The next step recomputes the range\n    19\tfrom the same unadvanced cursor against a larger ``num_offloadable_tokens``,\n    20\tasks for strictly more than it just failed to get, and fails again. The ask\n    21\tratchets upward until the request is demanding its entire prefix in one call,\n    22\twhich no small tier can ever satisfy. The observed symptom upstream — a 182K\n    23\tprefill against a 256 MiB tier refusing stores — reads like \"the tier must be\n    24\tsized to the in-flight sequence\", but the tier is a proper LRU cache with\n    25\trefcounting: ``TieringOffloadingManager.complete_store`` pins a block via\n    26\t``primary.prepare_read()`` and ``_process_finished_jobs`` unpins it via\n    27\t``primary.complete_read()`` as soon as the secondary-tier write lands. Blocks\n    28\t*do* recycle. Nothing was bounding the ask.\n    29\t\n    30\tBounding it turns the primary tier into a streaming window: each step stages at\n    31\tmost a budget's worth of blocks, those drain to disk, their ref_cnt drops, and\n    32\tthe next step reuses the same slots. The tier then has to cover the drain\n    33\tlatency, not the sequence — which is what makes a disk cache affordable behind\n    34\ta few hundred MiB of RAM.\n    35\t\n    36\tThis lives outside ``vllm`` so the budget arithmetic is unit-testable without\n    37\timporting torch or the connector's dependency graph.\n    38\t\"\"\"\n    39\t\n    40\timport os\n    41\t\n    42\t__all__ = [\n    43\t    \"resolve_store_batch_tokens\",\n    44\t    \"resolve_promote_block_budget\",\n    45\t    \"DEFAULT_FRAC\",\n    46\t    \"FRAC_ENV\",\n    47\t    \"DEFAULT_PROMOTE_FRAC\",\n    48\t    \"PROMOTE_FRAC_ENV\",\n    49\t]\n    50\t\n    51\tFRAC_ENV = \"FN_OFFLOAD_STORE_BATCH_FRAC\"\n    52\tPROMOTE_FRAC_ENV = \"FN_OFFLOAD_PROMOTE_FRAC\"\n    53\t\n    54\t# A quarter of the tier per step. The remaining three quarters absorb blocks\n    55\t# whose disk write is still in flight (ref_cnt > 0, so not evictable) plus the\n    56\t# resident prefix-cache entries the tier exists to serve.\n    57\tDEFAULT_FRAC = 0.25\n    58\t\n    59\t# Half the tier per request for reads. Promotion has the mirror-image failure\n    60\t# of the store ratchet, and it is worse because it wastes disk bandwidth before\n    61\t# failing: lookup() initiates one promotion per matched block with nothing\n    62\t# bounding the total, so a prefix longer than the primary tier evicts its own\n    63\t# earlier promotions to make room for later ones. The prefix is then never\n    64\t# wholly resident, _maximal_prefix_lookup never confirms it, and the request\n    65\t# recomputes everything anyway -- after paying the full disk read. Measured\n    66\t# upstream on a 4,645-token prompt against a 258-block tier: 258 blocks\n    67\t# (512 MiB) read from disk, \"cannot store blocks\", and zero hits.\n    68\t#\n    69\t# Capping the ask below the tier size means the promoted prefix stays resident,\n    70\t# so a partial hit is real work saved instead of thrash. The remainder is left\n    71\t# for in-flight stores, which share the same tier.\n    72\tDEFAULT_PROMOTE_FRAC = 0.5\n    73\t\n    74\t\n    75\tdef _read_frac(frac: float | None, env: str, default: float) -> float:\n    76\t    if frac is not None:\n    77\t        return frac\n    78\t    raw = os.getenv(env)\n    79\t    if raw is None or raw == \"\":\n    80\t        return default\n    81\t    try:\n    82\t        return float(raw)\n    83\t    except ValueError:\n    84\t        return default\n    85\t\n    86\t\n    87\tdef resolve_store_batch_tokens(\n    88\t    num_blocks: int | None,\n    89\t    offloaded_block_sizes: \"list[int] | tuple[int, ...]\",\n    90\t    frac: float | None = None,\n    91\t) -> int | None:\n    92\t    \"\"\"Token budget for one prepare_store() call, or None for unbounded.\n    93\t\n    94\t    Args:\n    95\t        num_blocks: Blocks in the CPU primary tier. None/0 (a spec that does\n    96\t            not expose it) disables bounding.\n    97\t        offloaded_block_sizes: ``offloaded_block_size`` of every KV group. One\n    98\t            token range yields one key per group, so the key count a token\n    99\t            budget produces is the sum of the per-group rates.\n   100\t        frac: Fraction of the tier to spend per step. Defaults to\n   101\t            ``$FN_OFFLOAD_STORE_BATCH_FRAC`` then ``DEFAULT_FRAC``. A value\n   102\t            <= 0 disables bounding, restoring stock vLLM behaviour.\n   103\t\n   104\t    Returns:\n   105\t        Token budget, never smaller than one block of the coarsest group.\n   106\t\n   107\t        That floor is load-bearing, not a rounding nicety. Groups keep separate\n   108\t        cursors over a shared token position, so a budget measured from the\n   109\t        laggard group has to be wide enough to reach every group's existing\n   110\t        cursor; the gap is at most one block of the coarsest group. Below the\n   111\t        floor, some group's target would land under its own cursor, and\n   112\t        ``_build_store_jobs`` assigns ``next_stored_block_idx = num_blocks``\n   113\t        outright — it never takes a max — so the cursor would rewind and the\n   114\t        blocks in between would be skipped for good.\n   115\t    \"\"\"\n   116\t    return _budget(num_blocks, offloaded_block_sizes, frac, FRAC_ENV, DEFAULT_FRAC)\n   117\t\n   118\t\n   119\tdef resolve_promote_block_budget(\n   120\t    num_blocks: int | None, frac: float | None = None\n   121\t) -> int | None:\n   122\t    \"\"\"Max blocks one request may promote, or None for unbounded.\n   123\t\n   124\t    Deliberately counted in **blocks, not tokens**. The token form of this\n   125\t    budget divides by the summed per-group key rate, which a sliding-window\n   126\t    group wrecks: its blocks are tiny and numerous (208 of them against 26 for\n   127\t    a full-attention group on the same 4,645 tokens, measured upstream), so it\n   128\t    dominates the rate and collapses the budget to a few hundred tokens --\n   129\t    about 6% of the prompt -- even though its lookup only ever touches a\n   130\t    bounded tail. Counting the promotions themselves needs no model of any of\n   131\t    that.\n   132\t\n   133\t    Applies to the full-attention prefix scan only; see the call site.\n   134\t    ``FN_OFFLOAD_PROMOTE_FRAC=0`` restores stock behaviour (promote the whole\n   135\t    matched prefix, and thrash if it does not fit).\n   136\t    \"\"\"\n   137\t    if not num_blocks or num_blocks <= 0:\n   138\t        return None\n   139\t    frac = _read_frac(frac, PROMOTE_FRAC_ENV, DEFAULT_PROMOTE_FRAC)\n   140\t    if frac <= 0:\n   141\t        return None\n   142\t    return max(1, int(num_blocks * min(frac, 1.0)))\n   143\t\n   144\t\n   145\tdef _budget(num_blocks, offloaded_block_sizes, frac, env, default):\n   146\t    if not num_blocks or num_blocks <= 0:\n   147\t        return None\n   148\t    sizes = [int(s) for s in offloaded_block_sizes if s and s > 0]\n   149\t    if not sizes:\n   150\t        return None\n   151\t\n   152\t    frac = _read_frac(frac, env, default)\n   153\t    if frac <= 0:\n   154\t        return None\n   155\t\n   156\t    budget_blocks = max(1, int(num_blocks * min(frac, 1.0)))\n   157\t    keys_per_token = sum(1.0 / s for s in sizes)\n   158\t    budget_tokens = int(budget_blocks / keys_per_token)\n   159\t\n   160\t    return max(budget_tokens, max(sizes))\n############### container/rootfs/fn_expert_union.py\n     1\t# SPDX-License-Identifier: Apache-2.0\n     2\t# Adapted from ds4_expert_union.py in AlexKGwyn/ds4-vllm @ a8f620d\n     3\t# (container/rootfs/opt/venv/lib/python3.12/site-packages/ds4_expert_union.py),\n     4\t# Apache License 2.0. Changes:\n     5\t#   - DS4_ env surface renamed to FN_ (kill switch FN_EXPERT_UNION, default off).\n     6\t#   - The wrap is RE-TARGETED. Upstream wrapped the gpt-oss triton_kernels\n     7\t#     routing entry (gpt_oss_triton_kernels_moe.make_routing_data), which the\n     8\t#     flashnext workload never calls: it routes through the stock fused-mixture\n     9\t#     FusedTopKRouter instead (specs/flashnext/evidence/qsa-53896.md section 4).\n    10\t#     This wraps fused_topk in\n    11\t#     vllm/model_executor/layers/fused_moe/router/fused_topk_router.py.\n    12\t\"\"\"FN_EXPERT_UNION=1: measure how many DISTINCT experts a decode step touches.\n    13\t\n    14\tThe decode roof is dominated by routed-expert bytes, and those scale with the\n    15\t*union* of experts the step's positions select, not with top-k-per-token.\n    16\tIndependent routing pushes that union toward num_experts per layer; perfectly\n    17\tcorrelated routing keeps it at top-k. That spread moves the physics ceiling by\n    18\ta large factor, and nothing static can settle it -- it has to be measured\n    19\tagainst real traffic.\n    20\t\n    21\tThis wraps ``fused_topk`` in vLLM's stock fused-mixture router entry\n    22\t(``vllm/model_executor/layers/fused_moe/router/fused_topk_router.py``), the\n    23\tchoke point the flashnext workload actually routes through (FusedMoEFactory ->\n    24\tFusedTopKRouter -> fused_topk). The upstream ds4 target -- the gpt-oss\n    25\ttriton_kernels ``make_routing_data`` -- is never on this model's path, and\n    26\tvLLM's own ``--enable-return-routed-experts`` capturer hangs off\n    27\t``BaseRouter.route()``, which the fused path does not call either.\n    28\t\n    29\t``num_local_experts`` is read from ``gating_output.shape[-1]`` (router logits\n    30\tare ``[M, num_experts]``): tensor shape is host metadata, so that costs no\n    31\tdevice sync.\n    32\t\n    33\tPer call it records (n_rows, n_distinct, n_local_experts) into a preallocated\n    34\tdevice buffer using only elementwise kernels -- no D2H copy, no sync, so it\n    35\tdoes not serialise the step it is measuring. The buffer is copied out once\n    36\twhen the window closes. Slot 0 of the seen-mask absorbs any -1 padding rows so\n    37\tno boolean mask (and therefore no size-dependent sync) is needed.\n    38\t\n    39\tCost: a few extra small kernel launches per routing call. Off unless\n    40\tFN_EXPERT_UNION=1.\n    41\t\n    42\tEnv:\n    43\t    FN_EXPERT_UNION=1         enable (default: off)\n    44\t    FN_EU_START=200           skip this many calls first (warmup + prefill)\n    45\t    FN_EU_CALLS=2000          window size in routing calls\n    46\t    FN_EU_OUT=~/vllm-prof     output directory\n    47\t\n    48\tInstall is deliberately lazy: by the first decode the MoE layers are long\n    49\tsince built, and wrapping at import time of whatever loads this module would\n    50\trisk a circular import. The caller drives install() once the engine is up;\n    51\tinstall() itself re-checks FN_EXPERT_UNION, so a stale call stays a no-op.\n    52\tA probe must never take the engine down: every failure path swallows the\n    53\texception.\n    54\t\"\"\"\n    55\t\n    56\timport atexit\n    57\timport os\n    58\t\n    59\timport torch\n    60\t\n    61\t_ENABLED = os.environ.get(\"FN_EXPERT_UNION\") == \"1\"\n    62\t_START = int(os.environ.get(\"FN_EU_START\", \"200\"))\n    63\t_CALLS = int(os.environ.get(\"FN_EU_CALLS\", \"2000\"))\n    64\t_OUT = os.path.expanduser(os.environ.get(\"FN_EU_OUT\", \"~/vllm-prof\"))\n    65\t\n    66\t_buf = None          # [_CALLS, 3] int32 on device\n    67\t_n = 0               # calls seen\n    68\t_done = False\n    69\t_installed = False\n    70\t\n    71\t\n    72\tdef _record(topk_ids, num_local_experts):\n    73\t    \"\"\"Accumulate one routing call. Device-only; never synchronises.\"\"\"\n    74\t    global _buf, _n, _done\n    75\t    if _done or not num_local_experts:\n    76\t        return\n    77\t    _n += 1\n    78\t    if _n <= _START:\n    79\t        return\n    80\t    i = _n - _START - 1\n    81\t    if i >= _CALLS:\n    82\t        _flush()\n    83\t        return\n    84\t\n    85\t    ids = topk_ids.reshape(-1).long()\n    86\t    if _buf is None:\n    87\t        _buf = torch.zeros(_CALLS, 3, dtype=torch.int32, device=ids.device)\n    88\t\n    89\t    # Slot 0 absorbs the -1 padding rows so no boolean mask (and therefore no\n    90\t    # size-dependent sync) is needed; real experts land at 1..num_local.\n    91\t    seen = torch.zeros(num_local_experts + 1, dtype=torch.bool, device=ids.device)\n    92\t    seen[ids + 1] = True\n    93\t\n    94\t    _buf[i, 0] = topk_ids.shape[0]\n    95\t    _buf[i, 1] = seen[1:].sum()\n    96\t    _buf[i, 2] = num_local_experts\n    97\t\n    98\t\n    99\tdef _flush():\n   100\t    \"\"\"Copy the buffer out once and write the dump.\"\"\"\n   101\t    global _done\n   102\t    if _done or _buf is None:\n   103\t        return\n   104\t    _done = True\n   105\t    try:\n   106\t        rows = _buf.cpu().tolist()\n   107\t        os.makedirs(_OUT, exist_ok=True)\n   108\t        path = os.path.join(_OUT, f\"expert_union_{os.getpid()}.tsv\")\n   109\t        with open(path, \"w\") as fh:\n   110\t            fh.write(\"# n_rows\\tn_distinct\\tn_local_experts\\n\")\n   111\t            for n_rows, n_distinct, n_local in rows:\n   112\t                if n_rows:\n   113\t                    fh.write(f\"{n_rows}\\t{n_distinct}\\t{n_local}\\n\")\n   114\t        print(f\"[fn_expert_union] wrote {path}\", flush=True)\n   115\t    except Exception as exc:  # a probe must never take the engine down\n   116\t        print(f\"[fn_expert_union] flush failed: {exc}\", flush=True)\n   117\t\n   118\t\n   119\tdef install():\n   120\t    \"\"\"Idempotently wrap fused_topk. Safe to call more than once.\"\"\"\n   121\t    global _installed\n   122\t    if not _ENABLED or _installed:\n   123\t        return\n   124\t    try:\n   125\t        from vllm.model_executor.layers.fused_moe.router import (\n   126\t            fused_topk_router as m,\n   127\t        )\n   128\t    except Exception as exc:\n   129\t        print(f\"[fn_expert_union] not installed: {exc}\", flush=True)\n   130\t        return\n   131\t\n   132\t    orig = m.fused_topk\n   133\t\n   134\t    def wrapped(*a, **kw):\n   135\t        res = orig(*a, **kw)\n   136\t        try:\n   137\t            # fused_topk(hidden_states, gating_output, topk, renormalize)\n   138\t            # -> (topk_weights, topk_ids). num_local_experts comes off\n   139\t            # gating_output's shape -- host metadata, no device sync.\n   140\t            gating = kw.get(\"gating_output\")\n   141\t            if gating is None and len(a) > 1:\n   142\t                gating = a[1]\n   143\t            topk_ids = res[1] if isinstance(res, tuple) and len(res) >= 2 else None\n   144\t            n_local = gating.shape[-1] if gating is not None else None\n   145\t            if topk_ids is not None:\n   146\t                _record(topk_ids, n_local)\n   147\t        except Exception:\n   148\t            pass  # never let the probe break routing\n   149\t        return res\n   150\t\n   151\t    wrapped._fn_orig = orig\n   152\t    m.fused_topk = wrapped\n   153\t    _installed = True\n   154\t    # Also flush on shutdown, so a run that ends before the window fills still\n   155\t    # leaves a (shorter) usable dump rather than nothing.\n   156\t    atexit.register(_flush)\n   157\t    print(\n   158\t        f\"[fn_expert_union] installed: skip {_START} calls, window {_CALLS}, \"\n   159\t        f\"out {_OUT}\",\n   160\t        flush=True,\n   161\t    )","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
