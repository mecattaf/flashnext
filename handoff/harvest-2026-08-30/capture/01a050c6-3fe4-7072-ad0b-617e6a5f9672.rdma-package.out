05 Aug 30 05:46 SCOPING-REPORT.md\n--- tests:\ntotal 52\ndrwxr-xr-x  2 tom users  4096 Aug 30 05:46 .\ndrwxr-xr-x 13 tom users  4096 Aug 30 05:46 ..\n-rw-r--r--  1 tom users 10102 Aug 30 05:46 test_bench_client.py\n-rw-r--r--  1 tom users  2840 Aug 30 05:46 test_bench_matrix.py\n-rw-r--r--  1 tom users  9434 Aug 30 05:46 test_host_tooling.py\n-rw-r--r--  1 tom users  7047 Aug 30 05:46 test_instruments.py\n-rw-r--r--  1 tom users  5326 Aug 30 05:46 test_repo_invariants.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
