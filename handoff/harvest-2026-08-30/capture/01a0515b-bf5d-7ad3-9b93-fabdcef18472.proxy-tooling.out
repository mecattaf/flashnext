users  3187 Aug 30 08:29 run-smoke.sh\n-rwxr-xr-x  1 tom users 19189 Aug 30 08:29 run-tp2.sh\n-rw-r--r--  1 tom users  2138 Aug 30 08:29 stage-weights-both.sh\n-rw-r--r--  1 tom users  2814 Aug 30 08:29 stage-weights.sh\n-rw-r--r--  1 tom users  3002 Aug 30 08:29 verify-fork.sh\n--- tests ---\ntotal 76\ndrwxr-xr-x  2 tom users  4096 Aug 30 08:29 .\ndrwxr-xr-x 13 tom users  4096 Aug 30 08:29 ..\n-rw-r--r--  1 tom users  2984 Aug 30 08:29 RECONCILE-instruments-2026-08-30.md\n-rw-r--r--  1 tom users 10102 Aug 30 08:29 test_bench_client.py\n-rw-r--r--  1 tom users  2840 Aug 30 08:29 test_bench_matrix.py\n-rw-r--r--  1 tom users  9434 Aug 30 08:29 test_host_tooling.py\n-rw-r--r--  1 tom users  7047 Aug 30 08:29 test_instruments.py\n-rw-r--r--  1 tom users  4797 Aug 30 08:29 test_rdma_package.py\n-rw-r--r--  1 tom users  5326 Aug 30 08:29 test_repo_invariants.py\n-rw-r--r--  1 tom users 11725 Aug 30 08:29 test_usb4stream_bench.py\n--- results ---\nresults/receipts/.gitkeep\nresults/receipts/weights-coordinator.json\nresults/receipts/build.json\nresults/receipts/weights-worker.json","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
