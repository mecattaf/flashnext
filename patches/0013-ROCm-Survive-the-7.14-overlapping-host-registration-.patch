+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pins on the ROCm 7.14 overlapping-host-registration path of the PLE mmap
+table (RUN3-BRIEF 15.1 / 16.1, ds4_rocm_runtime.cuh:5513-5600).
+
+No GPU: ``torch.cuda.cudart()`` and the pinned allocator are stood in for, so
+every error code the real runtime returns can be driven deterministically —
+including the two that only appear on a 7.14 box with a ~51.2 GB engram table.
+"""
+
+from __future__ import annotations
+
+import logging
+import mmap
+from collections.abc import Iterator
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import safetensors.torch
+import torch
+
+import vllm.models.qwen4_exp.common.ple_mmap as ple_mmap
+
+# The codes the live stack returned when two page-overlapping spans of one
+# mapping were registered inside flashnext:dev on 2026-08-31.
+_OK = 0
+_ALREADY_REGISTERED = 712
+_INVALID_VALUE = 1
+_NOT_SUPPORTED = 801
+
+
+# --------------------------------------------------------------------------- #
+# Fixtures / helpers
+# --------------------------------------------------------------------------- #
+
+
+@pytest.fixture(autouse=True)
+def _restore_mapping_latch() -> Iterator[None]:
+    """The 'mapping unsupported' latch is process-wide by design; no test may
+    leak it into the next one."""
+    saved = ple_mmap._mapping_supported
+    yield
+    ple_mmap._mapping_supported = saved
+
+
+class _FakeCudart:
+    """Records every register/unregister and replays a scripted verdict."""
+
+    def __init__(self, codes: list[int]) -> None:
+        self._codes = list(codes)
+        self.registered: list[tuple[int, int, int]] = []
+        self.unregistered: list[int] = []
+
+    def cudaHostRegister(self, ptr: int, nbytes: int, flags: int) -> object:
+        self.registered.append((ptr, nbytes, flags))
+        code = self._codes.pop(0) if self._codes else _OK
+        return SimpleNamespace(value=code)
+
+    def cudaHostUnregister(self, ptr: int) -> object:
+        self.unregistered.append(ptr)
+        return SimpleNamespace(value=_OK)
+
+
+class _StageRecorder:
+    """Stands in for cudaMallocHost/cudaFreeHost so the bounce's size, its
+    presence, and its release can be asserted without a GPU."""
+
+    def __init__(self) -> None:
+        self.allocated: list[int] = []
+        self.freed: list[int] = []
+
+    def install(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        def alloc(nbytes: int) -> torch.Tensor:
+            self.allocated.append(nbytes)
+            return torch.empty(nbytes, dtype=torch.uint8)
+
+        def free(stage: torch.Tensor) -> None:
+            self.freed.append(int(stage.numel()))
+
+        monkeypatch.setattr(ple_mmap, "_alloc_pinned_stage", alloc)
+        monkeypatch.setattr(ple_mmap, "_free_pinned_stage", free)
+
+
+def _use_fake_cudart(monkeypatch: pytest.MonkeyPatch, codes: list[int]) -> _FakeCudart:
+    fake = _FakeCudart(codes)
+    monkeypatch.setattr(torch.cuda, "cudart", lambda: fake)
+    monkeypatch.setattr(
+        ple_mmap,
+        "current_platform",
+        SimpleNamespace(is_cuda_alike=lambda: True, device_name="rocm"),
+    )
+    return fake
+
+
+def _write_ple_layer(directory: Path, *, vocab: int, parts: int, cols: int) -> None:
+    prefix = "model.language_model.layers.0.ple.ple_embedding.ngram_embedding"
+    shard_size = (vocab + parts - 1) // parts
+    raw = torch.arange(vocab * cols, dtype=torch.float32).reshape(vocab, cols)
+    full = (torch.remainder(raw, 6.0) - 3.0).to(torch.float8_e4m3fn)
+    for shard_index in range(parts):
+        start = shard_index * shard_size
+        rows = max(0, min(shard_size, vocab - start))
+        tensors: dict[str, torch.Tensor] = {}
+        if rows > 0:
+            tensors[f"{prefix}.shard_{shard_index}.weight"] = full[start : start + rows]
+        if shard_index == 0:
+            tensors[f"{prefix}.weight_scale"] = torch.tensor(
+                [1.0], dtype=torch.bfloat16
+            )
+        if tensors:
+            safetensors.torch.save_file(
+                tensors, str(directory / f"model-ple-{shard_index:05d}.safetensors")
+            )
+
+
+def _build_table(directory: Path, *, vocab: int, parts: int, cols: int):
+    layer_shards = ple_mmap.discover_shards(str(directory))[0]
+    return ple_mmap.MmapPleTable(
+        layer_shards.shards,
+        (vocab + parts - 1) // parts,
+        cols,
+        torch.float8_e4m3fn,
+        workers=1,
+        chunk=8,
+        model_path=str(directory),
+    )
+
+
+# --------------------------------------------------------------------------- #
+# The rounding is the mechanism: it manufactures the collision.
+# --------------------------------------------------------------------------- #
+
+
+def test_page_rounded_span_rounds_base_down_and_length_up() -> None:
+    page = ple_mmap._page_size()
+    span = ple_mmap.page_rounded_span(page * 4 + 100, 10)
+
+    assert span.base == page * 4
+    assert span.delta == 100
+    # 100 + 10 bytes still costs a whole page.
+    assert span.nbytes == page
+    assert span.base % page == 0
+    assert span.nbytes % page == 0
+
+
+def test_page_rounded_spans_of_disjoint_slices_collide() -> None:
+    """RUN3-BRIEF 15.1's claim, as an executable assertion: two slices that do
+    not overlap by a single byte overlap once rounded, which is why a 51.2 GB
+    table sliced on non-page boundaries hits this as the common case."""
+    page = ple_mmap._page_size()
+    base = page * 64
+    first = ple_mmap.page_rounded_span(base, page + 8)
+    second = ple_mmap.page_rounded_span(base + page + 8, page)
+
+    assert base + page + 8 >= base + (page + 8)  # the slices are disjoint
+    assert first.base + first.nbytes > second.base  # their spans are not
+
+
+def test_mapping_span_is_page_aligned_and_covers_the_array(tmp_path: Path) -> None:
+    payload = bytes(range(256)) * 64
+    path = tmp_path / "shard.bin"
+    path.write_bytes(payload)
+    offset = 100  # deliberately not page-aligned
+    array = np.memmap(
+        path, dtype=np.uint8, mode="r", offset=offset, shape=(len(payload) - offset,)
+    )
+
+    span = ple_mmap.mapping_span(array)
+
+    assert span is not None
+    assert span.base % ple_mmap._page_size() == 0
+    assert span.delta == offset % mmap.ALLOCATIONGRANULARITY
+    # The whole array lives inside the registered extent.
+    assert span.base + span.nbytes >= array.ctypes.data + array.nbytes
+
+
+def test_mapping_span_returns_none_for_a_non_mmap_array() -> None:
+    assert ple_mmap.mapping_span(np.zeros(16, dtype=np.uint8)) is None
+
+
+def test_mapping_spans_of_two_shards_do_not_overlap(tmp_path: Path) -> None:
+    """The alignment mitigation of 16.1: registering the mapping extents
+    instead of the rounded slice spans is what stops shards colliding."""
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    try:
+        spans = [ple_mmap.mapping_span(a) for a in table.mm if a is not None]
+        assert all(s is not None for s in spans)
+        ordered = sorted(spans, key=lambda s: s.base)
+        for lower, upper in zip(ordered, ordered[1:]):
+            assert lower.base + lower.nbytes <= upper.base
+    finally:
+        table.close()
+
+
+# --------------------------------------------------------------------------- #
+# host_register: rejection is survivable, never fatal.
+# --------------------------------------------------------------------------- #
+
+
+def test_host_register_records_spans_and_close_unregisters_them(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    fake = _use_fake_cudart(monkeypatch, [])
+
+    table.host_register()
+
+    assert len(table.registered) == 4
+    assert not table.overlapping
+    # Mapped | ReadOnly, as ds4_rocm_runtime.cuh:5525 registers model ranges.
+    assert all(flags == 0x02 | 0x08 for _ptr, _n, flags in fake.registered)
+
+    registered_bases = [span.base for span in table.registered]
+    table.close()
+    assert fake.unregistered == registered_bases
+    assert table.registered == []
+
+
+def test_overlap_rejection_latches_staging_without_failing_the_load(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    fake = _use_fake_cudart(monkeypatch, [_OK, _ALREADY_REGISTERED, _OK, _OK])
+    try:
+        table.host_register()  # must not raise: the load has to continue
+
+        assert table.overlapping is True
+        # The rejected shard is not recorded, the other three still are, and
+        # the loop did not stop at the rejection.
+        assert len(fake.registered) == 4
+        assert len(table.registered) == 3
+    finally:
+        table.close()
+
+
+def test_unsupported_error_latches_process_wide_and_logs_loudly(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+) -> None:
+    """ds4_rocm_runtime.cuh:5548 disables host mapping for the whole process
+    on one bad code and says nothing. It has to say something."""
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    _use_fake_cudart(monkeypatch, [_NOT_SUPPORTED])
+    try:
+        with caplog.at_level(logging.ERROR, logger=ple_mmap.logger.name):
+            table.host_register()
+
+        assert ple_mmap._mapping_supported is False
+        assert not table.overlapping  # nothing was registered, so copies are fine
+        errors = [r for r in caplog.records if r.levelno >= logging.ERROR]
+        assert len(errors) == 1
+        assert "LATCHED OFF" in errors[0].getMessage()
+    finally:
+        table.close()
+
+
+@pytest.mark.parametrize("code", [_INVALID_VALUE, _NOT_SUPPORTED])
+def test_unsupported_error_stops_registering_further_shards(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, code: int
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    fake = _use_fake_cudart(monkeypatch, [code])
+    try:
+        table.host_register()
+        assert len(fake.registered) == 1
+    finally:
+        table.close()
+
+
+def test_host_register_is_skipped_once_the_latch_is_set(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    fake = _use_fake_cudart(monkeypatch, [])
+    ple_mmap._mapping_supported = False
+    try:
+        table.host_register()
+        assert fake.registered == []
+        assert not table.overlapping
+    finally:
+        table.close()
+
+
+def test_host_register_is_skipped_off_cuda(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    fake = _FakeCudart([])
+    monkeypatch.setattr(torch.cuda, "cudart", lambda: fake)
+    monkeypatch.setattr(
+        ple_mmap,
+        "current_platform",
+        SimpleNamespace(is_cuda_alike=lambda: False, device_name="cpu"),
+    )
+    try:
+        table.host_register()
+        assert fake.registered == []
+    finally:
+        table.close()
+
+
+# --------------------------------------------------------------------------- #
+# to_device: the bounce is on the overlap path only, capped, and always freed.
+# --------------------------------------------------------------------------- #
+
+
+def test_stage_chunk_is_capped_at_64_mib() -> None:
+    assert ple_mmap._STAGE_CHUNK_BYTES == 64 << 20
+
+
+def test_ordinary_path_never_allocates_a_bounce(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+    try:
+        host = torch.arange(32, dtype=torch.uint8)
+        got = table.to_device(host, torch.device("cpu"))
+
+        assert torch.equal(got, host)
+        assert recorder.allocated == []
+    finally:
+        table.close()
+
+
+def test_staged_copy_is_byte_exact_across_chunks(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+    monkeypatch.setattr(ple_mmap, "_STAGE_CHUNK_BYTES", 64)
+    host = torch.arange(200, dtype=torch.uint8).reshape(25, 8).view(torch.float8_e4m3fn)
+
+    got = ple_mmap.staged_copy_to_device(host, torch.device("cpu"))
+
+    assert got.shape == host.shape
+    assert got.dtype == host.dtype
+    assert torch.equal(got.view(torch.uint8), host.view(torch.uint8))
+    # One bounce for the whole copy, capped at the chunk, released once.
+    assert recorder.allocated == [64]
+    assert recorder.freed == [64]
+
+
+def test_staged_copy_caps_the_bounce_below_the_payload(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+    monkeypatch.setattr(ple_mmap, "_STAGE_CHUNK_BYTES", 16)
+
+    ple_mmap.staged_copy_to_device(
+        torch.arange(4096, dtype=torch.uint8), torch.device("cpu")
+    )
+
+    assert recorder.allocated == [16]  # not 4096: RSS is bounded by the cap
+
+
+def test_staged_copy_uses_the_whole_payload_when_it_is_smaller(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+
+    ple_mmap.staged_copy_to_device(
+        torch.arange(8, dtype=torch.uint8), torch.device("cpu")
+    )
+
+    assert recorder.allocated == [8]
+
+
+def test_staged_copy_frees_the_bounce_on_an_error_exit(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+
+    def exploding_empty(*args: object, **kwargs: object) -> torch.Tensor:
+        raise RuntimeError("copy blew up mid-chunk")
+
+    monkeypatch.setattr(ple_mmap.torch, "empty", exploding_empty, raising=True)
+    with pytest.raises(RuntimeError, match="copy blew up"):
+        ple_mmap.staged_copy_to_device(
+            torch.arange(32, dtype=torch.uint8), torch.device("cpu")
+        )
+    # torch.empty is the destination alloc, which happens BEFORE the bounce:
+    # nothing to free yet, and nothing leaked.
+    assert recorder.allocated == []
+    assert recorder.freed == []
+
+
+def test_staged_copy_frees_the_bounce_when_a_chunk_fails(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+
+    def alloc(nbytes: int) -> torch.Tensor:
+        recorder.allocated.append(nbytes)
+
+        class _Poisoned(torch.Tensor):
+            def copy_(self, *args: object, **kwargs: object) -> torch.Tensor:
+                raise RuntimeError("staged chunk failed")
+
+        return torch.empty(nbytes, dtype=torch.uint8).as_subclass(_Poisoned)
+
+    monkeypatch.setattr(ple_mmap, "_alloc_pinned_stage", alloc)
+    with pytest.raises(RuntimeError, match="staged chunk failed"):
+        ple_mmap.staged_copy_to_device(
+            torch.arange(32, dtype=torch.uint8), torch.device("cpu")
+        )
+
+    assert recorder.allocated == [32]
+    assert recorder.freed == [32]  # freed on the error exit, not only on success
+
+
+def test_staged_copy_of_an_empty_tensor_allocates_nothing(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+
+    got = ple_mmap.staged_copy_to_device(
+        torch.empty(0, dtype=torch.uint8), torch.device("cpu")
+    )
+
+    assert got.numel() == 0
+    assert recorder.allocated == []
+
+
+# --------------------------------------------------------------------------- #
+# The half that is easy to miss: the copy fails too.
+# --------------------------------------------------------------------------- #
+
+
+def _poison_to(monkeypatch: pytest.MonkeyPatch, message: str) -> list[int]:
+    """Make the first Tensor.to raise ``message``; later calls behave."""
+    calls: list[int] = []
+    real_to = torch.Tensor.to
+
+    def fake_to(self: torch.Tensor, *args: object, **kwargs: object) -> torch.Tensor:
+        calls.append(1)
+        if len(calls) == 1:
+            raise RuntimeError(message)
+        return real_to(self, *args, **kwargs)
+
+    monkeypatch.setattr(torch.Tensor, "to", fake_to, raising=True)
+    return calls
+
+
+def test_a_poisoned_plain_copy_latches_staging_and_still_returns_the_rows(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+) -> None:
+    """16.1's second row: after the rejected registration, a plain H2D from
+    that pointer fails with hipErrorInvalidValue. Detecting the registration
+    error is not enough — this is the path that proves the copy changed too."""
+    _write_ple_layer(tmp_path, vocab=64, parts=4, cols=8)
+    table = _build_table(tmp_path, vocab=64, parts=4, cols=8)
+    recorder = _StageRecorder()
+    recorder.install(monkeypatch)
+    host = torch.arange(32, dtype=torch.uint8)
+    _poison_to(
+        monkeypatch,
+        "CUDA error: invalid argument\nSearch for `hipErrorInvalidValue'",
+    )
+    try:
