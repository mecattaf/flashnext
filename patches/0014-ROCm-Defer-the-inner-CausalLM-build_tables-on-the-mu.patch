             ignore_unexpected_suffixes=_QWEN4_EXP_IGNORED_MISSING_SUFFIXES.copy(),
         )
         loaded = loader.load_weights(weights, mapper=mapper)
-        if ple_mmap.enabled():
+        if ple_mmap.enabled() and not self._ple_build_tables_deferred:
             ple_mmap.build_tables(
                 self.model_config, get_current_vllm_config().compilation_config
             )
@@ -913,6 +914,11 @@ class Qwen4ExpForConditionalGeneration(
                 vllm_config=vllm_config,
                 prefix=maybe_prefix(prefix, "language_model"),
             )
+        # AutoWeightsLoader dispatches a child's load_weights once per
+        # contiguous run of its prefix in the stream, so the inner call can
