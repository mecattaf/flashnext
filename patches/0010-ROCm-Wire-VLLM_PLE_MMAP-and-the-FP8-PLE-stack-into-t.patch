+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_PLE_MMAP and the FP8 PLE stack on the ROCm (amd/) model tree.
+
+The mmap path used to be wired exclusively into ``nvidia/``: on a ROCm build
+the ``amd/`` tree is imported instead, ``ple_mmap`` was never imported, the
+custom op was never registered, and ``VLLM_PLE_MMAP=1`` was a silent no-op.
+These tests pin the wiring so a future refactor cannot quietly un-wire it.
+
+No GPU and no ROCm runtime required: every assertion here is construction,
+weight-loading, or dtype bookkeeping on CPU tensors. Fixtures mirror
+``test_ple_mmap.py``.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+import vllm.model_executor.layers.vocab_parallel_embedding as embedding_module
+import vllm.model_executor.parameter as parameter_module
+import vllm.models.qwen4_exp.amd.model as amd_model_module
+import vllm.models.qwen4_exp.amd.ple_layer as amd_ple_layer_module
+import vllm.models.qwen4_exp.common.ple_mmap as ple_mmap
+from vllm.config import CompilationConfig, set_current_vllm_config
+from vllm.config.compilation import CompilationMode, CUDAGraphMode
+from vllm.model_executor.layers.quantization.fp8 import Fp8Config
+from vllm.models.qwen4_exp.amd.ple_layer import (
+    Qwen4ExpNGramEmbedding,
+    Qwen4ExpPLELayer,
+)
+
+# --------------------------------------------------------------------------- #
+# Fixtures / helpers (mirrors test_ple_mmap.py)
+# --------------------------------------------------------------------------- #
+
+
+@pytest.fixture(autouse=True)
+def _reset_ple_mmap_env(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Every test starts from a clean, default-off environment."""
+    for name in (
+        "VLLM_PLE_MMAP",
+        "VLLM_PLE_MMAP_WORKERS",
+        "VLLM_PLE_MMAP_CHUNK",
+        "VLLM_PLE_MMAP_PREWARM",
+    ):
+        monkeypatch.delenv(name, raising=False)
+
+
+@pytest.fixture(autouse=True)
+def _allow_single_rank_tensor_parallel(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Stock VocabParallelEmbedding needs a TP group; stand in a rank-0/size-1
+    world without paying for real torch.distributed init (mirrors test_ple.py).
+    """
+    monkeypatch.setattr(embedding_module, "get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr(
+        embedding_module, "get_tensor_model_parallel_world_size", lambda: 1
+    )
+    monkeypatch.setattr(parameter_module, "get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr(
+        parameter_module, "get_tensor_model_parallel_world_size", lambda: 1
+    )
+
+
+def _make_text_config(**overrides: object) -> SimpleNamespace:
+    values: dict[str, object] = dict(
+        ngram_size=3,
+        heads_per_ngram=2,
+        eos_token_id=0,
+        vocab_size=200,
+        split_ngram_parts=4,
+        ngram_vocab_size_base=1000,
+        make_ngram_vocab_size_divisible_by=1,
+    )
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def _piecewise_compilation_config(**overrides: object) -> CompilationConfig:
+    """The only compilation shape check_cudagraph_safety accepts; each guard
+    test overrides exactly one field so a failure can only mean that guard."""
+    values: dict[str, object] = dict(
+        mode=CompilationMode.VLLM_COMPILE,
+        cudagraph_mode=CUDAGraphMode.PIECEWISE,
+        splitting_ops=[ple_mmap.QUALIFIED_OP_NAME],
+    )
+    values.update(overrides)
+    return CompilationConfig(**values)
+
+
+def _make_amd_embedding(
+    quant_config: Fp8Config | None = None,
+    params_dtype: torch.dtype | None = None,
+) -> Qwen4ExpNGramEmbedding:
+    return Qwen4ExpNGramEmbedding(
+        _make_text_config(),
+        8,
+        0,
+        16,
+        4,
+        "model.layers.1.ple.ple_embedding",
+        "model.layers.1.ple",
+        quant_config=quant_config,
+        params_dtype=params_dtype,
+    )
+
+
+def _fp8_quant_config() -> Fp8Config:
+    return Fp8Config(
+        is_checkpoint_fp8_serialized=True,
+        ignored_layers=[],
+        weight_block_size=[128, 128],
+    )
+
+
+# --------------------------------------------------------------------------- #
+# The import relocation: both trees must reach the SAME module object, so
+# the custom op is registered exactly once and build_tables walks one
+# static_forward_context.
+# --------------------------------------------------------------------------- #
+
+
+def test_amd_tree_imports_ple_mmap_from_the_common_package() -> None:
+    assert ple_mmap.__name__ == "vllm.models.qwen4_exp.common.ple_mmap"
+    assert amd_ple_layer_module.ple_mmap is ple_mmap
+    assert amd_model_module.ple_mmap is ple_mmap
+
+
+def test_amd_ple_embedding_exposes_the_name_the_mmap_op_probes_for() -> None:
+    """ple_mmap's op body resolves layer_name -> ple_embedding and refuses
+    anything without ``_hash_ngram_ids``; renaming the AMD helper would turn
+    every mmap forward into 'does not resolve to a PLE layer'."""
+    assert callable(getattr(Qwen4ExpNGramEmbedding, "_hash_ngram_ids", None))
+
+
+# --------------------------------------------------------------------------- #
+# Constructor swap (W3) and its guards, on the AMD class.
+# --------------------------------------------------------------------------- #
+
+
+def test_env_off_construction_keeps_the_stock_embedding() -> None:
+    module = _make_amd_embedding(params_dtype=torch.bfloat16)
+
+    assert isinstance(module.ngram_embedding, embedding_module.VocabParallelEmbedding)
+    assert not isinstance(module.ngram_embedding, ple_mmap.MmapNgramEmbedding)
+
+
+def test_env_on_construction_swaps_in_the_mmap_placeholder(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("VLLM_PLE_MMAP", "1")
+    # An empty model_config makes resolve_model_path raise, which
+    # validate_shards_for tolerates (it logs and defers to build_tables) —
+    # the same construction-without-a-checkpoint shape the nvidia tests use.
+    vllm_config = SimpleNamespace(
+        compilation_config=_piecewise_compilation_config(),
+        model_config=SimpleNamespace(),
+    )
+
+    with set_current_vllm_config(vllm_config):
+        module = _make_amd_embedding(params_dtype=torch.bfloat16)
+
+    assert isinstance(module.ngram_embedding, ple_mmap.MmapNgramEmbedding)
+    assert module.ngram_embedding.embedding_dim == module.head_dim
+    # gfx1151 is not fnuz (RocmPlatform.is_fp8_fnuz() is "gfx94" only), and
+    # the checkpoint bytes are OCP e4m3 on every platform: relabelling would
+    # be numerically wrong, not a portability fix.
+    assert module.ngram_embedding.torch_dtype == torch.float8_e4m3fn
+
+
+@pytest.mark.parametrize(
+    "cudagraph_mode",
+    [
+        CUDAGraphMode.FULL,
+        CUDAGraphMode.FULL_DECODE_ONLY,
+        CUDAGraphMode.FULL_AND_PIECEWISE,
+    ],
+)
+def test_env_on_construction_refuses_full_cudagraph_modes(
+    monkeypatch: pytest.MonkeyPatch, cudagraph_mode: CUDAGraphMode
+) -> None:
+    """The AMD short-conv path is written for FULL cudagraphs; the mmap
+    forward cannot run inside a capture. The refusal must be loud at
+    construction, not a silent downgrade."""
+    monkeypatch.setenv("VLLM_PLE_MMAP", "1")
+    vllm_config = SimpleNamespace(
+        compilation_config=_piecewise_compilation_config(cudagraph_mode=cudagraph_mode),
+        model_config=SimpleNamespace(),
+    )
+
+    with (
+        set_current_vllm_config(vllm_config),
+        pytest.raises(RuntimeError, match="piecewise-only CUDA graphs"),
+    ):
+        _make_amd_embedding(params_dtype=torch.bfloat16)
+
+
+def test_env_on_construction_refuses_missing_splitting_op(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("VLLM_PLE_MMAP", "1")
+    vllm_config = SimpleNamespace(
+        compilation_config=_piecewise_compilation_config(
+            splitting_ops=["vllm::some_other_op"]
+        ),
+        model_config=SimpleNamespace(),
+    )
+
+    with (
+        set_current_vllm_config(vllm_config),
+        pytest.raises(RuntimeError, match="splitting_ops"),
+    ):
+        _make_amd_embedding(params_dtype=torch.bfloat16)
+
+
+# --------------------------------------------------------------------------- #
+# load_weights interception (W5a/W5b) on the AMD loader.
+# --------------------------------------------------------------------------- #
+
+
+def test_env_on_load_weights_keeps_the_scale_and_drops_the_shards(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("VLLM_PLE_MMAP", "1")
+    vllm_config = SimpleNamespace(
+        compilation_config=_piecewise_compilation_config(),
+        model_config=SimpleNamespace(),
+    )
+    with set_current_vllm_config(vllm_config):
+        module = _make_amd_embedding(params_dtype=torch.bfloat16)
+
+    embedding = module.ngram_embedding
+    assert isinstance(embedding, ple_mmap.MmapNgramEmbedding)
+    vocab = embedding.org_vocab_size
+    parts = module.split_ngram_parts
+    shard_size = (vocab + parts - 1) // parts
+    weight_scale = torch.tensor([0.25], dtype=torch.bfloat16)
+
+    loaded = module.load_weights(
+        [
+            (
+                "ngram_embedding.shard_0.weight",
+                torch.zeros((shard_size, module.head_dim), dtype=torch.float8_e4m3fn),
+            ),
+            ("ngram_embedding.weight_scale", weight_scale),
+        ]
+    )
+
+    assert loaded == {"ngram_embedding.weight", "ngram_embedding.weight_scale"}
+    assert torch.equal(embedding.weight_scale, weight_scale)
+    assert embedding.weight_scale_loaded is True
+    # The shard was streamed and dropped: no resident table, but the
+    # placeholder now refuses to serve zeros until build_tables attaches one.
+    assert embedding.weights_streamed is True
+    assert embedding.table is None
+
+
+# --------------------------------------------------------------------------- #
+# Blocker A: the FP8 PLE stack the AMD tree did not have. Without it an
+# FP8 checkpoint's ngram_embedding.weight_scale is an orphan the AMD loader
+# hands to AutoWeightsLoader (ValueError), and the table is bare-cast to
+# bf16 with the block scale discarded.
+# --------------------------------------------------------------------------- #
+
+
+def test_fp8_checkpoint_selects_the_fp8_embedding_method() -> None:
+    module = _make_amd_embedding(
+        quant_config=_fp8_quant_config(), params_dtype=torch.bfloat16
+    )
+
+    embedding = module.ngram_embedding
+    assert isinstance(
+        embedding.quant_method, amd_ple_layer_module.Qwen4ExpPLEFp8EmbeddingMethod
+    )
+    assert embedding.weight.dtype == torch.float8_e4m3fn
+    assert embedding.weight_scale.dtype == torch.bfloat16
+
+
+def test_unquantized_checkpoint_keeps_the_stock_embedding_method() -> None:
+    module = _make_amd_embedding(params_dtype=torch.bfloat16)
+
+    assert not isinstance(
+        module.ngram_embedding.quant_method,
+        amd_ple_layer_module.Qwen4ExpPLEFp8EmbeddingMethod,
+    )
+    assert module.ngram_embedding.weight.dtype == torch.bfloat16
+
+
+def test_gather_output_buffer_follows_the_table_dtype_not_params_dtype() -> None:
+    """The AMD gather op writes into a preallocated buffer. Allocating it at
+    params_dtype (bf16) would make output.copy_() a bare FP8->BF16 cast that
+    silently drops the checkpoint scale before _dequantize_embeddings ever
+    sees an FP8 tensor."""
+    fp8 = _make_amd_embedding(
+        quant_config=_fp8_quant_config(), params_dtype=torch.bfloat16
+    )
+    assert fp8.ngram_embedding.params_dtype == torch.bfloat16
+    assert fp8._embedding_output_dtype() == torch.float8_e4m3fn
+
+    stock = _make_amd_embedding(params_dtype=torch.bfloat16)
+    assert stock._embedding_output_dtype() == torch.bfloat16
+
+
+def test_ple_layer_dequantizes_fp8_embeddings_with_the_checkpoint_scale() -> None:
+    """__new__ + a manual nn.Module.__init__ skips the heavy real __init__,
+    but _get_embedding_weight_scale/_dequantize_embeddings stay the REAL
+    bound methods, exercising the actual getattr chain (mirrors
+    test_ple_mmap.py's equivalence test)."""
+    module = _make_amd_embedding(
+        quant_config=_fp8_quant_config(), params_dtype=torch.bfloat16
+    )
+    module.ngram_embedding.weight_scale.data.copy_(
+        torch.tensor([0.25], dtype=torch.bfloat16)
+    )
+    layer = Qwen4ExpPLELayer.__new__(Qwen4ExpPLELayer)
+    nn.Module.__init__(layer)
+    layer.ple_embedding = module
+
+    embeddings = torch.tensor([[1.0, -2.0]], dtype=torch.float32).to(
+        torch.float8_e4m3fn
+    )
+    got = layer._dequantize_embeddings(embeddings, torch.bfloat16)
+
+    assert got.dtype == torch.bfloat16
+    assert torch.equal(got, torch.tensor([[0.25, -0.5]], dtype=torch.bfloat16))
+
+
+def test_ple_layer_leaves_non_fp8_embeddings_untouched() -> None:
+    module = _make_amd_embedding(params_dtype=torch.bfloat16)
+    layer = Qwen4ExpPLELayer.__new__(Qwen4ExpPLELayer)
+    nn.Module.__init__(layer)
+    layer.ple_embedding = module
+
+    embeddings = torch.tensor([[1.0, -2.0]], dtype=torch.bfloat16)
+    got = layer._dequantize_embeddings(embeddings, torch.bfloat16)
+
+    assert got is embeddings
+
+
+def test_ple_layer_refuses_fp8_embeddings_with_no_scale() -> None:
+    """Fail closed: an FP8 table with no scale must raise, never serve
+    unscaled ±448 values into key_proj/value_proj."""
+    layer = Qwen4ExpPLELayer.__new__(Qwen4ExpPLELayer)
+    nn.Module.__init__(layer)
+    layer.ple_embedding = SimpleNamespace(ngram_embedding=SimpleNamespace())
+
+    embeddings = torch.zeros((1, 2), dtype=torch.float32).to(torch.float8_e4m3fn)
+    with pytest.raises(RuntimeError, match="missing its global scale"):
+        layer._dequantize_embeddings(embeddings, torch.bfloat16)
