+# gfx1151 (Strix Halo, RDNA3.5) is a first-class ROCm device in this tree
+# (``platforms/rocm.py`` recognises it) but has no FP8 matrix unit, so
+# ``current_platform.supports_fp8()`` is False there and the block-FP8 MoE
+# oracle rejects every backend. The Triton fused MoE kernel can still serve the
+# scheme by upcasting the fp8 A/B tiles to bf16 immediately before ``tl.dot``,
+# which is what ``fp8_moe_gfx1151_dot_upcast()`` plumbs into the kernel.
+#
+# Latched once at import. ``FN_FP8_MOE=0`` disables the whole mechanism --
+# admission *and* upcast together -- restoring the stock loud refusal from
+# ``select_fp8_moe_backend``.
+FN_FP8_MOE = os.environ.get("FN_FP8_MOE", "1") != "0"
+
+
+def fp8_moe_gfx1151_admitted() -> bool:
+    """Whether gfx1151 is admitted into the block-FP8 fused MoE oracle."""
+    if not FN_FP8_MOE or not current_platform.is_rocm():
+        return False
+
+    from vllm.platforms.rocm import on_gfx1151
+
+    return on_gfx1151()
+
+
+@functools.cache
+def fp8_moe_gfx1151_dot_upcast() -> bool:
+    """Whether ``fused_moe_kernel`` must upcast fp8 tiles before ``tl.dot``.
+
+    Mirrors the linear-path gate added upstream in vllm-project/vllm#52970:
+    Triton >= 3.8.0 lowers an fp8 ``tl.dot`` on gfx1151 itself, older Triton
+    needs the tiles converted in-kernel.
+    """
+    return fp8_moe_gfx1151_admitted() and Version(triton.__version__) < Version("3.8.0")
+
