@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""gfx1151 block-FP8 fused-MoE admission gate.
+
+``TritonExperts._supports_quant_scheme`` is the single predicate that decides
+whether a 128x128 block-FP8 MoE dispatches at all on ROCm: ``supports_fp8()``
+is False on gfx1151 (Strix Halo has no FP8 matrix unit), so stock vLLM raises
+``NotImplementedError: No FP8 MoE backend supports the deployment
+configuration.`` from ``select_fp8_moe_backend()`` before a single expert
+weight byte is read.
+
+These tests pin the admission, its ``FN_FP8_MOE=0`` kill switch and the Triton
+version gate on the in-kernel bf16 upcast, all without a GPU.
+"""
+
+import inspect
+import sys
+import types
+
+import pytest
+
+from vllm.model_executor.layers.fused_moe import utils as moe_utils
+from vllm.model_executor.layers.fused_moe.experts.triton_moe import TritonExperts
+from vllm.model_executor.layers.fused_moe.fused_moe import fused_moe_kernel
+from vllm.model_executor.layers.quantization.utils.quant_utils import (
+    kFp8Dynamic128Sym,
+    kFp8Static128BlockSym,
+    kFp8StaticTensorSym,
+)
+from vllm.platforms import current_platform
+
+# The pair Fp8MoEMethod builds for a `weight_block_size: [128, 128]`
+# checkpoint (quantization/fp8.py:488-490).
+BLOCK_FP8_SCHEME = (kFp8Static128BlockSym, kFp8Dynamic128Sym)
+
+
+def _fake_gfx1151(monkeypatch: pytest.MonkeyPatch, *, on_gfx1151: bool) -> None:
+    """Present a ROCm device without native FP8, optionally gfx1151.
+
+    ``vllm.platforms.rocm`` cannot be imported on a CPU-only box -- its
+    module-level ``_GCN_ARCH`` probe falls back to ``torch.cuda`` -- so stub
+    the module instead of the arch string.
+    """
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: False)
+    monkeypatch.setattr(current_platform, "is_rocm", lambda: True)
+    monkeypatch.setattr(current_platform, "supports_fp8", lambda: False)
+
+    rocm_stub = types.ModuleType("vllm.platforms.rocm")
+    rocm_stub.on_gfx1151 = lambda: on_gfx1151
+    monkeypatch.setitem(sys.modules, "vllm.platforms.rocm", rocm_stub)
+
+
+def test_block_fp8_admitted_on_gfx1151(monkeypatch: pytest.MonkeyPatch) -> None:
+    _fake_gfx1151(monkeypatch, on_gfx1151=True)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", True)
+
+    assert TritonExperts._supports_quant_scheme(*BLOCK_FP8_SCHEME)
+
+
+def test_block_fp8_refused_when_kill_switch_set(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _fake_gfx1151(monkeypatch, on_gfx1151=True)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", False)
+
+    assert not TritonExperts._supports_quant_scheme(*BLOCK_FP8_SCHEME)
+
+
+def test_block_fp8_refused_on_other_rocm_devices(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # The admission is gfx1151-only: every other ROCm device whose
+    # supports_fp8() is False keeps the stock refusal.
+    _fake_gfx1151(monkeypatch, on_gfx1151=False)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", True)
+
+    assert not TritonExperts._supports_quant_scheme(*BLOCK_FP8_SCHEME)
+
+
+def test_per_tensor_fp8_not_admitted_on_gfx1151(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # Only the block scheme is admitted. The per-tensor schemes take the
+    # fp8_fast_accum `tl.dot(a, b, acc=accumulator)` path, which the upcast
+    # does not cover, so they must stay refused.
+    _fake_gfx1151(monkeypatch, on_gfx1151=True)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", True)
+
+    assert not TritonExperts._supports_quant_scheme(
+        kFp8StaticTensorSym, kFp8StaticTensorSym
+    )
+
+
+def test_unquantized_scheme_unaffected_by_kill_switch(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _fake_gfx1151(monkeypatch, on_gfx1151=True)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", False)
+
+    assert TritonExperts._supports_quant_scheme(None, None)
+
+
+@pytest.mark.parametrize(
+    "triton_version,expect_upcast",
+    [("3.4.0", True), ("3.7.1", True), ("3.8.0", False), ("3.9.0", False)],
+)
+def test_dot_upcast_follows_triton_version(
+    monkeypatch: pytest.MonkeyPatch, triton_version: str, expect_upcast: bool
+) -> None:
+    # Mirrors the linear-path gate of vllm-project/vllm#52970: Triton >= 3.8.0
+    # lowers an fp8 tl.dot on gfx1151 itself.
+    _fake_gfx1151(monkeypatch, on_gfx1151=True)
+    monkeypatch.setattr(moe_utils, "FN_FP8_MOE", True)
+    monkeypatch.setattr(moe_utils.triton, "__version__", triton_version)
+
+    moe_utils.fp8_moe_gfx1151_dot_upcast.cache_clear()
+    try:
+        assert moe_utils.fp8_moe_gfx1151_dot_upcast() is expect_upcast
+    finally:
+        moe_utils.fp8_moe_gfx1151_dot_upcast.cache_clear()
+
+
+def test_kernel_accepts_force_fp8_dot_upcast() -> None:
+    # invoke_fused_moe_triton_kernel() passes FORCE_FP8_DOT_UPCAST by keyword;
+    # keep the kernel signature and the launch site from drifting apart.
+    kernel_fn = getattr(fused_moe_kernel, "fn", fused_moe_kernel)
+    parameters = inspect.signature(kernel_fn).parameters
+
+    assert "FORCE_FP8_DOT_UPCAST" in parameters
+    assert parameters["FORCE_FP8_DOT_UPCAST"].default is False
