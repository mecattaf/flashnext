     SWAP_AB: tl.constexpr,
     # Tensor-descriptor path for the A gather and B load in the K-loop.
     USE_TD: tl.constexpr = False,
+    # Convert the loaded A/B tiles to bf16 before tl.dot. Needed on devices
+    # with no FP8 matrix unit (gfx1151); see fp8_moe_gfx1151_dot_upcast().
+    FORCE_FP8_DOT_UPCAST: tl.constexpr = False,
 ):
     """
     Implements the fused computation for a Mixture of Experts (MOE) using
@@ -535,6 +539,12 @@ def fused_moe_kernel(
                 other=0.0,
             )
             b = tl.load(b_ptrs, mask=offs_k[:, None] < K - k * BLOCK_SIZE_K, other=0.0)
+        if FORCE_FP8_DOT_UPCAST:
+            # No FP8 matrix unit on this device: convert the tiles so tl.dot
