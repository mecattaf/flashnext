 )
@@ -60,6 +62,8 @@ from vllm.platforms import current_platform
 from vllm.triton_utils import tl
 from vllm.utils.multi_stream_utils import maybe_execute_in_parallel
 
+logger = init_logger(__name__)
+
 
 class TritonExperts(LoRAExpertsMixin, mk.FusedMoEExpertsModular):
     """Triton-based fused MoE expert implementation."""
@@ -145,6 +149,7 @@ class TritonExperts(LoRAExpertsMixin, mk.FusedMoEExpertsModular):
                 # per-tensor weight + dynamic per-tensor activation
                 (kInt8StaticTensorSym, kInt8DynamicTensorSym),
             ]
+        gfx1151_upcast = False
         if current_platform.supports_fp8():
             supported += [
                 (kFp8Static128BlockSym, kFp8Dynamic128Sym),
@@ -153,7 +158,30 @@ class TritonExperts(LoRAExpertsMixin, mk.FusedMoEExpertsModular):
                 (kFp8StaticTensorSym, kFp8StaticTensorSym),
                 (kFp8StaticTensorSym, kFp8DynamicTensorSym),
             ]
-        return (weight_key, activation_key) in supported
+        elif fp8_moe_gfx1151_admitted():
+            # gfx1151 (Strix Halo, RDNA3.5) has no FP8 matrix unit, so
+            # supports_fp8() is False and the block-FP8 oracle would reject
+            # every backend. This kernel can still serve the block scheme:
+            # invoke_fused_moe_triton_kernel() upcasts the fp8 A/B tiles to
+            # bf16 before tl.dot, and the block scales are applied in fp32
+            # afterwards exactly as on a native device. Only the block scheme
+            # is admitted -- the per-tensor/per-channel schemes take the
+            # fp8_fast_accum tl.dot path, which has no upcast equivalent here.
+            supported += [
+                (kFp8Static128BlockSym, kFp8Dynamic128Sym),
+            ]
+            gfx1151_upcast = True
+
+        is_supported = (weight_key, activation_key) in supported
+        if gfx1151_upcast and is_supported and weight_key is not None:
+            logger.info_once(
+                "TritonExperts: admitting block-FP8 fused MoE (%sx%s) on "
+                "gfx1151 via in-kernel bf16 upcast; this device has no FP8 "
+                "matrix unit. Set FN_FP8_MOE=0 to restore the stock refusal.",
+                weight_key,
+                activation_key,
+            )
+        return is_supported
 
     @staticmethod
     def _supports_activation(activation: MoEActivation) -> bool:
