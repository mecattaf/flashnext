+            b = b.to(tl.bfloat16)
         # We accumulate along the K dimension.
         if use_int8_w8a16:
             accumulator = tl.dot(a, b.to(compute_type), acc=accumulator)
@@ -863,6 +873,17 @@ def invoke_fused_moe_triton_kernel(
     if A_scale is not None and A_scale.ndim == 0:
         A_scale = A_scale.reshape(1)
 
+    # gfx1151 has no FP8 matrix unit, so tl.dot cannot consume the fp8 tiles
+    # directly on an older Triton. Upcast them in-kernel instead (same
+    # mechanism as the linear path in vllm-project/vllm#52970).
+    force_fp8_dot_upcast = use_fp8_w8a8 and fp8_moe_gfx1151_dot_upcast()
+    if force_fp8_dot_upcast:
+        logger.info_once(
+            "fused_moe_kernel: upcasting FP8 tiles to bf16 before tl.dot on "
+            "gfx1151 (no FP8 matrix unit). Set FN_FP8_MOE=0 to disable the "
+            "gfx1151 FP8 MoE path entirely."
+        )
+
     fused_moe_kernel[grid](
         A,
         B,
@@ -906,6 +927,7 @@ def invoke_fused_moe_triton_kernel(
         BLOCK_SIZE_K=BLOCK_SIZE_K,
         SWAP_AB=SWAP_AB,
         USE_TD=use_td,
+        FORCE_FP8_DOT_UPCAST=force_fp8_dot_upcast,
         **config,
     )
 
